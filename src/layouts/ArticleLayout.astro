---
import BaseLayout from './BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Lesson from '../components/Lesson.astro';
import BookCard from '../components/BookCard.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AdUnit from '../components/AdUnit.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import VodBox from '../components/VodBox.astro';
import { CATEGORY_TO_ARC, ARC_INFO, NEXT_ARC, type CategoryName } from '../utils/arcMap';

interface AffiliateBook {
  title:  string;
  asin?:       string;
  rakutenUrl?: string;
  reason: string;
  image?: string;
}

interface RelatedArticle {
  title:       string;
  slug:        string;
  category:    string;
  date:        Date;
  readingTime: number;
  description: string;
}

interface TocHeading {
  depth: number;
  slug:  string;
  text:  string;
}

interface Props {
  title:            string;
  description:      string;
  date:             Date;
  updatedAt?:       Date;
  category:         CategoryName;
  tags:             string[];
  readingTime:      number;
  ogImage?:         string;
  lesson?:          string;
  youtubeId?:       string;
  vodService?:      "unext" | "hulu" | "netflix" | "disneyplus" | "amazon";
  vodUrl?:          string;
  affiliateBooks?:  AffiliateBook[];
  relatedArticles?: RelatedArticle[];
  tocHeadings?:     TocHeading[];
}
const { title, description, date, updatedAt, category, tags, readingTime, ogImage, lesson, youtubeId, vodService, vodUrl, affiliateBooks, relatedArticles, tocHeadings } = Astro.props;

const eyecatch = youtubeId ? null : ogImage;

// Arc info
const arcSlug = CATEGORY_TO_ARC[category];
const arc = arcSlug ? ARC_INFO[arcSlug] : null;
const nextArcSlug = arcSlug ? NEXT_ARC[arcSlug] : undefined;
const nextArc = nextArcSlug ? ARC_INFO[nextArcSlug] : null;

const catLabel: Record<string, string> = {
  battle: "合戦と戦略", leader: "武将の思想", strategy: "兵法・知恵", books: "書籍レビュー",
  movie: "映画の知恵", whatif: "歴史IF", anime: "アニメの知恵",
  business: "ビジネス戦略", sports: "スポーツ戦略",
};

const formattedDate = date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = date.toISOString();
const isoUpdated = updatedAt ? updatedAt.toISOString() : iso;
const formattedUpdated = updatedAt
  ? updatedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<BaseLayout
  title={`${title} | 決断の系譜`}
  description={description}
  ogImage={ogImage}
  type="article"
  publishedAt={iso}
>
  <!-- 章バナー -->
  {arc && (
    <div class="arc-banner" style={`background: ${arc.gradient}; border-bottom: 1px solid ${arc.color}30;`}>
      <div class="container arc-banner-inner">
        <a href={`/arc/${arc.slug}/`} class="arc-banner-link">
          <span class="arc-banner-chapter" style={`color: ${arc.color};`}>{arc.chapter}</span>
          <span class="arc-banner-title">「{arc.title}」</span>
          <span class="arc-banner-tagline">{arc.tagline}</span>
        </a>
        <div class="arc-banner-nav">
          {[1,2,3].map((n, i) => {
            const slugs = ["rekishi","gendai","monogatari"] as const;
            const s = slugs[i];
            const a = ARC_INFO[s];
            const isCurrent = s === arcSlug;
            return (
              <a href={`/arc/${s}/`} class:list={["arc-dot", { active: isCurrent }]} style={isCurrent ? `background:${arc.color}; border-color:${arc.color};` : ""} title={a.title}>
                {n}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  )}

  <article class="article-page" data-category={category}>
    <div class="container">

      <!-- パンくず -->
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="/">ホーム</a>
        <span aria-hidden="true">›</span>
        <a href="/blog/">記事一覧</a>
        <span aria-hidden="true">›</span>
        <a href={`/category/${category}/`}>{catLabel[category]}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{title}</span>
      </nav>

      <!-- 記事ヘッダー -->
      <header class="article-header">
        <div class="article-meta">
          <CategoryBadge category={category} />
          <time datetime={iso} class="meta-text">{formattedDate}</time>
          {formattedUpdated && (
            <time datetime={isoUpdated} class="meta-text meta-updated">更新: {formattedUpdated}</time>
          )}
          <span class="meta-text">📖 {readingTime} min read</span>
        </div>
        <h1 class="article-title">{title}</h1>
        <p class="article-lead">{description}</p>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label="タグ">
            {tags.map(tag => <li class="tag">#{tag}</li>)}
          </ul>
        )}
      </header>

      <!-- アイキャッチ画像（YouTubeサムネがある記事は非表示） -->
      {eyecatch && !youtubeId && (
        <div class="article-eyecatch">
          <img src={eyecatch} alt={title} class="article-eyecatch-img" loading="eager" />
        </div>
      )}

      <!-- 目次 -->
      {tocHeadings && tocHeadings.length >= 3 && (
        <nav class="toc" aria-label="目次">
          <p class="toc-title">目次</p>
          <ol class="toc-list">
            {tocHeadings.map((h, i) => (
              <li class="toc-item">
                <a href={`#${h.slug}`} class="toc-link">
                  <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- 本文 -->
      <div class="article-layout">
        <div class="prose article-body">
          <slot />
        </div>
      </div>

      <!-- 記事内広告（AdSenseスロットID設定後に有効化） -->
      {/* <AdUnit slot="XXXXXXXXXX" /> */}

      <!-- 予告編 -->
      {youtubeId && (
        <YouTubeEmbed id={youtubeId} title={`${title} — 公式予告編`} />
      )}

      <!-- VOD視聴リンク -->
      {vodUrl && vodService && (
        <VodBox title={title} url={vodUrl} service={vodService} />
      )}

      <!-- 書籍アフィリエイト -->
      {affiliateBooks && affiliateBooks.length > 0 && (
        <section class="affiliate-zone" aria-label="関連書籍">
          <div class="affiliate-header">
            <h2 class="affiliate-heading">この戦略を深く学ぶ、一冊。</h2>
            <AffiliateDisclosure />
          </div>
          <div class="book-grid-article">
            {affiliateBooks.slice(0, 3).map(book => (
              <BookCard
                title={book.title}
                asin={book.asin}
                rakutenUrl={book.rakutenUrl}
                reason={book.reason}
                image={book.image}
              />
            ))}
          </div>
        </section>
      )}

      <!-- メール登録 -->
      <NewsletterForm />

      <!-- 関連記事 -->
      {relatedArticles && relatedArticles.length > 0 && (
        <section class="related-section" aria-label="関連記事">
          <h2 class="related-heading">関連記事</h2>
          <ul class="related-grid" role="list">
            {relatedArticles.map(r => (
              <li>
                <a href={`/blog/${r.slug}/`} class="related-card">
                  <span class="related-cat">{catLabel[r.category] ?? r.category}</span>
                  <p class="related-title">{r.title}</p>
                  <p class="related-desc">{r.description}</p>
                  <span class="related-meta">{r.readingTime} min read</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- 章ナビゲーション -->
      {arc && (
        <section class="arc-nav-section">
          <p class="arc-nav-label">この記事は<strong style={`color:${arc.color}`}>{arc.chapter}「{arc.title}」</strong>の一部です</p>
          <div class="arc-nav-actions">
            <a href={`/arc/${arc.slug}/`} class="arc-nav-btn arc-nav-btn--primary" style={`border-color:${arc.color}; color:${arc.color};`}>
              {arc.chapter}の記事をすべて読む →
            </a>
            {nextArc && (
              <a href={`/arc/${nextArc.slug}/`} class="arc-nav-btn">
                {nextArc.chapter}「{nextArc.title}」へ →
              </a>
            )}
          </div>
        </section>
      )}

      <!-- 戻るリンク -->
      <nav class="article-nav">
        <a href="/blog/" class="back-link">← 記事一覧に戻る</a>
      </nav>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "datePublished": iso,
    "dateModified": isoUpdated,
    "author": { "@type": "Person", "name": "決断の系譜" },
    "publisher": {
      "@type": "Organization",
      "name": "決断の系譜",
      "logo": { "@type": "ImageObject", "url": "https://sengoku-blog.vercel.app/favicon.svg" }
    },
    "description": description,
    "image": ogImage ? `https://sengoku-blog.vercel.app${ogImage}` : "https://sengoku-blog.vercel.app/images/default-ogp.svg"
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "ホーム",     "item": "https://sengoku-blog.vercel.app/" },
      { "@type": "ListItem", "position": 2, "name": "記事一覧",   "item": "https://sengoku-blog.vercel.app/blog/" },
      { "@type": "ListItem", "position": 3, "name": catLabel[category], "item": `https://sengoku-blog.vercel.app/category/${category}/` },
      { "@type": "ListItem", "position": 4, "name": title,        "item": pageUrl },
    ]
  })} />
</BaseLayout>

<style>
  /* Arc banner */
  .arc-banner {
    padding: 0.6rem 0;
  }
  .arc-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .arc-banner-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-wrap: wrap;
  }
  .arc-banner-chapter {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .arc-banner-title {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    font-weight: 700;
    color: rgba(255,255,255,0.85);
    flex-shrink: 0;
  }
  .arc-banner-tagline {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: rgba(255,255,255,0.4);
  }
  .arc-banner-nav {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .arc-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    background: transparent;
    color: rgba(255,255,255,0.4);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s;
  }
  .arc-dot.active { color: #fff; }
  .arc-dot:not(.active):hover { border-color: rgba(255,255,255,0.5); color: rgba(255,255,255,0.7); }
  @media (max-width: 640px) {
    .arc-banner-tagline { display: none; }
  }

  /* Arc nav section */
  .arc-nav-section {
    padding: 1.6rem;
    background: var(--bg-navy, #13161d);
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.07);
    margin: var(--sp-lg) 0 var(--sp-md);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .arc-nav-label {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    margin: 0;
  }
  .arc-nav-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .arc-nav-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.5rem 1.2rem;
    border-radius: 3px;
    border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.55);
    transition: all 0.2s;
  }
  .arc-nav-btn:hover { border-color: rgba(255,255,255,0.4); color: #fff; }
  .arc-nav-btn--primary {
    font-weight: 700;
  }
  .arc-nav-btn--primary:hover {
    color: #fff;
  }

  .article-page {
    padding: var(--sp-lg) 0 var(--sp-xl);
  }

  /* 映画記事：シネマゴールドに上書き */
  .article-page[data-category="movie"] {
    --orange:      #e8b84b;
    --orange-dark: #c99a30;
    --amber:       #e8b84b;
    --gold:        #e8b84b;
    --gold-light:  rgba(232, 184, 75, 0.15);
    --gold-dark:   #c99a30;
    --bg-navy:     #13161d;
    --bg-navy-mid: #1a1e28;
  }

  .article-header {
    padding: var(--sp-md) 0 var(--sp-md);
    border-bottom: 2px solid var(--orange);
    margin-bottom: var(--sp-lg);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1.35;
    color: var(--text);
    margin-bottom: 1.2rem;
  }

  .article-lead {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 400;
    line-height: 2;
    color: var(--text-mid);
    border-left: 3px solid var(--amber);
    padding-left: 1.2rem;
    max-width: 680px;
    margin-bottom: 1rem;
    background: rgba(212, 160, 23, 0.05);
    padding: 0.8rem 1.2rem;
  }

  /* アイキャッチ画像 */
  .article-eyecatch {
    margin-bottom: var(--sp-lg);
    border-radius: 6px;
    overflow: hidden;
    max-width: 740px;
  }
  .article-eyecatch-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 640px) {
    .article-eyecatch-img { height: 220px; }
  }

  /* 本文中の画像 */
  .article-body :global(img) {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 6px;
    display: block;
    margin: var(--sp-md) 0;
  }
  @media (max-width: 640px) {
    .article-body :global(img) { height: 200px; }
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
  }

  .article-body {
    max-width: 740px;
    margin-bottom: var(--sp-lg);
  }

  /* 目次 */
  .toc {
    background: var(--bg-navy);
    border-radius: 6px;
    padding: 1.6rem 1.8rem;
    margin-bottom: var(--sp-lg);
    max-width: 640px;
  }
  .toc-title {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--amber);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    line-height: 1.5;
    transition: color 0.2s;
  }
  .toc-link:hover { color: #fff; }
  .toc-num {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--orange);
    flex-shrink: 0;
    letter-spacing: 0.05em;
  }

  /* 書籍アフィリエイトゾーン */
  .affiliate-zone {
    background: var(--bg-navy);
    border-radius: 6px;
    padding: var(--sp-lg);
    margin: var(--sp-lg) 0;
    position: relative;
    overflow: hidden;
  }
  .affiliate-zone::after {
    content: "読";
    font-family: var(--font-serif);
    font-size: 20rem;
    font-weight: 800;
    color: rgba(185, 28, 28, 0.05);
    position: absolute;
    right: -2rem;
    bottom: -2rem;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .affiliate-header {
    margin-bottom: 1.8rem;
    position: relative;
    z-index: 1;
  }

  .affiliate-heading {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.03em;
    margin-bottom: 0.5rem;
  }

  .affiliate-zone :global(.affiliate-disclosure) {
    color: rgba(255, 255, 255, 0.38);
  }

  .book-grid-article {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  /* 関連記事 */
  .related-section {
    margin: var(--sp-lg) 0 var(--sp-md);
    padding-top: var(--sp-lg);
    border-top: 1px solid var(--border);
  }
  .related-heading {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-mid);
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }
  .related-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem;
    background: var(--bg-navy);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
    height: 100%;
  }
  .related-card:hover {
    border-color: var(--orange);
    transform: translateY(-2px);
  }
  .related-cat {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--amber);
    text-transform: uppercase;
  }
  .related-title {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.55;
    color: #fff;
    flex: 1;
  }
  .related-desc {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.45);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-meta {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: rgba(255,255,255,0.3);
    margin-top: auto;
  }
  @media (max-width: 640px) {
    .related-grid { grid-template-columns: 1fr; }
  }

  .article-nav {
    padding-top: var(--sp-md);
    border-top: 1px solid var(--border);
    margin-top: var(--sp-lg);
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-mid);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--orange); }
</style>
