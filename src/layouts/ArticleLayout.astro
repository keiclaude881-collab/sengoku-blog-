---
import BaseLayout from './BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Lesson from '../components/Lesson.astro';
import BookCard from '../components/BookCard.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AdUnit from '../components/AdUnit.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';

interface AffiliateBook {
  title:  string;
  asin:   string;
  reason: string;
  image?: string;
}

interface RelatedArticle {
  title:       string;
  slug:        string;
  category:    string;
  date:        Date;
  readingTime: number;
  description: string;
}

interface TocHeading {
  depth: number;
  slug:  string;
  text:  string;
}

interface Props {
  title:            string;
  description:      string;
  date:             Date;
  updatedAt?:       Date;
  category:         "battle" | "leader" | "strategy" | "books" | "movie" | "whatif";
  tags:             string[];
  readingTime:      number;
  ogImage?:         string;
  lesson?:          string;
  youtubeId?:       string;
  affiliateBooks?:  AffiliateBook[];
  relatedArticles?: RelatedArticle[];
  tocHeadings?:     TocHeading[];
}
const { title, description, date, updatedAt, category, tags, readingTime, ogImage, lesson, youtubeId, affiliateBooks, relatedArticles, tocHeadings } = Astro.props;

const eyecatch = youtubeId
  ? `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`
  : ogImage;

const catLabel: Record<string, string> = {
  battle: "合戦分析", leader: "武将の思想", strategy: "兵法・現代応用", books: "書籍レビュー",
  movie: "映画・SF", whatif: "歴史のIF",
};

const formattedDate = date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = date.toISOString();
const isoUpdated = updatedAt ? updatedAt.toISOString() : iso;
const formattedUpdated = updatedAt
  ? updatedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(pageUrl)}`;
const hatenaBsUrl = `https://b.hatena.ne.jp/add?mode=confirm&url=${encodeURIComponent(pageUrl)}`;
---

<BaseLayout
  title={`${title} | 決断の系譜`}
  description={description}
  ogImage={ogImage}
  type="article"
  publishedAt={iso}
>
  <article class="article-page">
    <div class="container">

      <!-- パンくず -->
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="/">ホーム</a>
        <span aria-hidden="true">›</span>
        <a href="/blog/">記事一覧</a>
        <span aria-hidden="true">›</span>
        <a href={`/category/${category}/`}>{catLabel[category]}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{title}</span>
      </nav>

      <!-- 記事ヘッダー -->
      <header class="article-header">
        <div class="article-meta">
          <CategoryBadge category={category} />
          <time datetime={iso} class="meta-text">{formattedDate}</time>
          {formattedUpdated && (
            <time datetime={isoUpdated} class="meta-text meta-updated">更新: {formattedUpdated}</time>
          )}
          <span class="meta-text">📖 {readingTime} min read</span>
        </div>
        <h1 class="article-title">{title}</h1>
        <p class="article-lead">{description}</p>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label="タグ">
            {tags.map(tag => <li class="tag">#{tag}</li>)}
          </ul>
        )}
      </header>

      <!-- アイキャッチ画像 -->
      {eyecatch && (
        <div class="article-eyecatch">
          <img src={eyecatch} alt={title} class="article-eyecatch-img" loading="eager" />
        </div>
      )}

      <!-- 予告編（映画記事のみ） -->
      {youtubeId && (
        <YouTubeEmbed id={youtubeId} title={`${title} — 公式予告編`} />
      )}

      <!-- 目次 -->
      {tocHeadings && tocHeadings.length >= 3 && (
        <nav class="toc" aria-label="目次">
          <p class="toc-title">目次</p>
          <ol class="toc-list">
            {tocHeadings.map((h, i) => (
              <li class="toc-item">
                <a href={`#${h.slug}`} class="toc-link">
                  <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- 本文 -->
      <div class="article-layout">
        <div class="prose article-body">
          <slot />
        </div>
      </div>

      <!-- 記事内広告 -->
      <AdUnit slot="XXXXXXXXXX" />

      <!-- SNSシェア -->
      <div class="share-buttons">
        <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn">
          𝕏 シェア
        </a>
        <a href={hatenaBsUrl} target="_blank" rel="noopener noreferrer" class="share-btn">
          B! はてブ
        </a>
      </div>

      <!-- 書籍アフィリエイト -->
      {affiliateBooks && affiliateBooks.length > 0 && (
        <section class="affiliate-zone" aria-label="関連書籍">
          <div class="affiliate-header">
            <h2 class="affiliate-heading">この戦略を深く学ぶ、一冊。</h2>
            <AffiliateDisclosure />
          </div>
          <div class="book-grid-article">
            {affiliateBooks.slice(0, 3).map(book => (
              <BookCard
                title={book.title}
                asin={book.asin}
                reason={book.reason}
                image={book.image}
              />
            ))}
          </div>
        </section>
      )}

      <!-- メール登録 -->
      <NewsletterForm />

      <!-- 関連記事 -->
      {relatedArticles && relatedArticles.length > 0 && (
        <section class="related-section" aria-label="関連記事">
          <h2 class="related-heading">関連記事</h2>
          <ul class="related-grid" role="list">
            {relatedArticles.map(r => (
              <li>
                <a href={`/blog/${r.slug}/`} class="related-card">
                  <span class="related-cat">{catLabel[r.category] ?? r.category}</span>
                  <p class="related-title">{r.title}</p>
                  <p class="related-desc">{r.description}</p>
                  <span class="related-meta">{r.readingTime} min read</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- 戻るリンク -->
      <nav class="article-nav">
        <a href="/blog/" class="back-link">← 記事一覧に戻る</a>
      </nav>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "datePublished": iso,
    "dateModified": isoUpdated,
    "author": { "@type": "Person", "name": "決断の系譜" },
    "publisher": {
      "@type": "Organization",
      "name": "決断の系譜",
      "logo": { "@type": "ImageObject", "url": "https://sengoku-blog.vercel.app/favicon.svg" }
    },
    "description": description,
    "image": ogImage ? `https://sengoku-blog.vercel.app${ogImage}` : "https://sengoku-blog.vercel.app/images/default-ogp.svg"
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "ホーム",     "item": "https://sengoku-blog.vercel.app/" },
      { "@type": "ListItem", "position": 2, "name": "記事一覧",   "item": "https://sengoku-blog.vercel.app/blog/" },
      { "@type": "ListItem", "position": 3, "name": catLabel[category], "item": `https://sengoku-blog.vercel.app/category/${category}/` },
      { "@type": "ListItem", "position": 4, "name": title,        "item": pageUrl },
    ]
  })} />
</BaseLayout>

<style>
  .article-page {
    padding: var(--sp-lg) 0 var(--sp-xl);
  }

  .article-header {
    padding: var(--sp-md) 0 var(--sp-md);
    border-bottom: 2px solid var(--orange);
    margin-bottom: var(--sp-lg);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1.35;
    color: var(--text);
    margin-bottom: 1.2rem;
  }

  .article-lead {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 400;
    line-height: 2;
    color: var(--text-mid);
    border-left: 3px solid var(--amber);
    padding-left: 1.2rem;
    max-width: 680px;
    margin-bottom: 1rem;
    background: rgba(212, 160, 23, 0.05);
    padding: 0.8rem 1.2rem;
  }

  /* アイキャッチ画像 */
  .article-eyecatch {
    margin-bottom: var(--sp-lg);
    border-radius: 6px;
    overflow: hidden;
    max-width: 740px;
  }
  .article-eyecatch-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 640px) {
    .article-eyecatch-img { height: 220px; }
  }

  /* 本文中の画像 */
  .article-body :global(img) {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 6px;
    display: block;
    margin: var(--sp-md) 0;
  }
  @media (max-width: 640px) {
    .article-body :global(img) { height: 200px; }
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
  }

  .article-body {
    max-width: 740px;
    margin-bottom: var(--sp-lg);
  }

  /* 目次 */
  .toc {
    background: var(--bg-navy);
    border-radius: 6px;
    padding: 1.6rem 1.8rem;
    margin-bottom: var(--sp-lg);
    max-width: 640px;
  }
  .toc-title {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--amber);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    line-height: 1.5;
    transition: color 0.2s;
  }
  .toc-link:hover { color: #fff; }
  .toc-num {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--orange);
    flex-shrink: 0;
    letter-spacing: 0.05em;
  }

  /* 書籍アフィリエイトゾーン */
  .affiliate-zone {
    background: var(--bg-navy);
    border-radius: 6px;
    padding: var(--sp-lg);
    margin: var(--sp-lg) 0;
    position: relative;
    overflow: hidden;
  }
  .affiliate-zone::after {
    content: "読";
    font-family: var(--font-serif);
    font-size: 20rem;
    font-weight: 800;
    color: rgba(185, 28, 28, 0.05);
    position: absolute;
    right: -2rem;
    bottom: -2rem;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .affiliate-header {
    margin-bottom: 1.8rem;
    position: relative;
    z-index: 1;
  }

  .affiliate-heading {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.03em;
    margin-bottom: 0.5rem;
  }

  .affiliate-zone :global(.affiliate-disclosure) {
    color: rgba(255, 255, 255, 0.38);
  }

  .book-grid-article {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  /* 関連記事 */
  .related-section {
    margin: var(--sp-lg) 0 var(--sp-md);
    padding-top: var(--sp-lg);
    border-top: 1px solid var(--border);
  }
  .related-heading {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-mid);
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }
  .related-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem;
    background: var(--bg-navy);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
    height: 100%;
  }
  .related-card:hover {
    border-color: var(--orange);
    transform: translateY(-2px);
  }
  .related-cat {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--amber);
    text-transform: uppercase;
  }
  .related-title {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.55;
    color: #fff;
    flex: 1;
  }
  .related-desc {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.45);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-meta {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: rgba(255,255,255,0.3);
    margin-top: auto;
  }
  @media (max-width: 640px) {
    .related-grid { grid-template-columns: 1fr; }
  }

  .article-nav {
    padding-top: var(--sp-md);
    border-top: 1px solid var(--border);
    margin-top: var(--sp-lg);
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-mid);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--orange); }
</style>
