---
import BaseLayout from './BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Lesson from '../components/Lesson.astro';
import BookCard from '../components/BookCard.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AdUnit from '../components/AdUnit.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import VodBox from '../components/VodBox.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_TO_ARC, ARC_INFO, NEXT_ARC, type CategoryName } from '../utils/arcMap';

interface AffiliateBook {
  title:  string;
  asin?:       string;
  rakutenUrl?: string;
  reason: string;
  image?: string;
}

interface RelatedArticle {
  title:       string;
  slug:        string;
  category:    string;
  date:        Date;
  readingTime: number;
  description: string;
}

interface TocHeading {
  depth: number;
  slug:  string;
  text:  string;
}

interface Props {
  title:            string;
  description:      string;
  date:             Date;
  updatedAt?:       Date;
  category:         CategoryName;
  tags:             string[];
  readingTime:      number;
  ogImage?:         string;
  lesson?:          string;
  youtubeId?:       string;
  vodService?:      "unext" | "hulu" | "netflix" | "disneyplus" | "amazon";
  vodUrl?:          string;
  affiliateBooks?:  AffiliateBook[];
  relatedArticles?: RelatedArticle[];
  tocHeadings?:     TocHeading[];
}
const { title, description, date, updatedAt, category, tags, readingTime, ogImage, lesson, youtubeId, vodService, vodUrl, affiliateBooks, relatedArticles, tocHeadings } = Astro.props;

const eyecatch = youtubeId ? null : ogImage;

// Arc info
const arcSlug = CATEGORY_TO_ARC[category];
const arc = arcSlug ? ARC_INFO[arcSlug] : null;
const nextArcSlug = arcSlug ? NEXT_ARC[arcSlug] : undefined;
const nextArc = nextArcSlug ? ARC_INFO[nextArcSlug] : null;

const catLabel: Record<string, string> = {
  decide:   "決断できない時",
  lead:     "チームがうまくいかない時",
  recover:  "逆境・失敗した時",
  strategy: "戦略・方向性に迷った時",
  change:   "自分を変えたい時",
  philosophy: "哲学の知恵",
};

const formattedDate = date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = date.toISOString();
const isoUpdated = updatedAt ? updatedAt.toISOString() : iso;
const formattedUpdated = updatedAt
  ? updatedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://sengoku-blog.vercel.app";

// あわせて読みたい: 同カテゴリからランダム3本（自身を除く）
const _allCollections = ["whatif", "philosophy"] as const;
const _allPosts = (await Promise.all(_allCollections.map(c => getCollection(c).catch(() => [])))).flat();
const _currentPath = Astro.url.pathname.replace(/\/$/, '');
const _sameCat = _allPosts.filter(p => {
  const pPath = `/blog/${p.collection}/${p.id.replace(/\.mdx?$/, '')}`;
  return (p.data as any).category === category && pPath !== _currentPath;
});
// Fisher-Yates shuffle (build-time, deterministic per build)
const _shuffled = [..._sameCat];
for (let i = _shuffled.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [_shuffled[i], _shuffled[j]] = [_shuffled[j], _shuffled[i]];
}
const awaseteYomitai = _shuffled.slice(0, 3).map(p => ({
  title: (p.data as any).title as string,
  url:   `/blog/${p.collection}/${p.id.replace(/\.mdx?$/, '')}/`,
}));
---

<BaseLayout
  title={`${title} | 偉人ラボ`}
  description={description}
  ogImage={ogImage}
  type="article"
  publishedAt={iso}
>
  <!-- 読書進捗バー -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <!-- 章バナー -->
  {arc && (
    <div class="arc-banner" style={`background: ${arc.gradient}; border-bottom: 1px solid ${arc.color}30;`}>
      <div class="container arc-banner-inner">
        <a href={`/arc/${arc.slug}/`} class="arc-banner-link">
          <span class="arc-banner-chapter" style={`color: ${arc.color};`}>{arc.chapter}</span>
          <span class="arc-banner-title">「{arc.title}」</span>
          <span class="arc-banner-tagline">{arc.tagline}</span>
        </a>
        <div class="arc-banner-nav">
          {[1,2,3].map((n, i) => {
            const slugs = ["rekishi","senryaku","monogatari"] as const;
            const s = slugs[i];
            const a = ARC_INFO[s];
            const isCurrent = s === arcSlug;
            return (
              <a href={`/arc/${s}/`} class:list={["arc-dot", { active: isCurrent }]} style={isCurrent ? `background:${arc.color}; border-color:${arc.color};` : ""} title={a.title}>
                {n}
              </a>
            );
          })}
        </div>
      </div>
    </div>
  )}

  <article class="article-page" data-category={category}>
    <div class="container">

      <!-- パンくず -->
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="/">ホーム</a>
        <span aria-hidden="true">›</span>
        <a href="/blog/">記事一覧</a>
        <span aria-hidden="true">›</span>
        <a href={`/category/${category}/`}>{catLabel[category]}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{title}</span>
      </nav>

      <!-- 記事ヘッダー -->
      <header class="article-header">
        <p class="article-lab-label">◉ IJIN LAB — RESEARCH NOTE</p>
        <div class="article-meta">
          <CategoryBadge category={category} />
          <time datetime={iso} class="meta-text">{formattedDate}</time>
          {formattedUpdated && (
            <time datetime={isoUpdated} class="meta-text meta-updated">更新: {formattedUpdated}</time>
          )}
          <span class="meta-text">📖 {readingTime} min read</span>
        </div>
        <h1 class="article-title">{title}</h1>
        <p class="article-lead">{description}</p>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label="タグ">
            {tags.map(tag => <li class="tag">#{tag}</li>)}
          </ul>
        )}
      </header>

      <!-- アイキャッチ画像（YouTubeサムネがある記事は非表示） -->
      {eyecatch && !youtubeId && (
        <div class="article-eyecatch">
          <img src={eyecatch} alt={title} class="article-eyecatch-img" loading="eager" />
        </div>
      )}

      <!-- 目次 -->
      {tocHeadings && tocHeadings.length >= 3 && (
        <nav class="toc" aria-label="目次">
          <p class="toc-title">目次</p>
          <ol class="toc-list">
            {tocHeadings.map((h, i) => (
              <li class="toc-item">
                <a href={`#${h.slug}`} class="toc-link">
                  <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- 本文 + サイドバー -->
      <div class="article-layout">
        <div class="prose article-body">
          <slot />
        </div>

        <!-- サイドバー（PC only） -->
        <aside class="article-sidebar">
          <!-- Audible固定バナー -->
          <div class="sidebar-audible">
            <p class="sidebar-audible-icon">📚</p>
            <p class="sidebar-audible-catch">通勤中に孫子を聴く</p>
            <p class="sidebar-audible-body">戦略書を聴く30分が、明日の判断を変える。</p>
            <a
              href="https://www.amazon.co.jp/b/ref=adbl_JP_as_0068?ie=UTF8&node=7471076051&tag=sengokublog20-22"
              target="_blank"
              rel="noopener noreferrer"
              class="sidebar-audible-btn"
            >→ 30日間無料で試す</a>
          </div>

          <!-- 人気記事 -->
          <div class="sidebar-popular">
            <h3 class="sidebar-heading">人気記事</h3>
            <ul class="sidebar-popular-list">
              <li>
                <a href="/blog/whatif/shingen-longlife-if/" class="sidebar-popular-link">
                  <span class="sidebar-popular-cat">歴史IF</span>
                  <span class="sidebar-popular-title">もし武田信玄が長生きしていたら</span>
                </a>
              </li>
              <li>
                <a href="/blog/strategy/retreat-strategy/" class="sidebar-popular-link">
                  <span class="sidebar-popular-cat">戦略</span>
                  <span class="sidebar-popular-title">撤退を決断できるか</span>
                </a>
              </li>
              <li>
                <a href="/blog/leader/yamamoto-isoroku/" class="sidebar-popular-link">
                  <span class="sidebar-popular-cat">武将の思想</span>
                  <span class="sidebar-popular-title">やってみせなければ人は動かない</span>
                </a>
              </li>
            </ul>
          </div>
        </aside>
      </div>

      <!-- あわせて読みたい -->
      {awaseteYomitai.length > 0 && (
        <section class="awasete-section" aria-label="あわせて読みたい">
          <hr class="awasete-hr" />
          <h2 class="awasete-heading">あわせて読みたい</h2>
          <ul class="awasete-list">
            {awaseteYomitai.map(a => (
              <li class="awasete-item">
                <a href={a.url} class="awasete-link">{a.title}</a>
              </li>
            ))}
          </ul>
          <hr class="awasete-hr" />
        </section>
      )}

      <!-- 記事内広告（AdSenseスロットID設定後に有効化） -->
      {/* <AdUnit slot="XXXXXXXXXX" /> */}

      <!-- 予告編 -->
      {youtubeId && (
        <YouTubeEmbed id={youtubeId} title={`${title} — 公式予告編`} />
      )}

      <!-- VOD視聴リンク -->
      {vodUrl && vodService && (
        <VodBox title={title} url={vodUrl} service={vodService} />
      )}

      <!-- 書籍アフィリエイト -->
      {affiliateBooks && affiliateBooks.length > 0 && (
        <section class="affiliate-zone" aria-label="関連書籍">
          <div class="affiliate-header">
            <h2 class="affiliate-heading">この戦略を深く学ぶ、一冊。</h2>
            <AffiliateDisclosure />
          </div>
          <div class="book-grid-article">
            {affiliateBooks.slice(0, 3).map(book => (
              <BookCard
                title={book.title}
                asin={book.asin}
                rakutenUrl={book.rakutenUrl}
                reason={book.reason}
                image={book.image}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Kindle Unlimited バナー -->
      <div class="kindle-banner">
        <div class="kindle-banner-inner">
          <span class="kindle-icon">📖</span>
          <div class="kindle-text">
            <p class="kindle-catch">この記事で紹介した本、読み放題で読める</p>
            <p class="kindle-body">Kindle Unlimited なら歴史・戦略書が月額980円で読み放題。30日間無料で試せます。</p>
          </div>
          <a
            href="https://af.moshimo.com/af/c/click?a_id=5427522&p_id=170&pc_id=185&pl_id=4062&url=https%3A%2F%2Fwww.amazon.co.jp%2Fkindle-dbs%2Fhz%2Fsignup"
            target="_blank"
            rel="nofollow sponsored noopener"
            class="kindle-btn"
          >30日間無料で試す →</a>
        </div>
      </div>

      <!-- メール登録 -->
      <NewsletterForm />

      <!-- 関連記事 -->
      {relatedArticles && relatedArticles.length > 0 && (
        <section class="related-section" aria-label="関連記事">
          <h2 class="related-heading">関連記事</h2>
          <ul class="related-grid" role="list">
            {relatedArticles.map(r => (
              <li>
                <a href={`/blog/${r.slug}/`} class="related-card">
                  <span class="related-cat">{catLabel[r.category] ?? r.category}</span>
                  <p class="related-title">{r.title}</p>
                  <p class="related-desc">{r.description}</p>
                  <span class="related-meta">{r.readingTime} min read</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}


      <!-- 戻るリンク -->
      <nav class="article-nav">
        <a href="/blog/" class="back-link">← 記事一覧に戻る</a>
      </nav>
    </div>
  </article>

  <!-- フローティング戻るボタン -->
  <button id="float-back" class="float-back" aria-label="前のページに戻る" title="前のページに戻る">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>

  <script>
    // 読書進捗バー
    const progress = document.getElementById('reading-progress') as HTMLElement | null;
    if (progress) {
      const article = document.querySelector('.article-body') as HTMLElement | null;
      window.addEventListener('scroll', () => {
        if (!article) return;
        const rect = article.getBoundingClientRect();
        const total = article.offsetHeight - window.innerHeight;
        const scrolled = Math.max(0, -rect.top);
        const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
        progress.style.width = `${pct}%`;
      }, { passive: true });
    }
  </script>

  <script>
    const btn = document.getElementById('float-back') as HTMLButtonElement;
    window.addEventListener('scroll', () => {
      btn.classList.toggle('visible', window.scrollY > 300);
    }, { passive: true });
    btn.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/blog/';
      }
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
    "headline": title,
    "datePublished": iso,
    "dateModified": isoUpdated,
    "author": {
      "@type": "Person",
      "name": "偉人ラボ",
      "url": siteOrigin
    },
    "publisher": {
      "@type": "Organization",
      "name": "偉人ラボ",
      "logo": { "@type": "ImageObject", "url": `${siteOrigin}/favicon.svg` }
    },
    "description": description,
    "image": ogImage ? ogImage : `${siteOrigin}/images/default-ogp.svg`,
    "keywords": tags.join(", "),
    "articleSection": catLabel[category] ?? category,
    "wordCount": readingTime * 600,
    "url": pageUrl
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "ホーム",     "item": `${siteOrigin}/` },
      { "@type": "ListItem", "position": 2, "name": "記事一覧",   "item": `${siteOrigin}/blog/` },
      { "@type": "ListItem", "position": 3, "name": catLabel[category], "item": `${siteOrigin}/category/${category}/` },
      { "@type": "ListItem", "position": 4, "name": title,        "item": pageUrl },
    ]
  })} />
</BaseLayout>

<style>
  /* 読書進捗バー */
  .reading-progress {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    height: 2px;
    width: 0%;
    background: var(--gold);
    z-index: 150;
    transition: width 0.1s linear;
  }

  /* Arc banner */
  .arc-banner {
    padding: 0.6rem 0;
  }
  .arc-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .arc-banner-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-wrap: wrap;
  }
  .arc-banner-chapter {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .arc-banner-title {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    font-weight: 700;
    color: rgba(255,255,255,0.85);
    flex-shrink: 0;
  }
  .arc-banner-tagline {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: rgba(255,255,255,0.4);
  }
  .arc-banner-nav {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .arc-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    background: transparent;
    color: rgba(255,255,255,0.4);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s;
  }
  .arc-dot.active { color: #fff; }
  .arc-dot:not(.active):hover { border-color: rgba(255,255,255,0.5); color: rgba(255,255,255,0.7); }
  @media (max-width: 640px) {
    .arc-banner-tagline { display: none; }
  }

  /* Arc nav section */
  .arc-nav-section {
    padding: 1.6rem;
    background: #111827;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.07);
    margin: var(--sp-lg) 0 var(--sp-md);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .arc-nav-label {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    margin: 0;
  }
  .arc-nav-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .arc-nav-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.5rem 1.2rem;
    border-radius: 3px;
    border: 1px solid rgba(255,255,255,0.35);
    color: rgba(255,255,255,0.8);
    transition: all 0.2s;
  }
  .arc-nav-btn:hover { border-color: rgba(255,255,255,0.7); color: #fff; }
  .arc-nav-btn--primary {
    font-weight: 700;
    color: #fff;
  }
  .arc-nav-btn--primary:hover {
    opacity: 0.85;
    color: #fff;
  }

  .article-page {
    padding: var(--sp-lg) 0 var(--sp-xl);
  }

  .article-header {
    padding: var(--sp-md) 0 var(--sp-md);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--sp-lg);
  }
  .article-lab-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: var(--amber);
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1.35;
    color: var(--text);
    margin-bottom: 1.2rem;
  }

  .article-lead {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 400;
    line-height: 2;
    color: var(--text-mid);
    border-left: 3px solid var(--amber);
    padding-left: 1.2rem;
    max-width: 680px;
    margin-bottom: 1rem;
    background: rgba(212, 160, 23, 0.05);
    padding: 0.8rem 1.2rem;
  }

  /* アイキャッチ画像 */
  .article-eyecatch {
    margin-bottom: var(--sp-lg);
    border-radius: 6px;
    overflow: hidden;
    max-width: 740px;
  }
  .article-eyecatch-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 640px) {
    .article-eyecatch-img { height: 220px; }
  }

  /* 本文中の画像 */
  .article-body :global(img) {
    max-width: 360px;
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    display: block;
    margin: var(--sp-md) auto;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 2.5rem;
    align-items: start;
  }

  .article-body {
    min-width: 0;
    margin-bottom: var(--sp-lg);
  }

  /* サイドバー */
  .article-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-audible {
    background: var(--accent, #1E4A35);
    border: 1px solid var(--gold);
    border-radius: 6px;
    padding: 1.4rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .sidebar-audible-icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  .sidebar-audible-catch {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
  }
  .sidebar-audible-body {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
  }
  .sidebar-audible-btn {
    display: inline-block;
    margin-top: 0.4rem;
    padding: 0.55rem 0.8rem;
    background: var(--gold);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 3px;
    text-align: center;
    transition: background 0.2s;
  }
  .sidebar-audible-btn:hover { background: var(--gold-dark, #2A6B50); }

  .sidebar-popular {
    background: var(--bg-navy, #111827);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 6px;
    padding: 1.2rem;
  }
  .sidebar-heading {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--amber, #3B8C6E);
