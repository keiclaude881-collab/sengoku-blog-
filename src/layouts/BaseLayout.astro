---
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/components.css';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title:        string;
  description:  string;
  ogImage?:     string;
  type?:        "website" | "article";
  publishedAt?: string;
}
const { title, description, ogImage, type, publishedAt } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BHX5CSD6G8"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BHX5CSD6G8');
    </script>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      publishedAt={publishedAt}
    />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // スクロールフェードイン
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>
