---
const year = new Date().getFullYear();

const SUBSTACK_URL  = "https://ijin-lab.substack.com/";

const cols = [
  {
    title: "サイト情報",
    links: [
      { label: "このサイトについて",     href: "/about/" },
      { label: "プライバシーポリシー",   href: "/privacy/" },
      { label: "お問い合わせ",           href: "/contact/" },
    ],
  },
];
---

<footer class="site-footer">

  <!-- Main footer -->
  <div class="footer-main">
    <div class="container footer-main-inner">

      <div class="footer-brand">
        <a href="/" class="footer-logo">偉人<span>ラボ</span></a>
        <p class="footer-tagline">歴史の偉人が、現代の問題を解決する。</p>
        <p class="footer-desc">信長・ナポレオン・シーザー・孫子——時代を超えた偉人たちの思考を現代に翻訳。仕事・人間関係・決断・逆境——あなたの悩みへの答えがここにある。</p>
      </div>

      <nav class="footer-nav" aria-label="フッターナビ">
        {cols.map(col => (
          <div class="footer-col">
            <h3 class="footer-col-title">{col.title}</h3>
            <ul>
              {col.links.map(({ label, href }) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copy">&copy; {year} 偉人ラボ. All rights reserved.</p>
      <p class="affiliate-notice">
        本サイトはAmazonアソシエイト・プログラムの参加者です。
      </p>
    </div>
  </div>

</footer>

<style>
  .site-footer {
    background: var(--bg2);
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  /* Main */
  .footer-main { padding: 3rem 0 2rem; }
  .footer-main-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
  }

  .footer-logo {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 0.8rem;
  }
  .footer-logo span { color: var(--ink2); }

  .footer-tagline {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink3);
    letter-spacing: 0.04em;
    margin-bottom: 0.8rem;
  }
  .footer-desc {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.9;
    color: var(--ink3);
    max-width: 300px;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .footer-col-title {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink3);
    margin-bottom: 1rem;
  }
  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-col a {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink2);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-col a:hover { color: var(--ink); }

  /* Bottom */
  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 1.2rem 0;
  }
  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .copy, .affiliate-notice {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink3);
  }

  @media (max-width: 768px) {
    .footer-main-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-nav {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .footer-nl-inner { flex-direction: column; align-items: flex-start; }
    .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 480px) {
    .footer-nav { grid-template-columns: 1fr; }
  }
</style>
