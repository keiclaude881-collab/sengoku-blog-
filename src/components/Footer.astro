---
const year = new Date().getFullYear();
const cols = [
  {
    title: "カテゴリ",
    links: [
      { label: "決断できない時",       href: "/category/decide/" },
      { label: "チームがうまくいかない時", href: "/category/lead/" },
      { label: "逆境・失敗した時",     href: "/category/recover/" },
      { label: "戦略・方向性に迷った時", href: "/category/strategy/" },
      { label: "自分を変えたい時",     href: "/category/change/" },
    ],
  },
  {
    title: "サイト情報",
    links: [
      { label: "はじめての方へ",     href: "/start/" },
      { label: "記事一覧",           href: "/blog/" },
      { label: "おすすめ書籍",       href: "/books/" },
      { label: "このブログについて", href: "/about/" },
      { label: "プライバシーポリシー", href: "/privacy/" },
    ],
  },
];
---

<footer class="site-footer">
  <!-- ニュースレター登録 -->
  <div class="footer-newsletter">
    <div class="container footer-newsletter-inner">
      <div class="newsletter-text">
        <h2 class="newsletter-heading">週一回、武将の知恵を受け取る</h2>
        <p class="newsletter-desc">新着記事・武将の名言・ビジネス応用コラムを毎週お届け。</p>
      </div>
      <a
        href="https://note.com/ketsudan_keifu"
        target="_blank"
        rel="noopener noreferrer"
        class="newsletter-btn"
      >無料で購読する →</a>
    </div>
  </div>

  <div class="footer-top">
    <div class="container footer-inner">
      <nav class="footer-nav" aria-label="フッターナビ">
        {cols.map(col => (
          <div class="footer-col">
            <h3 class="footer-col-title">{col.title}</h3>
            <ul>
              {col.links.map(({ label, href }) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copy">&copy; {year} 決断の系譜. All rights reserved.</p>
      <p class="affiliate-notice">
        本サイトはAmazonアソシエイトプログラム・U-NEXTアフィリエイトプログラムに参加しています。
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg2);
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }

  /* ニュースレター */
  .footer-newsletter {
    background: linear-gradient(135deg, #1E4A35 0%, #162e20 100%);
    border-bottom: 1px solid rgba(59, 140, 110, 0.3);
    padding: 2.2rem 0;
  }
  .footer-newsletter-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .newsletter-heading {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.03em;
    margin-bottom: 0.4rem;
  }
  .newsletter-desc {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
  }
  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.6rem;
    background: var(--gold, #3B8C6E);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .newsletter-btn:hover { background: var(--gold-dark, #2A6B50); }

  @media (max-width: 640px) {
    .footer-newsletter-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-xl);
    padding-top: var(--sp-xl);
    padding-bottom: var(--sp-lg);
  }

  .footer-logo {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
    margin-bottom: 0.8rem;
    text-decoration: none;
  }
  .footer-logo em {
    font-style: normal;
    color: var(--gold);
  }

  .footer-tagline {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--gold);
    letter-spacing: 0.06em;
    margin-bottom: 0.8rem;
  }

  .footer-desc {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.85;
    color: var(--ink3);
    max-width: 360px;
  }

  .footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }
  .social-btn {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink2);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.35rem 0.8rem;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .social-btn:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-lg);
  }

  .footer-col-title {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col a {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--ink2);
    text-decoration: none;
    transition: color 0.2s;
    letter-spacing: 0.02em;
  }
  .footer-col a:hover { color: var(--ink); }

  .footer-bottom {
    border-top: 1px solid var(--rule);
    padding: 1.2rem 0;
    background: var(--bg2);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .copy, .affiliate-notice {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--ink3);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--sp-lg);
    }
    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
