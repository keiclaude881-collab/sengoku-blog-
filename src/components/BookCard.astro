---
interface Props {
  title:       string;
  asin?:       string;
  rakutenUrl?: string;
  reason:      string;
  image?:      string;
}
const { title, asin, rakutenUrl, reason, image } = Astro.props;

// 紙ASIN → Kindle ASIN 変換マップ（報酬率 2.7% → 7.2%）
const KINDLE_MAP: Record<string, string> = {
  '4122018331': 'B00BN16XX8', // 失敗の本質
  '4122075939': 'B00BN16XX8', // 失敗の本質（別版）
  '4101152128': 'B00SQY8JLY', // 関ヶ原（上）→ 合本版
  '4101152314': 'B00W1FH0GY', // 項羽と劉邦（上）→ 合本版
  '4101152381': 'B00SQY8KAO', // 覇王の家（上）→ 合本版
  '4101152063': 'B00SQY8K72', // 国盗り物語 → 合本版
  '4101152071': 'B00SQY8K72', // 国盗り物語（別巻）→ 合本版
};
const resolvedAsin = asin ? (KINDLE_MAP[asin] ?? asin) : asin;

const amazonUrl = resolvedAsin
  ? `https://af.moshimo.com/af/c/click?a_id=5427522&p_id=170&pc_id=185&pl_id=4062&url=${encodeURIComponent(`https://www.amazon.co.jp/dp/${resolvedAsin}/`)}`
  : null;

// 楽天アフィリエイトID
const RAKUTEN_AFF_ID = '27c79185.3f0d32df.27c79186.3b79dc5f';
// rakutenUrl が未指定の場合はタイトル検索URLを自動生成
const autoRakutenUrl = `https://hb.afl.rakuten.co.jp/ichiba/${RAKUTEN_AFF_ID}/?pc=${encodeURIComponent(`https://books.rakuten.co.jp/search?svc=30&g=001&s1=20&ej=0&e=1&w=${encodeURIComponent(title)}`)}`;
const finalRakutenUrl = rakutenUrl ?? autoRakutenUrl;

const primaryUrl = amazonUrl ?? finalRakutenUrl ?? '#';
const placeholderChars = ['兵', '謀', '戦', '策', '智', '将', '武', '覇', '道', '義'];
const placeholderChar = asin ? (placeholderChars[parseInt(asin.slice(-1), 10)] ?? '書') : '書';
const coverUrl = image ?? (resolvedAsin ? `https://images-na.ssl-images-amazon.com/images/P/${resolvedAsin}.01.LZZZZZZZ.jpg` : null);
---

<div class="book-card">
  <a
    href={primaryUrl}
    target="_blank"
    rel="nofollow sponsored noopener"
    class="book-link"
    aria-label={`${title} - ${amazonUrl ? 'Amazonで見る' : '楽天で見る'}`}
  >
    <div class="book-cover">
      {coverUrl ? (
        <>
          <img
            src={coverUrl}
            alt={title}
            width="120"
            height="180"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display=''"
          />
          <span class="cover-placeholder" aria-hidden="true" style="display:none">{placeholderChar}</span>
        </>
      ) : (
        <span class="cover-placeholder" aria-hidden="true">{placeholderChar}</span>
      )}
    </div>

    <div class="book-info">
      <p class="book-title">{title}</p>
      <p class="book-reason">{reason}</p>
      <span class={`book-cta ${!amazonUrl && rakutenUrl ? 'rakuten' : ''}`}>
        <span class="cta-text">{amazonUrl ? 'Amazonで見る' : '楽天で見る'}</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>

  {amazonUrl && (
    <a
      href={finalRakutenUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="rakuten-btn"
    >楽天でも見る →</a>
  )}
</div>

<style>
  .book-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    overflow: hidden;
  }
  .book-card:hover {
    border-color: var(--orange);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .book-link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.2rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .book-cover {
    aspect-ratio: 2/3;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 3px;
  }
  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-placeholder {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.3);
    user-select: none;
  }

  .book-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .book-title {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.55;
    color: #fff;
  }

  .book-reason {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.65);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .book-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.55rem 0;
    background: var(--orange);
    border-radius: 3px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.05em;
    margin-top: auto;
    transition: background 0.2s;
  }
  .book-card:hover .book-cta {
    background: var(--orange-dark);
  }
  .cta-arrow {
    transition: transform 0.2s;
    display: inline-block;
  }
  .book-card:hover .cta-arrow {
    transform: translateX(3px);
  }

  .book-cta.rakuten {
    background: #bf0000;
  }
  .book-card:hover .book-cta.rakuten {
    background: #990000;
  }

  .rakuten-btn {
    display: block;
    text-align: center;
    padding: 0.45rem;
    background: #bf0000;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
    border-top: 1px solid rgba(255,255,255,0.1);
    transition: background 0.2s;
  }
  .rakuten-btn:hover {
    background: #990000;
  }
</style>
