---
const navLinks = [
  { label: '決断できない時',       href: '/category/decide/' },
  { label: 'チームがうまくいかない時', href: '/category/lead/' },
  { label: '逆境・失敗した時',     href: '/category/recover/' },
  { label: '戦略・方向性に迷った時', href: '/category/strategy/' },
  { label: '自分を変えたい時',     href: '/category/change/' },
  { label: '年表',               href: '/timeline/' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-logo" aria-label="決断の系譜 トップへ">
      <span class="logo-text">決断の<em>系譜</em></span>
    </a>

    <nav class="site-nav" aria-label="メインナビゲーション">
      <ul class="nav-list">
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: currentPath.startsWith(href) }]}
              aria-current={currentPath.startsWith(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="https://af.moshimo.com/af/c/click?a_id=5427522&p_id=170&pc_id=185&pl_id=4062&url=https%3A%2F%2Fwww.amazon.co.jp%2Fftu%2Fhome"
      target="_blank"
      rel="noopener noreferrer"
      class="header-audible"
      aria-label="Audible 30日間無料体験"
    >
      <span class="audible-full">📚 戦略書を無料で聴く</span>
      <span class="audible-short">📚 Audible</span>
    </a>

  </div>
</header>

<style>
  .site-header {
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-height);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 2rem;
  }

  .site-logo {
    display: inline-block;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
  }
  .logo-text em {
    font-style: normal;
    color: var(--gold);
  }

  .site-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 0.2rem;
  }

  .nav-link {
    display: block;
    color: var(--ink2);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    padding: 0.4em 0.65em;
    border-radius: 2px;
    text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link.active { color: var(--gold); font-weight: 500; }

  .header-audible {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    background: var(--gold);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s, opacity 0.2s;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .header-audible:hover { background: var(--gold-dark, #2A6B50); }

  .audible-short { display: none; }

  .header-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.4rem;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .header-cta:hover { background: var(--gold); }

  @media (max-width: 1000px) {
    .site-nav { display: none; }
  }

  @media (max-width: 640px) {
    .audible-full { display: none; }
    .audible-short { display: inline; }
  }

  @media (max-width: 480px) {
    .header-cta { display: none; }
  }
</style>
