---
---

<section class="hero" aria-label="ヒーロー">
  <!-- 雷キャンバス -->
  <canvas class="lightning-canvas" id="lightning-canvas" aria-hidden="true"></canvas>
  <!-- 雷光フラッシュ -->
  <div class="hero-flash" id="hero-flash" aria-hidden="true"></div>

  <div class="hero-inner container">

    <!-- 左：テキスト＋CTA -->
    <div class="hero-content">
      <p class="hero-eyebrow">
        <span class="eyebrow-line"></span>
        月曜日の悩みに、戦国武将が答える。
      </p>

      <h1 class="hero-title" id="hero-title">
        迷っているあなたへ。<br>
        <em>歴史上の誰かも、</em><br>
        同じ夜を越えてきた。
      </h1>

      <p class="hero-body">
        決断できない。正解がわからない。<br class="br-pc">
        そんな時、500年前の武将たちが<br class="br-pc">
        意外なほどリアルな答えを持っている。
      </p>

      <div class="hero-cta">
        <a href="#themes" class="cta-primary">今の悩みから読む →</a>
        <a href="/timeline/" class="cta-ghost">戦いの年表を見る</a>
      </div>
    </div>


  </div>
</section>

<script>
  const canvas = document.getElementById('lightning-canvas') as HTMLCanvasElement | null;
  const flash  = document.getElementById('hero-flash') as HTMLElement | null;
  const title  = document.getElementById('hero-title') as HTMLElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');

    function resize() {
      const hero = canvas!.parentElement!;
      canvas!.width  = hero.offsetWidth;
      canvas!.height = hero.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    function drawBolt(
      x1: number, y1: number,
      x2: number, y2: number,
      depth: number
    ) {
      if (!ctx) return;
      if (depth === 0) {
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
        return;
      }
      const dx   = x2 - x1;
      const dy   = y2 - y1;
      const len  = Math.sqrt(dx * dx + dy * dy);
      const midX = (x1 + x2) / 2 + (Math.random() - 0.5) * len * 0.45;
      const midY = (y1 + y2) / 2 + (Math.random() - 0.25) * Math.abs(dy) * 0.3;

      drawBolt(x1, y1, midX, midY, depth - 1);
      drawBolt(midX, midY, x2, y2, depth - 1);

      // ランダムな枝
      if (depth > 2 && Math.random() > 0.55) {
        const bx = midX + (Math.random() - 0.35) * dx * 0.6;
        const by = midY + Math.random() * dy * 0.5;
        ctx.globalAlpha = 0.45;
        drawBolt(midX, midY, bx, by, depth - 2);
        ctx.globalAlpha = 1;
      }
    }

    function strike() {
      if (!ctx || !canvas) return;
      const W = canvas.width;
      const H = canvas.height;

      // 右上〜中央付近の雲から落ちる
      const startX = W * (0.42 + Math.random() * 0.5);
      const startY = H * (0.04 + Math.random() * 0.12);
      const endX   = startX + (Math.random() - 0.5) * W * 0.25;
      const endY   = H * (0.45 + Math.random() * 0.35);

      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = 'rgba(210, 235, 255, 0.92)';
      ctx.lineWidth   = 1.2;
      ctx.shadowColor = 'rgba(150, 210, 255, 1)';
      ctx.shadowBlur  = 14;
      ctx.globalAlpha = 1;

      drawBolt(startX, startY, endX, endY, 7);

      // フラッシュ（ゆっくり）
      if (flash) {
        flash.style.transition = 'none';
        flash.style.opacity = '0.18';
        setTimeout(() => {
          if (flash) { flash.style.transition = 'opacity 0.25s'; flash.style.opacity = '0'; }
        }, 120);
        setTimeout(() => {
          if (flash) { flash.style.transition = 'none'; flash.style.opacity = '0.08'; }
        }, 250);
        setTimeout(() => {
          if (flash) { flash.style.transition = 'opacity 0.4s'; flash.style.opacity = '0'; }
        }, 350);
      }

      // タイトルを一瞬グローさせる
      if (title) {
        title.classList.add('title-flash');
        setTimeout(() => title?.classList.remove('title-flash'), 600);
      }

      // ボルト消去（ゆっくりフェード）
      setTimeout(() => {
        if (!ctx || !canvas) return;
        let alpha = 1;
        const fade = setInterval(() => {
          alpha -= 0.08;
          if (alpha <= 0) { clearInterval(fade); ctx.clearRect(0, 0, canvas.width, canvas.height); return; }
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.globalAlpha = alpha;
          drawBolt(startX, startY, endX, endY, 7);
          ctx.globalAlpha = 1;
        }, 30);
      }, 300);
    }

    function scheduleNext() {
      const delay = 5000 + Math.random() * 10000; // 5〜15秒ランダム
      setTimeout(() => {
        strike();
        scheduleNext();
      }, delay);
    }

    // 最初は2秒後に打つ
    setTimeout(() => { strike(); scheduleNext(); }, 2000);
  }
</script>

<style>
  .hero {
    position: relative;
    background:
      linear-gradient(to right, rgba(5,12,5,0.82) 0%, rgba(5,12,5,0.55) 55%, rgba(5,12,5,0.25) 100%),
      url('/images/header-bg.jpg') center center / cover no-repeat;
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* 雷キャンバス */
  .lightning-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* 雷光フラッシュ */
  .hero-flash {
    position: absolute;
    inset: 0;
    background: rgba(200, 230, 255, 1);
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: overlay;
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    padding-top: calc(var(--nav-height) + 4rem);
    padding-bottom: 5rem;
  }

  /* ── 左：コンテンツ ── */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
    max-width: 620px;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
  }
  .eyebrow-line {
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--gold);
    flex-shrink: 0;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.25;
    letter-spacing: 0.02em;
    /* 常時うっすらグロー */
    text-shadow:
      0 0 40px rgba(59, 140, 110, 0.15),
      0 0 80px rgba(59, 140, 110, 0.05);
    transition: text-shadow 0.2s;
  }
  /* 雷に合わせてフラッシュ */
  .hero-title.title-flash {
    text-shadow:
      0 0 20px rgba(200, 230, 255, 0.7),
      0 0 50px rgba(200, 230, 255, 0.4),
      0 0 100px rgba(200, 230, 255, 0.15);
  }
  .hero-title em {
    font-style: normal;
    color: var(--gold);
    /* emは常時グリーングロー */
    animation: em-glow 4s ease-in-out infinite;
  }
  @keyframes em-glow {
    0%, 100% {
      text-shadow:
        0 0 12px rgba(59, 140, 110, 0.4),
        0 0 24px rgba(59, 140, 110, 0.2);
    }
    50% {
      text-shadow:
        0 0 20px rgba(59, 140, 110, 0.7),
        0 0 40px rgba(59, 140, 110, 0.35),
        0 0 60px rgba(59, 140, 110, 0.15);
    }
  }

  .hero-body {
    font-family: var(--font-serif);
    font-size: clamp(0.9rem, 1.4vw, 1rem);
    font-weight: 400;
    line-height: 2.1;
    color: rgba(255,255,255,0.8);
    border-left: 2px solid var(--gold-light);
    padding-left: 1.2rem;
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 2.4rem;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .cta-primary:hover {
    background: var(--accent);
    transform: translateY(-1px);
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 2rem;
    background: transparent;
    color: rgba(255,255,255,0.85);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255,255,255,0.45);
    border-radius: 2px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .cta-ghost:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  /* ── レスポンシブ ── */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding-top: calc(var(--nav-height) + 3rem);
      padding-bottom: 4rem;
    }
  }

  @media (max-width: 480px) {
    .hero-inner {
      padding-top: calc(var(--nav-height) + 2rem);
      padding-bottom: 3rem;
      gap: 2.5rem;
    }
    .br-pc { display: none; }
  }
</style>
