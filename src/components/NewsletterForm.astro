---
const formspreeId = import.meta.env.FORMSPREE_ID ?? "";
---

<section class="newsletter" aria-label="メールマガジン登録">
  <div class="newsletter-inner">
    <p class="newsletter-eyebrow">NEWSLETTER</p>
    <h2 class="newsletter-title">戦略の知恵を、週に一度。</h2>
    <p class="newsletter-desc">
      新着記事・武将の名言・ビジネス応用コラムをまとめてお届けします。
    </p>

    {formspreeId ? (
      <form
        class="newsletter-form"
        action={`https://formspree.io/f/${formspreeId}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="戦略の系譜 メルマガ登録" />
        <div class="newsletter-row">
          <label for="nl-email" class="sr-only">メールアドレス</label>
          <input
            id="nl-email"
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            class="newsletter-input"
            autocomplete="email"
          />
          <button type="submit" class="newsletter-btn">登録する</button>
        </div>
        <p class="newsletter-note">
          スパムはしません。いつでも解除できます。
        </p>
      </form>
    ) : (
      <p class="newsletter-unavailable">現在準備中です。</p>
    )}
  </div>
</section>

<style>
  .newsletter {
    background: var(--bg-navy);
    border-radius: 6px;
    margin: var(--sp-lg) 0;
    overflow: hidden;
    position: relative;
  }
  .newsletter::before {
    content: "策";
    font-family: var(--font-serif);
    font-size: 18rem;
    font-weight: 800;
    color: rgba(185, 28, 28, 0.05);
    position: absolute;
    right: -1rem;
    bottom: -2rem;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .newsletter-inner {
    padding: var(--sp-lg);
    position: relative;
    z-index: 1;
    max-width: 560px;
  }
  .newsletter-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--amber, #d4a017);
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .newsletter-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.03em;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  .newsletter-desc {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1.5rem;
  }
  .newsletter-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .newsletter-input {
    flex: 1;
    min-width: 200px;
    padding: 0.65rem 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }
  .newsletter-input:focus {
    border-color: var(--orange, #c2410c);
  }
  .newsletter-btn {
    padding: 0.65rem 1.5rem;
    background: var(--orange, #c2410c);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    letter-spacing: 0.05em;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .newsletter-btn:hover {
    background: var(--orange-dark, #9a3412);
  }
  .newsletter-note {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.3);
  }
  .newsletter-unavailable {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.4);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
  }
</style>
