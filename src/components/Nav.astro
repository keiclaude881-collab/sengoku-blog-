---
import { THEME_INFO, THEME_ORDER } from "../utils/arcMap";

const path = Astro.url.pathname;

const themes = THEME_ORDER.map(slug => ({
  slug,
  ...THEME_INFO[slug],
}));

const INSTAGRAM_URL = "https://www.instagram.com/ijin_lab/";
const SUBSTACK_URL  = "https://ijin-lab.substack.com/";
---

<nav class="site-nav" aria-label="メインナビゲーション">
  <div class="nav-inner">

    <a href="/" class="nav-logo">
      偉人<span class="logo-accent">ラボ</span>
    </a>

    <ul class="nav-links" role="list">

      <!-- 悩みで探す -->
      <li class="nav-dropdown-wrap">
        <button
          class:list={["nav-link nav-dropdown-btn", {
            active: themes.some(t => path.startsWith(`/category/${t.slug}`))
          }]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          悩みで探す <span class="dropdown-arrow">▾</span>
        </button>
        <div class="nav-dropdown">
          <ul role="list">
            {themes.map(t => (
              <li>
                <a
                  href={`/category/${t.slug}/`}
                  class:list={["dropdown-link", { active: path.startsWith(`/category/${t.slug}`) }]}
                >
                  <span class="drop-label">{t.label}</span>
                  <span class="drop-desc">{t.tagline}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>

      <!-- 作品で読む -->
      <li class="nav-dropdown-wrap">
        <button
          class:list={["nav-link nav-dropdown-btn", {
            active: ["/books/","/anime/","/movies/","/novel/","/philosophy/"].some(p => path.startsWith(p))
          }]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          作品で読む <span class="dropdown-arrow">▾</span>
        </button>
        <div class="nav-dropdown nav-dropdown--media">
          <ul role="list">
            <li><a href="/books/"      class:list={["dropdown-link", { active: path.startsWith("/books/") }]}>📚 書籍</a></li>
            <li><a href="/anime/"      class:list={["dropdown-link", { active: path.startsWith("/anime/") }]}>🎬 アニメ</a></li>
            <li><a href="/movies/"     class:list={["dropdown-link", { active: path.startsWith("/movies/") }]}>🎥 映画</a></li>
            <li><a href="/novel/"      class:list={["dropdown-link", { active: path.startsWith("/novel/") }]}>📖 小説</a></li>
            <li><a href="/philosophy/" class:list={["dropdown-link", { active: path.startsWith("/philosophy/") }]}>🧠 哲学</a></li>
          </ul>
        </div>
      </li>

      <!-- もしも -->
      <li>
        <a
          href="/category/whatif/"
          class:list={["nav-link", { active: path.startsWith("/whatif/") || path.includes("whatif") }]}
        >
          もしも歴史
        </a>
      </li>

    </ul>

    <div class="nav-right">
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="nav-cta nav-cta--insta" aria-label="Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        <span>インスタ</span>
      </a>
      <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="nav-cta nav-cta--sub">
        ニュースレター
      </a>
      <button class="nav-toggle" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>

  <!-- モバイルメニュー -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <ul role="list">
      <li class="mobile-section-title">悩みで探す</li>
      {themes.map(t => (
        <li>
          <a href={`/category/${t.slug}/`} class:list={["mobile-link", { active: path.startsWith(`/category/${t.slug}`) }]}>
            {t.label}
          </a>
        </li>
      ))}
      <li class="mobile-section-title">作品で読む</li>
      <li><a href="/books/"      class:list={["mobile-link", { active: path.startsWith("/books/") }]}>📚 書籍</a></li>
      <li><a href="/anime/"      class:list={["mobile-link", { active: path.startsWith("/anime/") }]}>🎬 アニメ</a></li>
      <li><a href="/movies/"     class:list={["mobile-link", { active: path.startsWith("/movies/") }]}>🎥 映画</a></li>
      <li><a href="/novel/"      class:list={["mobile-link", { active: path.startsWith("/novel/") }]}>📖 小説</a></li>
      <li><a href="/philosophy/" class:list={["mobile-link", { active: path.startsWith("/philosophy/") }]}>🧠 哲学</a></li>
      <li class="mobile-section-title">もしも歴史</li>
      <li><a href="/category/whatif/" class="mobile-link">もしも歴史一覧</a></li>
      <li class="mobile-divider"></li>
      <li><a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="mobile-link mobile-link--accent">📸 Instagram @ijin_lab</a></li>
      <li><a href={SUBSTACK_URL}  target="_blank" rel="noopener noreferrer" class="mobile-link mobile-link--accent">📩 ニュースレター登録</a></li>
    </ul>
  </div>
</nav>

<script>
  const nav    = document.querySelector('.site-nav') as HTMLElement;
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const menu   = document.querySelector('.mobile-menu') as HTMLElement;

  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    menu.setAttribute('aria-hidden', String(!isOpen));
  });
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      nav.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    });
  });

  const dropWraps = document.querySelectorAll('.nav-dropdown-wrap') as NodeListOf<HTMLElement>;
  function closeAll(except?: HTMLElement) {
    dropWraps.forEach(wrap => {
      if (wrap !== except) {
        wrap.classList.remove('open');
        (wrap.querySelector('.nav-dropdown-btn') as HTMLButtonElement | null)?.setAttribute('aria-expanded', 'false');
      }
    });
  }
  dropWraps.forEach(wrap => {
    const btn = wrap.querySelector('.nav-dropdown-btn') as HTMLButtonElement | null;
    btn?.addEventListener('click', e => {
      e.stopPropagation();
      const isOpen = wrap.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) closeAll(wrap);
    });
  });
  document.addEventListener('click', () => closeAll());
</script>

<style>
  .site-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.3s;
  }
  .site-nav.scrolled { box-shadow: 0 2px 16px rgba(0,0,0,0.07); }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Logo */
  .nav-logo {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    color: var(--ink);
    flex-shrink: 0;
    margin-right: 1rem;
  }
  .logo-accent { color: var(--violet); }

  /* Links */
  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.1rem;
    flex: 1;
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--ink2);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    border: none;
    background: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
    text-decoration: none;
  }
  .nav-link:hover { background: var(--bg2); color: var(--ink); }
  .nav-link.active { color: var(--violet); font-weight: 600; }

  .dropdown-arrow { font-size: 0.6rem; transition: transform 0.2s; }
  .nav-dropdown-wrap.open .dropdown-arrow { transform: rotate(180deg); }

  /* Dropdown */
  .nav-dropdown-wrap { position: relative; }
  .nav-dropdown-btn  { display: flex; align-items: center; gap: 0.3rem; }
  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.10);
    list-style: none;
    z-index: 200;
    overflow: hidden;
    min-width: 260px;
  }
  .nav-dropdown-wrap.open .nav-dropdown { display: block; }
  .nav-dropdown ul { list-style: none; }
  .nav-dropdown--media { min-width: 160px; }

  .dropdown-link {
    display: block;
    padding: 0.75rem 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink2);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: background 0.12s, color 0.12s;
  }
  .dropdown-link:last-child { border-bottom: none; }
  .dropdown-link:hover, .dropdown-link.active {
    background: var(--violet-light);
    color: var(--violet);
  }
  .drop-label {
    display: block;
    font-weight: 600;
    font-size: 0.84rem;
    color: var(--ink);
    margin-bottom: 0.15rem;
  }
  .drop-desc {
    display: block;
    font-size: 0.72rem;
    color: var(--ink3);
    line-height: 1.4;
  }
  .dropdown-link:hover .drop-label { color: var(--violet); }

  /* Right CTAs */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    flex-shrink: 0;
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.9rem;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .nav-cta--insta {
    color: var(--ink2);
    border: 1px solid var(--border);
  }
  .nav-cta--insta:hover { background: var(--bg2); color: var(--ink); }
  .nav-cta--sub {
    background: var(--violet);
    color: #fff;
  }
  .nav-cta--sub:hover { background: var(--violet-dark); }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px; height: 36px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    padding: 7px;
    flex-shrink: 0;
  }
  .nav-toggle span {
    display: block;
    width: 100%; height: 1.5px;
    background: var(--ink);
    transition: transform 0.25s, opacity 0.25s;
  }
  .menu-open .nav-toggle span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-open .nav-toggle span:nth-child(2) { opacity: 0; }
  .menu-open .nav-toggle span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
    background: #fff;
    border-top: 1px solid var(--border);
  }
  .mobile-menu ul { list-style: none; }
  .mobile-section-title {
    padding: 0.6rem 1.5rem 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink3);
    background: var(--bg2);
  }
  .mobile-divider {
    height: 1px;
    background: var(--border);
    margin: 0.25rem 0;
  }
  .mobile-link {
    display: block;
    padding: 0.85rem 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink2);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: background 0.12s, color 0.12s;
  }
  .mobile-link:hover, .mobile-link.active {
    background: var(--violet-light);
    color: var(--violet);
  }
  .mobile-link--accent { color: var(--violet); font-weight: 600; }

  @media (max-width: 860px) {
    .nav-links  { display: none; }
    .nav-cta--insta span { display: none; }
    .nav-cta--sub { display: none; }
    .nav-toggle { display: flex; }
    .mobile-menu { display: block; }
  }
  .menu-open .mobile-menu { max-height: 1400px; }

  @media (max-width: 480px) {
    .nav-inner { padding: 0 1rem; }
    .nav-logo  { font-size: 1rem; }
    .nav-cta--insta { display: none; }
  }
</style>
