---
const links = [
  { label: "記事一覧",   href: "/blog/" },
  { label: "映画",       href: "/movies/", cinema: true },
  { label: "書籍",       href: "/books/" },
];

const dropdownLinks = [
  { label: "合戦と戦略",   href: "/category/battle/" },
  { label: "武将の思想",   href: "/category/leader/" },
  { label: "兵法・現代応用", href: "/category/strategy/" },
  { label: "歴史IF",       href: "/category/whatif/" },
  { label: "アニメ戦略論", href: "/category/anime/" },
  { label: "ビジネス戦略", href: "/category/business/" },
  { label: "スポーツ戦略", href: "/category/sports/" },
];
const path = Astro.url.pathname;
---

<nav class="site-nav" aria-label="メインナビゲーション">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      決断の<span class="logo-accent">系譜</span>
    </a>

    <ul class="nav-links" role="list">
      <!-- カテゴリドロップダウン -->
      <li class="nav-dropdown-wrap">
        <button class="nav-link nav-dropdown-btn" aria-expanded="false" aria-haspopup="true">
          カテゴリ <span class="dropdown-arrow">▾</span>
        </button>
        <ul class="nav-dropdown" role="list">
          {dropdownLinks.map(({ label, href }) => (
            <li>
              <a href={href} class:list={["dropdown-link", { active: path.startsWith(href) }]}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </li>
      {links.map(({ label, href, cinema }) => (
        <li>
          <a
            href={href}
            class:list={["nav-link", { active: path.startsWith(href), "nav-link--cinema": cinema }]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <button class="nav-toggle" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <ul role="list">
      {dropdownLinks.map(({ label, href }) => (
        <li>
          <a href={href} class:list={["mobile-link", { active: path.startsWith(href) }]}>
            {label}
          </a>
        </li>
      ))}
      {links.map(({ label, href, cinema }) => (
        <li>
          <a href={href} class:list={["mobile-link", { active: path.startsWith(href), "mobile-link--cinema": cinema }]}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const nav    = document.querySelector('.site-nav') as HTMLElement;
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const menu   = document.querySelector('.mobile-menu') as HTMLElement;

  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    menu.setAttribute('aria-hidden', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      nav.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    });
  });

  // ドロップダウン
  const dropBtn = document.querySelector('.nav-dropdown-btn') as HTMLButtonElement | null;
  const dropWrap = document.querySelector('.nav-dropdown-wrap') as HTMLElement | null;
  dropBtn?.addEventListener('click', () => {
    const isOpen = dropWrap?.classList.toggle('open');
    dropBtn.setAttribute('aria-expanded', String(!!isOpen));
  });
  document.addEventListener('click', (e) => {
    if (!dropWrap?.contains(e.target as Node)) {
      dropWrap?.classList.remove('open');
      dropBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.3s;
  }
  .site-nav.scrolled {
    box-shadow: 0 2px 12px rgba(26, 10, 10, 0.08);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-logo {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-accent { color: var(--orange); }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-mid);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 3px;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover {
    background: var(--bg-sub);
    color: var(--text);
  }
  .nav-link.active {
    color: var(--orange);
    font-weight: 600;
  }
  .nav-link--cinema {
    color: #e8b84b;
    font-weight: 600;
  }
  .nav-link--cinema:hover {
    background: rgba(232, 184, 75, 0.1);
    color: #e8b84b;
  }
  .nav-link--cinema.active {
    color: #e8b84b;
  }

  /* ── ドロップダウン ── */
  .nav-dropdown-wrap {
    position: relative;
  }
  .nav-dropdown-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .dropdown-arrow {
    font-size: 0.65rem;
    transition: transform 0.2s;
  }
  .nav-dropdown-wrap.open .dropdown-arrow {
    transform: rotate(180deg);
  }
  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 180px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    list-style: none;
    z-index: 200;
    overflow: hidden;
  }
  .nav-dropdown-wrap.open .nav-dropdown {
    display: block;
  }
  .dropdown-link {
    display: block;
    padding: 0.65rem 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--text-mid);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    border-bottom: 1px solid var(--border);
  }
  .dropdown-link:last-child { border-bottom: none; }
  .dropdown-link:hover,
  .dropdown-link.active {
    background: var(--bg-sub);
    color: var(--orange);
  }

  /* ── ハンバーガー ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: 1.5px solid var(--border-mid);
    border-radius: 4px;
    cursor: pointer;
    padding: 7px;
    flex-shrink: 0;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.3s, opacity 0.3s;
    transform-origin: center;
  }
  .menu-open .nav-toggle span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-open .nav-toggle span:nth-child(2) { opacity: 0; }
  .menu-open .nav-toggle span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── モバイルメニュー ── */
  .mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }
  .mobile-menu ul { list-style: none; }

  .mobile-link {
    display: block;
    padding: 0.95rem 2rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-mid);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s, color 0.15s;
  }
  .mobile-link:hover,
  .mobile-link.active {
    background: var(--bg-sub);
    color: var(--orange);
  }
  .mobile-link--cinema {
    color: #e8b84b;
  }
  .mobile-link--cinema:hover,
  .mobile-link--cinema.active {
    background: rgba(232, 184, 75, 0.08);
    color: #e8b84b;
  }

  @media (max-width: 720px) {
    .nav-links  { display: none; }
    .nav-toggle { display: flex; }
    .mobile-menu { display: block; }
  }
  .menu-open .mobile-menu { max-height: 640px; }

  @media (max-width: 480px) {
    .nav-inner { padding: 0 1.2rem; }
    .nav-logo  { font-size: 0.98rem; }
  }
</style>
