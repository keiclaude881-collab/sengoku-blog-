---
import { ARC_INFO, ARC_ORDER, CAT_LABEL } from "../utils/arcMap";

const path = Astro.url.pathname;

const chapters = ARC_ORDER.map(slug => ({
  ...ARC_INFO[slug],
  href: `/arc/${slug}/`,
}));
---

<nav class="site-nav" aria-label="メインナビゲーション">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      決断の<span class="logo-accent">系譜</span>
    </a>

    <ul class="nav-links" role="list">
      <li>
        <a href="/start/" class:list={["nav-link nav-link--start", { active: path === "/start/" }]}>
          はじめての方へ
        </a>
      </li>

      {chapters.map(ch => (
        <li class="nav-dropdown-wrap" data-arc={ch.slug}>
          <button
            class:list={["nav-link nav-dropdown-btn nav-link--chapter", { active: path.startsWith(`/arc/${ch.slug}`) }]}
            aria-expanded="false"
            aria-haspopup="true"
            style={path.startsWith(`/arc/${ch.slug}`) ? `color: ${ch.color};` : ""}
          >
            <span class="chapter-num">{ch.chapter}</span>
            <span class="chapter-title">{ch.title}</span>
            <span class="dropdown-arrow">▾</span>
          </button>
          <div class="nav-dropdown nav-dropdown--chapter">
            <a href={ch.href} class="dropdown-chapter-header" style={`border-left-color: ${ch.color};`}>
              <span class="dch-chapter">{ch.chapter}</span>
              <span class="dch-title">「{ch.title}」</span>
              <span class="dch-tagline">{ch.tagline}</span>
            </a>
            <ul role="list">
              {ch.categories.map(cat => (
                <li>
                  <a
                    href={`/category/${cat}/`}
                    class:list={["dropdown-link", { active: path.startsWith(`/category/${cat}/`) }]}
                  >
                    {CAT_LABEL[cat]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}

      <li>
        <a href="/books/" class:list={["nav-link", { active: path.startsWith("/books/") }]}>
          書籍
        </a>
      </li>
    </ul>

    <button class="nav-toggle" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <ul role="list">
      <li><a href="/start/" class:list={["mobile-link mobile-link--start", { active: path === "/start/" }]}>はじめての方へ</a></li>
      {chapters.map(ch => (
        <>
          <li class="mobile-chapter-header">
            <a href={ch.href} class:list={["mobile-chapter-link", { active: path.startsWith(`/arc/${ch.slug}`) }]} style={`border-left-color: ${ch.color};`}>
              <span>{ch.chapter}「{ch.title}」</span>
            </a>
          </li>
          {ch.categories.map(cat => (
            <li>
              <a href={`/category/${cat}/`} class:list={["mobile-link mobile-link--sub", { active: path.startsWith(`/category/${cat}/`) }]}>
                {CAT_LABEL[cat]}
              </a>
            </li>
          ))}
        </>
      ))}
      <li><a href="/books/" class:list={["mobile-link", { active: path.startsWith("/books/") }]}>書籍レビュー</a></li>
    </ul>
  </div>
</nav>

<script>
  const nav    = document.querySelector('.site-nav') as HTMLElement;
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const menu   = document.querySelector('.mobile-menu') as HTMLElement;

  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    menu.setAttribute('aria-hidden', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      nav.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    });
  });

  // 複数ドロップダウン対応
  const dropWraps = document.querySelectorAll('.nav-dropdown-wrap') as NodeListOf<HTMLElement>;

  function closeAll(except?: HTMLElement) {
    dropWraps.forEach(wrap => {
      if (wrap !== except) {
        wrap.classList.remove('open');
        const btn = wrap.querySelector('.nav-dropdown-btn') as HTMLButtonElement | null;
        btn?.setAttribute('aria-expanded', 'false');
      }
    });
  }

  dropWraps.forEach(wrap => {
    const btn = wrap.querySelector('.nav-dropdown-btn') as HTMLButtonElement | null;
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = wrap.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) closeAll(wrap);
    });
  });

  document.addEventListener('click', () => closeAll());
</script>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.3s;
  }
  .site-nav.scrolled {
    box-shadow: 0 2px 12px rgba(26, 10, 10, 0.08);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-logo {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-accent { color: var(--orange); }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-mid);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 3px;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover {
    background: var(--bg-sub);
    color: var(--text);
  }
  .nav-link.active {
    color: var(--orange);
    font-weight: 600;
  }
  .nav-link--cinema {
    color: #e8b84b;
    font-weight: 600;
  }
  .nav-link--cinema:hover {
    background: rgba(232, 184, 75, 0.1);
    color: #e8b84b;
  }
  .nav-link--cinema.active {
    color: #e8b84b;
  }
  .nav-link--start {
    color: var(--orange, #c0392b);
    font-weight: 600;
    border: 1px solid rgba(192, 57, 43, 0.3);
    border-radius: 3px;
  }
  .nav-link--start:hover {
    background: rgba(192, 57, 43, 0.07);
    color: var(--orange, #c0392b);
  }

  /* Chapter nav buttons */
  .nav-link--chapter {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    padding: 0.3rem 0.75rem;
    height: var(--nav-height);
    justify-content: center;
  }
  .chapter-num {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-mid);
    line-height: 1;
    display: block;
  }
  .chapter-title {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.2;
    display: block;
  }

  /* Chapter dropdown */
  .nav-dropdown--chapter {
    min-width: 220px;
  }
  .dropdown-chapter-header {
    display: block;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--amber, #d4a017);
    background: rgba(255,255,255,0.02);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  .dropdown-chapter-header:hover { background: rgba(255,255,255,0.05); }
  .dch-chapter {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-mid);
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }
  .dch-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.3rem;
  }
  .dch-tagline {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-mid);
    line-height: 1.5;
  }

  /* ── ドロップダウン ── */
  .nav-dropdown-wrap {
    position: relative;
  }
  .nav-dropdown-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .dropdown-arrow {
    font-size: 0.65rem;
    transition: transform 0.2s;
  }
  .nav-dropdown-wrap.open .dropdown-arrow {
    transform: rotate(180deg);
  }
  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 180px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    list-style: none;
    z-index: 200;
    overflow: hidden;
  }
  .nav-dropdown-wrap.open .nav-dropdown {
    display: block;
  }
  .dropdown-link {
    display: block;
    padding: 0.65rem 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--text-mid);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    border-bottom: 1px solid var(--border);
  }
  .dropdown-link:last-child { border-bottom: none; }
  .dropdown-link:hover,
  .dropdown-link.active {
    background: var(--bg-sub);
    color: var(--orange);
  }

  /* ── ハンバーガー ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: 1.5px solid var(--border-mid);
    border-radius: 4px;
    cursor: pointer;
    padding: 7px;
    flex-shrink: 0;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.3s, opacity 0.3s;
    transform-origin: center;
  }
  .menu-open .nav-toggle span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-open .nav-toggle span:nth-child(2) { opacity: 0; }
  .menu-open .nav-toggle span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── モバイルメニュー ── */
  .mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }
  .mobile-menu ul { list-style: none; }

  .mobile-link {
    display: block;
    padding: 0.95rem 2rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-mid);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s, color 0.15s;
  }
  .mobile-link:hover,
  .mobile-link.active {
    background: var(--bg-sub);
    color: var(--orange);
  }
  .mobile-link--start {
    color: var(--orange, #c0392b);
    font-weight: 600;
  }
  .mobile-chapter-header {}
  .mobile-chapter-link {
    display: block;
    padding: 0.75rem 2rem;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    border-left: 3px solid transparent;
    border-bottom: 1px solid var(--border);
    background: var(--bg-sub, #f5f4f0);
    transition: background 0.15s;
  }
  .mobile-chapter-link:hover,
  .mobile-chapter-link.active { opacity: 0.85; }
  .mobile-link--sub {
    padding-left: 3rem;
    font-size: 0.82rem;
  }

  @media (max-width: 720px) {
    .nav-links  { display: none; }
    .nav-toggle { display: flex; }
    .mobile-menu { display: block; }
  }
  .menu-open .mobile-menu { max-height: 1200px; }

  @media (max-width: 480px) {
    .nav-inner { padding: 0 1.2rem; }
    .nav-logo  { font-size: 0.98rem; }
  }
</style>
