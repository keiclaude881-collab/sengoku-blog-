---
interface Props {
  category: "decide" | "lead" | "recover" | "strategy" | "change" | "books" | "movie" | "whatif" | "anime" | "novel" | "world" | "battle" | "leader";
}
const { category } = Astro.props;

const map: Record<string, { label: string; href: string }> = {
  decide:   { label: "決断できない時",       href: "/category/decide/" },
  lead:     { label: "チームがうまくいかない時", href: "/category/lead/" },
  recover:  { label: "逆境・失敗した時",     href: "/category/recover/" },
  strategy: { label: "戦略・方向性に迷った時", href: "/category/strategy/" },
  change:   { label: "自分を変えたい時",     href: "/category/change/" },
  books:    { label: "書籍レビュー",         href: "/category/books/" },
  movie:    { label: "映画の知恵",           href: "/category/movie/" },
  anime:    { label: "アニメの知恵",         href: "/category/anime/" },
  novel:    { label: "小説・物語",           href: "/category/novel/" },
};
const { label, href } = map[category] ?? { label: category, href: `/category/${category}/` };
---

<a href={href} class="category-badge" data-cat={category}>
  {label}
</a>

<style>
  .category-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 0.2em 0.75em;
    border-radius: 2px;
    color: var(--gold);
    background: transparent;
    border: 1px solid var(--gold-light);
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .category-badge:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: #fff;
  }
</style>
