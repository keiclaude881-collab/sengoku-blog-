---
interface Props {
  title:       string;
  description: string;
  lesson?:     string;
  slug:        string;
  ogImage?:    string;
  tags:        string[];
}

const { title, description, lesson, slug, ogImage, tags } = Astro.props;
---

<a href={`/blog/${slug}/`} class="movie-card">
  <div class="movie-thumb">
    {ogImage
      ? <img src={ogImage} alt="" loading="lazy" />
      : <div class="movie-thumb-placeholder"></div>
    }
    <div class="movie-overlay">
      <span class="play-btn" aria-hidden="true">▶</span>
    </div>
  </div>

  <div class="movie-info">
    {tags.length > 0 && (
      <div class="movie-tags" aria-hidden="true">
        {tags.slice(0, 3).map(t => <span class="movie-tag">{t}</span>)}
      </div>
    )}
    <h3 class="movie-title">{title}</h3>
    <p class="movie-desc">{description}</p>
    {lesson && <p class="movie-lesson">{lesson}</p>}
  </div>
</a>

<style>
  .movie-card {
    display: block;
    text-decoration: none;
    background: #13161d;
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .movie-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
  }

  .movie-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0d0f14;
  }
  .movie-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .movie-card:hover .movie-thumb img {
    transform: scale(1.05);
  }
  .movie-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1e28 0%, #0d0f14 100%);
  }

  .movie-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  .movie-card:hover .movie-overlay {
    opacity: 1;
  }

  .play-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    color: #0d0f14;
    font-size: 1.2rem;
    padding-left: 3px;
  }

  .movie-info {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .movie-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.6rem;
  }
  .movie-tag {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #e8b84b;
    background: rgba(232, 184, 75, 0.12);
    border: 1px solid rgba(232, 184, 75, 0.3);
    padding: 0.15em 0.55em;
    border-radius: 2px;
  }

  .movie-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #f0eee8;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .movie-desc {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #8a8f9e;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .movie-lesson {
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-left: 2px solid #e8b84b;
    font-family: var(--font-serif);
    font-size: 0.78rem;
    color: #b8b4a8;
    line-height: 1.6;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
