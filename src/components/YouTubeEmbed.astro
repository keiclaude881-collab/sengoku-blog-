---
interface Props {
  id:    string;
  title: string;
}
const { id, title } = Astro.props;
const src = `https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1`;
---

<figure class="yt-embed">
  <div class="yt-wrapper">
    <iframe
      src={src}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
  <figcaption class="yt-caption">公式予告編（YouTube）</figcaption>
</figure>

<style>
  .yt-embed {
    margin: 2rem 0;
  }

  .yt-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
  }

  .yt-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-caption {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink3);
    text-align: right;
  }
</style>
