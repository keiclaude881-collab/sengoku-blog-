---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { JOURNEYS } from "../../data/journeys.ts";

const allPosts = await getCollection("posts");
const posts = allPosts
  .filter(p => p.data.category === "money")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const journey = JOURNEYS.money;
const bySlug = new Map(posts.map(p => [p.id.replace(/\.mdx?$/, ""), p]));

const STEP_ICONS = ["💭", "🏦", "📈", "🎁"];
const stages = journey.stages.map((stage, i) => ({
  ...stage,
  icon: STEP_ICONS[i],
  posts: stage.slugs.map(s => bySlug.get(s)).filter((p): p is typeof posts[number] => Boolean(p)),
}));

const assigned = new Set(journey.stages.flatMap(s => s.slugs));
const rest = posts.filter(p => !assigned.has(p.id.replace(/\.mdx?$/, "")));

function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}
---

<BaseLayout
  title="投資・お金 | 偉人ラボ"
  description="歴史の偉人から学ぶ投資・資産形成・お金の哲学。新NISA・インデックス投資・節約を偉人の思想で解説します。"
>

<div class="cat-page">
  <div class="container">
    <div class="cat-header">
      <span class="cat-badge cat-badge--money">投資・お金</span>
      <h1 class="cat-title">投資・お金</h1>
      <p class="cat-desc">孫子・フランクリン・マルクス・アウレリウス——偉人の思想で「お金の本質」を学ぶ。</p>
      <p class="cat-count">{posts.length}件の記事</p>
    </div>

    <p class="journey-intro">{journey.intro}</p>

    <div class="journey">
      {stages.map((stage, i) => (
        <section class="stage">
          <div class="stage-rail">
            <span class="stage-num"><span class="stage-num-icon">{stage.icon}</span><span class="stage-num-digit">{stage.step}</span></span>
            {i < stages.length - 1 && <span class="stage-line" />}
          </div>
          <div class="stage-body">
            <span class="stage-step-label">STEP {stage.step}</span>
            <h2 class="stage-title">{stage.title}</h2>
            <p class="stage-lead">{stage.lead}</p>
            {stage.posts.length > 0 && (
              <ul class="card-grid">
                {stage.posts.map(p => (
                  <li class="fade-in">
                    <a href={`/blog/${p.id.replace(/\.mdx?$/, '')}/`} class="card-link">
                      <div class="card-img-wrap">
                        {p.data.ogImage
                          ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="card-img" />
                          : <div class="card-img-empty" />
                        }
                      </div>
                      <div class="card-body">
                        <h3 class="card-title">{p.data.title}</h3>
                        {p.data.description && <p class="card-desc">{p.data.description}</p>}
                        <div class="card-foot">
                          <time class="card-date">{fmt(p.data.date)}</time>
                          <span class="card-time">{p.data.readingTime}分で読める</span>
                        </div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      ))}
    </div>

    {rest.length > 0 && (
      <section class="stage stage--rest">
        <div class="stage-body">
          <h2 class="stage-title">そのほかの記事</h2>
          <ul class="card-grid">
            {rest.map(p => (
              <li class="fade-in">
                <a href={`/blog/${p.id.replace(/\.mdx?$/, '')}/`} class="card-link">
                  <div class="card-img-wrap">
                    {p.data.ogImage
                      ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="card-img" />
                      : <div class="card-img-empty" />
                    }
                  </div>
                  <div class="card-body">
                    <h3 class="card-title">{p.data.title}</h3>
                    {p.data.description && <p class="card-desc">{p.data.description}</p>}
                    <div class="card-foot">
                      <time class="card-date">{fmt(p.data.date)}</time>
                      <span class="card-time">{p.data.readingTime}分で読める</span>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {posts.length === 0 && <p class="empty">記事を準備中です。</p>}
  </div>
</div>

</BaseLayout>

<style>
.cat-page { padding: 52px 0 88px; }
.cat-header { margin-bottom: 1.6rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
.cat-badge {
  display: inline-flex;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
  margin-bottom: 1rem;
  border: 1px solid transparent;
}
.cat-badge--money { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.cat-title {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.02em;
  margin-bottom: 0.8rem;
}
.cat-desc {
  font-size: 0.95rem;
  line-height: 1.8;
  color: var(--ink2);
  max-width: 520px;
  margin-bottom: 0.8rem;
}
.cat-count { font-size: 0.78rem; color: var(--ink3); }

.journey-intro {
  font-size: 0.92rem;
  line-height: 1.9;
  color: var(--ink2);
  max-width: 640px;
  margin: 0 0 3rem;
}

.journey { display: flex; flex-direction: column; }
.stage { display: flex; gap: 24px; }
.stage-rail {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 64px;
}
.stage-num {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: linear-gradient(160deg, #fef3c7, #fff 85%);
  color: #92400e;
  border: 1.5px solid #fde68a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
  flex-shrink: 0;
  box-shadow: 0 8px 18px -8px rgba(146, 64, 14, 0.4);
}
.stage-num-icon { font-size: 1.5rem; line-height: 1; }
.stage-num-digit {
  font-family: var(--font-serif);
  font-weight: 800;
  font-size: 0.62rem;
  letter-spacing: 0.05em;
}
.stage-line {
  flex: 1;
  width: 2px;
  border-radius: 2px;
  background: linear-gradient(to bottom, #fde68a, var(--border));
  margin: 8px 0;
  min-height: 28px;
}
.stage-body { flex: 1; padding-bottom: 3.2rem; min-width: 0; }
.stage--rest .stage-body { padding-bottom: 0; }
.stage-step-label {
  display: block;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #92400e;
  margin-bottom: 0.3rem;
}
.stage-title {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 0.4rem;
}
.stage-lead {
  font-size: 0.85rem;
  line-height: 1.8;
  color: var(--ink3);
  margin-bottom: 1.6rem;
  max-width: 560px;
}

.card-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px 24px;
}
.card-link { display: block; text-decoration: none; color: inherit; }
.card-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
  margin-bottom: 1rem;
}
.card-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}
.card-link:hover .card-img { transform: scale(1.04); }
.card-img-empty { width: 100%; height: 100%; background: var(--bg3); }
.card-title {
  font-family: var(--font-serif);
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 0.5rem;
  transition: color 0.2s;
}
.card-link:hover .card-title { color: var(--ink2); }
.card-desc {
  font-size: 0.8rem;
  line-height: 1.75;
  color: var(--ink2);
  margin-bottom: 0.6rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-foot { display: flex; align-items: center; justify-content: space-between; }
.card-date { font-size: 0.7rem; color: var(--ink3); }
.card-time { font-size: 0.68rem; color: var(--ink3); }
.empty { text-align: center; color: var(--ink3); padding: 4rem 0; }
@media (max-width: 900px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) {
  .card-grid { grid-template-columns: 1fr; }
  .stage { gap: 14px; }
  .stage-rail { width: 48px; }
  .stage-num { width: 48px; height: 48px; }
  .stage-num-icon { font-size: 1.15rem; }
}
</style>
