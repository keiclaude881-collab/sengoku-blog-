---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const heroImages = allPosts.filter(p => p.data.ogImage).slice(0, 3);

function findPost(slug: string) {
  return allPosts.find(p => p.id.replace(/\.mdx?$/, "") === slug);
}

const heroCtaPost = findPost("sunzi-investment-principles") ?? allPosts[0];
const featuredPost = findPost("sunzi-investment-principles") ?? allPosts[0];

const figureQuotes = [
  {
    slug: "sunzi-investment-principles",
    name: "孫子",
    quote: "勝ちに行くより、負けない仕組みを作れ。それが最善の戦略だ。",
  },
  {
    slug: "marcus-aurelius-morning-rehearsal",
    name: "マルクス・アウレリウス",
    quote: "今日、嫌な人に出会うかもしれない。それでも揺れない自分でいられるか。",
  },
  {
    slug: "napoleon-focus-side-business",
    name: "ナポレオン",
    quote: "一点に絞れない者は、何も手に入れられない。",
  },
  {
    slug: "yoshida-shoin-remaining-time",
    name: "吉田松陰",
    quote: "残り時間を数えてから、今日何をするかを決めよ。",
  },
  {
    slug: "fukuzawa-independence-mindset",
    name: "福沢諭吉",
    quote: "砲声が轟く中でも、いつもの授業を続けた。それが独立自尊の意味だ。",
  },
].map((f, i) => ({ ...f, post: findPost(f.slug), delay: `${i * 0.12}s` }));
---

<BaseLayout
  title="偉人ラボ | 偉人の思考で現代のお金と仕事を攻略する"
  description="孫子・ナポレオン・マルクス・アウレリウス——偉人たちの思考法を、投資・副業・キャリアに応用する実践的ブログ。"
>

<!-- ═══ MASTHEAD ══════════════════════════════════════════ -->
<section class="masthead">
  <div class="masthead-inner">
    <div class="masthead-text">
      <p class="masthead-eyebrow">偉人ラボ</p>
      <h1 class="masthead-heading">賢者の答えは、<br/>もう2500年前に<br/>出ている。</h1>
      <p class="masthead-desc">情報があふれるほど、何を信じればいいか分からなくなる。だから、時代を超えて生き残った「本物の知恵」だけを、今日からできる1つの行動に翻訳しています。</p>
      <div class="masthead-cats">
        <a href="/money/"   class="cat-pill cat-pill--money">投資・お金</a>
        <a href="/career/"  class="cat-pill cat-pill--career">仕事・副業</a>
        <a href="/mindset/" class="cat-pill cat-pill--mindset">思考法</a>
      </div>
    </div>
    <div class="masthead-visual" aria-hidden="true">
      {heroImages.map((p, i) => (
        <div class={`mast-card mast-card--${i}`}>
          <img src={p.data.ogImage!} alt="" />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ FEATURED ═══════════════════════════════════════════ -->
{featuredPost && (
<section class="featured-section">
  <div class="featured-wrap">
    <p class="sec-eyebrow">今日の1記事</p>
    <a href={`/blog/${featuredPost.id.replace(/\.mdx?$/, '')}/`} class="featured-card">
      {featuredPost.data.ogImage && (
        <div class="featured-img-wrap">
          <img src={featuredPost.data.ogImage} alt="" class="featured-img" />
        </div>
      )}
      <div class="featured-body">
        <p class="featured-label">PICK UP</p>
        <h2 class="featured-title">{featuredPost.data.title}</h2>
        <p class="featured-desc">{featuredPost.data.description}</p>
        <span class="featured-cta">読む <span class="featured-arrow">→</span></span>
      </div>
    </a>
  </div>
</section>
)}

<!-- ═══ FIGURES ═══════════════════════════════════════════ -->
<section class="figures-section">
  <div class="figures-wrap">
    <p class="sec-eyebrow">偉人たちの言葉</p>
    <h2 class="figures-heading">答えは、すでに残されている</h2>
    <ul class="figure-list" id="figure-list">
      {figureQuotes.map((f, i) => f.post && (
        <li class="figure-item" style={`--delay:${f.delay}`}>
          <a href={`/blog/${f.post.id.replace(/\.mdx?$/, '')}/`} class="figure-link">
            <span class="figure-index">{String(i + 1).padStart(2, "0")}</span>
            <span class="figure-name">{f.name}</span>
            <q class="figure-quote">{f.quote}</q>
            <span class="figure-read">読む <span class="figure-arrow">→</span></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="figures-foot">
      <a href="/blog/" class="figures-all">すべての記事を読む →</a>
    </div>
  </div>
</section>

<!-- ═══ AUTHOR MINI PROFILE ═══════════════════════════════ -->
<section class="profile-section">
  <a href="/about/" class="profile-card">
    <img src="/images/profile-avatar.svg" alt="温故" class="profile-avatar" />
    <div class="profile-body">
      <p class="profile-role">この記事を書いた人</p>
      <p class="profile-name">温故（おんこ）<span class="profile-handle">| 偉人ラボ運営</span></p>
      <p class="profile-bio">
        歴史上の偉人や思想家の言葉を読み込み、「お金」「キャリア」「思考法」のヒントに翻訳して発信中。座右の銘は「温故知新」。
      </p>
      <span class="profile-link">プロフィールをもっと見る →</span>
    </div>
  </a>
</section>

<!-- ═══ FINAL CTA ══════════════════════════════════════════ -->
<section class="final-cta">
  <div class="final-cta-inner">
    <h2 class="final-cta-heading">今日、何か一つだけ試してみる。</h2>
    <p class="final-cta-desc">読んで終わりにせず、今日からできる1つの行動だけ持って帰ってください。</p>
    <div class="final-cta-actions">
      <a href="/blog/" class="final-cta-btn">記事一覧を見る →</a>
      <a href="/contact/" class="final-cta-ghost">お問い合わせ</a>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  // featured card: animate in on next frame (avoids headless opacity:0 flash)
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      document.querySelector<HTMLElement>('.featured-card')?.classList.add('is-visible');
    });
  });

  // figure list: stagger on scroll-into-view
  const list = document.getElementById('figure-list');
  if (list) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        list.classList.add('is-loaded');
        obs.unobserve(list);
      });
    }, { threshold: 0.08 });
    obs.observe(list);
  }
</script>

<style>
/* ── KEYFRAMES ── */
@keyframes float-0 {
  0%, 100% { transform: rotate(2deg) translateY(0); }
  50%       { transform: rotate(2deg) translateY(-14px); }
}
@keyframes float-1 {
  0%, 100% { transform: rotate(-2deg) translateY(0); }
  50%       { transform: rotate(-2deg) translateY(-18px); }
}
@keyframes float-2 {
  0%, 100% { transform: rotate(0.8deg) translateY(0); }
  50%       { transform: rotate(0.8deg) translateY(-10px); }
}
@keyframes ken-burns {
  from { transform: scale(1.06); }
  to   { transform: scale(1); }
}
@keyframes slide-up {
  from { opacity: 0; transform: translateY(36px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes line-grow {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}

/* ── MASTHEAD ── */
.masthead {
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--border);
  background-image: radial-gradient(circle, var(--border) 1.2px, transparent 1.2px);
  background-size: 22px 22px;
}
.masthead-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 3rem;
}
.masthead-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 1.2rem;
}
.masthead-heading {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 1.2rem;
  letter-spacing: -0.02em;
}
.masthead-desc {
  font-size: clamp(0.9rem, 1.6vw, 1.05rem);
  line-height: 1.85;
  color: var(--ink2);
  max-width: 520px;
  margin-bottom: 2rem;
}
.masthead-cats {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.masthead-visual {
  position: relative;
  height: 300px;
}
.mast-card {
  position: absolute;
  width: 250px;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 16px 48px rgba(28,25,23,0.14);
}
.mast-card img { width: 100%; display: block; }
.mast-card--0 { top: 10px; right: 0; z-index: 3; animation: float-0 4s ease-in-out infinite; }
.mast-card--1 { top: 55px; right: 56px; z-index: 2; animation: float-1 5.5s ease-in-out infinite; }
.mast-card--2 { top: 100px; right: 112px; z-index: 1; animation: float-2 7s ease-in-out infinite; }

.cat-pill {
  display: inline-flex;
  align-items: center;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 0.4rem 0.9rem;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.15s;
  border: 1px solid transparent;
}
.cat-pill:hover { opacity: 0.75; }
.cat-pill--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.cat-pill--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.cat-pill--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

/* ── EYEBROW (shared) ── */
.sec-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 0.8rem;
}

/* ── FEATURED ── */
.featured-section {
  padding: 64px 0 0;
  border-bottom: 1px solid var(--border);
  padding-bottom: 64px;
}
.featured-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.featured-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  opacity: 0;
  transform: translateY(36px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.featured-card.is-visible {
  opacity: 1;
  transform: translateY(0);
}
.featured-img-wrap {
  overflow: hidden;
  aspect-ratio: 16 / 9;
  background: var(--bg2);
}
.featured-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  animation: ken-burns 10s ease both;
  transition: transform 0.6s ease;
}
.featured-card:hover .featured-img { transform: scale(1.04); }
.featured-body {
  padding: 2.4rem 2.8rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1rem;
  background: var(--bg);
  border-left: 1px solid var(--border);
}
.featured-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--ink3);
}
.featured-title {
  font-family: var(--font-serif);
  font-size: clamp(1.05rem, 1.8vw, 1.4rem);
  font-weight: 700;
  line-height: 1.6;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.featured-desc {
  font-size: 0.84rem;
  line-height: 1.8;
  color: var(--ink2);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.featured-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--ink);
  margin-top: 0.4rem;
}
.featured-arrow {
  display: inline-block;
  transition: transform 0.2s ease;
}
.featured-card:hover .featured-arrow { transform: translateX(5px); }

/* ── FIGURES ── */
.figures-section { padding: 64px 0 0; }
.figures-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.figures-heading {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 2.8rem;
  letter-spacing: -0.02em;
}

.figure-list {
  list-style: none;
  border-top: 1px solid var(--border);
}
.figure-item {
  border-bottom: 1px solid var(--border);
  opacity: 0;
  transform: translateY(24px);
}
.figure-list.is-loaded .figure-item {
  animation: slide-up 0.55s ease both;
  animation-delay: var(--delay);
}

.figure-link {
  display: grid;
  grid-template-columns: 2.4rem 14rem 1fr auto;
  align-items: center;
  gap: 1.6rem;
  padding: 1.5rem 0.4rem;
  text-decoration: none;
  color: inherit;
  position: relative;
  transition: background 0.15s;
}
.figure-link::before {
  content: '';
  position: absolute;
  left: -2rem;
  top: 0; bottom: 0;
  width: 3px;
  background: var(--ink);
  transform: scaleY(0);
  transform-origin: top;
  transition: transform 0.2s ease;
}
.figure-link:hover::before { transform: scaleY(1); }
.figure-link:hover { background: var(--bg2); margin: 0 -2rem; padding-left: 2rem; padding-right: 2rem; }

.figure-index {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--ink3);
  transition: color 0.15s;
}
.figure-link:hover .figure-index { color: var(--ink); }

.figure-name {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.35;
}

.figure-quote {
  font-family: var(--font-serif);
  font-size: 0.9rem;
  font-style: italic;
  line-height: 1.7;
  color: var(--ink2);
  quotes: none;
  position: relative;
}
.figure-quote::after {
  content: '';
  position: absolute;
  left: 0; bottom: -3px;
  height: 1px;
  width: 100%;
  background: var(--ink3);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s ease;
  transition-delay: calc(var(--delay, 0s) + 0.35s);
}
.figure-list.is-loaded .figure-quote::after { transform: scaleX(1); }

.figure-read {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}
.figure-arrow {
  display: inline-block;
  transition: transform 0.2s ease;
}
.figure-link:hover .figure-arrow { transform: translateX(5px); }

.figures-foot {
  padding: 2rem 0 2.4rem;
  border-top: 1px solid var(--border);
  margin-top: 0;
}
.figures-all {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--ink2);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
  transition: color 0.15s;
}
.figures-all:hover { color: var(--ink); }

/* ── AUTHOR PROFILE ── */
.profile-section { padding: 0 0 56px; }
.profile-card {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 1.6rem 2rem;
  display: flex;
  gap: 1.4rem;
  align-items: flex-start;
  text-decoration: none;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.profile-avatar { flex-shrink: 0; width: 64px; height: 64px; border-radius: 50%; display: block; }
.profile-body { min-width: 0; }
.profile-role {
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink3);
  margin: 0 0 0.4rem;
}
.profile-name { font-family: var(--font-serif); font-size: 1rem; font-weight: 700; color: var(--ink); margin: 0 0 0.6rem; }
.profile-handle { font-size: 0.74rem; font-weight: 500; color: var(--ink3); margin-left: 0.4rem; }
.profile-bio { font-size: 0.8rem; line-height: 1.8; color: var(--ink2); margin: 0 0 0.8rem; max-width: 560px; }
.profile-link { font-size: 0.78rem; font-weight: 600; color: var(--ink); }

/* ── FINAL CTA ── */
.final-cta { padding: 0 0 88px; }
.final-cta-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 2rem; text-align: center; }
.final-cta-heading {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 0.8rem;
}
.final-cta-desc { font-size: 0.9rem; color: var(--ink2); margin-bottom: 1.6rem; }
.final-cta-actions { display: flex; justify-content: center; align-items: center; gap: 1rem; flex-wrap: wrap; }
.final-cta-btn {
  display: inline-flex;
  align-items: center;
  padding: 0.8rem 1.8rem;
  background: var(--ink);
  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.15s;
}
.final-cta-btn:hover { opacity: 0.8; }
.final-cta-ghost {
  font-size: 0.84rem;
  color: var(--ink3);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
  transition: color 0.15s;
}
.final-cta-ghost:hover { color: var(--ink2); }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .figure-link { grid-template-columns: 2rem 1fr; grid-template-rows: auto auto; gap: 0.5rem 1rem; }
  .figure-name { font-size: 1.1rem; }
  .figure-quote { display: none; }
  .figure-read { grid-column: 2; }
}
@media (max-width: 768px) {
  .masthead-inner { grid-template-columns: 1fr; }
  .masthead-visual { position: relative; height: auto; margin-top: 1.5rem; }
  .mast-card { position: relative; width: 100%; animation: none !important; transform: none !important; box-shadow: 0 8px 24px rgba(28,25,23,0.12); }
  .mast-card--1, .mast-card--2 { display: none; }
  .featured-card { grid-template-columns: 1fr; }
  .featured-body { border-left: none; border-top: 1px solid var(--border); padding: 1.6rem; }
  .profile-card { flex-direction: column; align-items: center; text-align: center; }
}
@media (max-width: 640px) {
  .masthead { padding: 40px 0; }
  .featured-section, .figures-section { padding-top: 48px; }
  .figure-link::before { left: -1rem; }
  .figure-link:hover { margin: 0 -1rem; padding-left: 1rem; padding-right: 1rem; }
}
@media (max-width: 480px) {
  .masthead-inner, .featured-wrap, .figures-wrap, .final-cta-inner { padding-left: 1rem; padding-right: 1rem; }
}
</style>
