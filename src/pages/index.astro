---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import BookCard from "../components/BookCard.astro";
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";

// ④ decideカテゴリから直近3件
const allDecide = (await Promise.all([
  getCollection("battle"),
  getCollection("leader"),
  getCollection("strategy"),
  getCollection("whatif"),
  getCollection("world"),
].map(p => p.catch(() => [])))).flat()
  .filter(p => p.data.category === "decide")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, "")}`;
}

// ⑥ 書籍3冊
const books = [
  { title: "孫子の兵法（知的生きかた文庫）", asin: "4837900186", reason: "情報戦の原典。競合分析の基礎が凝縮されている" },
  { title: "五輪書（宮本武蔵）", asin: "4003300211", reason: "個の強さとは何か。武蔵の戦略哲学を学ぶ" },
  { title: "失敗の本質", asin: "4122018331", reason: "なぜ日本軍は負けたのか。組織論の古典" },
];

const AUDIBLE_URL = "https://af.moshimo.com/af/c/click?a_id=5427522&p_id=170&pc_id=185&pl_id=4062&url=https%3A%2F%2Fwww.amazon.co.jp%2Fftu%2Fhome";
---

<BaseLayout
  title="決断の系譜 | 決断できない夜、あなたは一人じゃない。"
  description="月曜日の悩みに、戦国武将が答える。500年前の武将たちが、意外なほどリアルな答えを持っている。"
>

  <!-- ① Hero -->
  <section class="hero">
    <canvas class="lightning-canvas" id="lightning-canvas" aria-hidden="true"></canvas>
    <div class="hero-flash" id="hero-flash" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="hero-sub">月曜日の悩みに、戦国武将が答える。</p>
      <h1 class="hero-title" id="hero-title">決断できない夜、<br>あなたは一人じゃない。</h1>
      <div class="hero-cta-wrap">
        <a href="/blog/" class="hero-cta">記事を読む →</a>
        <a href="/timeline/" class="hero-ghost">戦いの年表を見る</a>
      </div>
    </div>
  </section>

  <!-- ② 共感ブロック -->
  <section class="empathy">
    <div class="container">
      <h2 class="empathy-heading">こんな状況、ありませんか？</h2>
      <ul class="empathy-list">
        <li>部下に何を言っても伝わらない</li>
        <li>決断しなければいけないのに、正解が見えない</li>
        <li>頑張っているのに、結果が出ない</li>
      </ul>
    </div>
  </section>

  <!-- ③ このブログの答え -->
  <section class="answer">
    <div class="container">
      <p class="answer-text">
        500年前の武将たちが、<br class="br-sp">意外なほどリアルな答えを持っている。
      </p>
    </div>
  </section>

  <!-- ④ 注目記事3本 -->
  {allDecide.length > 0 && (
    <section class="articles">
      <div class="container">
        <h2 class="section-heading">注目記事</h2>
        <ul class="article-grid" role="list">
          {allDecide.map(post => (
            <li>
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                category={post.data.category}
                tags={post.data.tags}
                readingTime={post.data.readingTime}
                lesson={post.data.lesson}
                slug={slug(post.collection, post.id)}
                ogImage={post.data.ogImage}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ⑤ Audibleバナー -->
  <section class="audible">
    <div class="container audible-inner">
      <p class="audible-text">通勤中に戦略書を聴く。</p>
      <a
        href={AUDIBLE_URL}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="audible-cta"
      >
        30日間無料体験 →
      </a>
    </div>
  </section>

  <!-- ⑥ おすすめ書籍 -->
  <section class="books">
    <div class="container">
      <h2 class="section-heading">あわせて読みたい</h2>
      <AffiliateDisclosure />
      <div class="book-grid">
        {books.map(b => (
          <BookCard title={b.title} asin={b.asin} reason={b.reason} />
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const canvas = document.getElementById('lightning-canvas') as HTMLCanvasElement | null;
  const flash  = document.getElementById('hero-flash') as HTMLElement | null;
  const title  = document.getElementById('hero-title') as HTMLElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');

    function resize() {
      const hero = canvas!.parentElement!;
      canvas!.width  = hero.offsetWidth;
      canvas!.height = hero.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    function drawBolt(x1: number, y1: number, x2: number, y2: number, depth: number) {
      if (!ctx) return;
      if (depth === 0) {
        ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); return;
      }
      const dx = x2 - x1, dy = y2 - y1;
      const len = Math.sqrt(dx * dx + dy * dy);
      const midX = (x1 + x2) / 2 + (Math.random() - 0.5) * len * 0.45;
      const midY = (y1 + y2) / 2 + (Math.random() - 0.25) * Math.abs(dy) * 0.3;
      drawBolt(x1, y1, midX, midY, depth - 1);
      drawBolt(midX, midY, x2, y2, depth - 1);
      if (depth > 2 && Math.random() > 0.55) {
        const bx = midX + (Math.random() - 0.35) * dx * 0.6;
        const by = midY + Math.random() * dy * 0.5;
        ctx.globalAlpha = 0.45;
        drawBolt(midX, midY, bx, by, depth - 2);
        ctx.globalAlpha = 1;
      }
    }

    function strike() {
      if (!ctx || !canvas) return;
      const W = canvas.width, H = canvas.height;
      const startX = W * (0.42 + Math.random() * 0.5);
      const startY = H * (0.04 + Math.random() * 0.12);
      const endX   = startX + (Math.random() - 0.5) * W * 0.25;
      const endY   = H * (0.45 + Math.random() * 0.35);

      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = 'rgba(210, 235, 255, 0.92)';
      ctx.lineWidth   = 1.2;
      ctx.shadowColor = 'rgba(150, 210, 255, 1)';
      ctx.shadowBlur  = 14;
      ctx.globalAlpha = 1;
      drawBolt(startX, startY, endX, endY, 7);

      if (flash) {
        flash.style.transition = 'none'; flash.style.opacity = '0.18';
        setTimeout(() => { if (flash) { flash.style.transition = 'opacity 0.25s'; flash.style.opacity = '0'; } }, 120);
        setTimeout(() => { if (flash) { flash.style.transition = 'none'; flash.style.opacity = '0.08'; } }, 250);
        setTimeout(() => { if (flash) { flash.style.transition = 'opacity 0.4s'; flash.style.opacity = '0'; } }, 350);
      }
      if (title) {
        title.classList.add('title-flash');
        setTimeout(() => title?.classList.remove('title-flash'), 600);
      }
      setTimeout(() => {
        if (!ctx || !canvas) return;
        let alpha = 1;
        const fade = setInterval(() => {
          alpha -= 0.08;
          if (alpha <= 0) { clearInterval(fade); ctx.clearRect(0, 0, canvas.width, canvas.height); return; }
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.globalAlpha = alpha;
          drawBolt(startX, startY, endX, endY, 7);
          ctx.globalAlpha = 1;
        }, 30);
      }, 300);
    }

    function scheduleNext() {
      setTimeout(() => { strike(); scheduleNext(); }, 5000 + Math.random() * 10000);
    }
    setTimeout(() => { strike(); scheduleNext(); }, 2000);
  }
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    background:
      linear-gradient(to right, rgba(5,12,5,0.82) 0%, rgba(5,12,5,0.55) 55%, rgba(5,12,5,0.25) 100%),
      url('/images/header-bg.jpg') center center / cover no-repeat;
    min-height: 92svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .lightning-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-flash {
    position: absolute;
    inset: 0;
    background: rgba(200, 230, 255, 1);
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: overlay;
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    max-width: 640px;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 4rem) 1.5rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    width: 100%;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    color: var(--gold-light);
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 7vw, 4rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-shadow: 0 0 40px rgba(59,140,110,0.15), 0 0 80px rgba(59,140,110,0.05);
    transition: text-shadow 0.2s;
  }
  .hero-title.title-flash {
    text-shadow:
      0 0 20px rgba(200,230,255,0.7),
      0 0 50px rgba(200,230,255,0.4),
      0 0 100px rgba(200,230,255,0.15);
  }

  .hero-cta-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.4rem;
    background: var(--gold);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .hero-cta:hover {
    background: var(--gold-dark);
    transform: translateY(-2px);
  }

  .hero-ghost {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2rem;
    background: transparent;
    color: rgba(255,255,255,0.85);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255,255,255,0.45);
    border-radius: 2px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .hero-ghost:hover {
    border-color: var(--gold-light);
    color: var(--gold-light);
  }

  /* ── 共感ブロック ── */
  .empathy {
    background: var(--bg2);
    padding: 5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .empathy-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 2.4rem;
    letter-spacing: 0.04em;
  }

  .empathy-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .empathy-list li {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: var(--ink2);
    line-height: 1.7;
    padding-left: 1.5rem;
    position: relative;
  }
  .empathy-list li::before {
    content: "・";
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 1.2em;
    line-height: 1.4;
  }

  /* ── このブログの答え ── */
  .answer {
    background: var(--accent);
    padding: 5rem 0;
  }

  .answer-text {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.8;
    letter-spacing: 0.04em;
    text-align: center;
  }

  /* ── 注目記事 ── */
  .articles {
    background: var(--bg);
    padding: 5rem 0;
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.08em;
    margin-bottom: 2.4rem;
    padding-bottom: 0.8rem;
    border-bottom: 2px solid var(--gold);
    display: inline-block;
  }

  .article-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .articles-more {
    margin-top: 2.4rem;
    text-align: center;
  }

  .more-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .more-link:hover { color: var(--gold-dark); }

  /* ── Audibleバナー ── */
  .audible {
    background: var(--ink);
    padding: 3.5rem 0;
  }

  .audible-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .audible-text {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
  }

  .audible-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 2rem;
    background: var(--gold);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    border-radius: 2px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, transform 0.2s;
    flex-shrink: 0;
  }
  .audible-cta:hover {
    background: var(--gold-dark);
    transform: translateY(-1px);
  }

  /* ── 書籍 ── */
  .books {
    background: var(--bg2);
    padding: 5rem 0;
    border-top: 1px solid var(--rule);
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  /* ── container ── */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── レスポンシブ ── */
  @media (max-width: 768px) {
    .hero-inner { padding: 3rem 1.5rem 4rem; }
    .article-grid { grid-template-columns: 1fr; }
    .book-grid { grid-template-columns: 1fr; gap: 1rem; }
    .audible-inner { flex-direction: column; align-items: flex-start; }
    .answer-text { text-align: left; }
  }

  @media (max-width: 480px) {
    .empathy { padding: 3.5rem 0; }
    .answer  { padding: 3.5rem 0; }
    .articles { padding: 3.5rem 0; }
    .books  { padding: 3.5rem 0; }
    .br-sp  { display: block; }
  }
  @media (min-width: 481px) {
    .br-sp { display: none; }
  }
</style>
