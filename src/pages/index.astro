---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { THEME_INFO, THEME_ORDER } from "../utils/arcMap";

const ALL_COLLECTIONS = ["whatif","philosophy"] as const;
const allPosts = (await Promise.all(
  ALL_COLLECTIONS.map(c => getCollection(c).catch(() => []))
)).flat().sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentPosts = allPosts.slice(0, 6);
const whatifPosts = (await getCollection("whatif").catch(() => []))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const philosophyPosts = (await getCollection("philosophy").catch(() => []))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, "")}`;
}
function formatDate(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}

const themes = THEME_ORDER.map(s => ({ slug: s, ...THEME_INFO[s] }));

const INSTAGRAM_URL = "https://www.instagram.com/ijin_lab/";
const SUBSTACK_URL  = "https://ijin-lab.substack.com/";
const AUDIBLE_URL   = "https://www.amazon.co.jp/b/ref=adbl_JP_as_0068?ie=UTF8&node=7471076051&tag=sengokublog20-22";

---

<BaseLayout
  title="偉人ラボ | 歴史の偉人が現代の問題を解決する"
  description="信長・ナポレオン・孫子・龍馬——歴史の偉人たちが現代のあなたの悩みに答える。仕事・人間関係・決断・逆境——時代を超えた知恵をあなたへ。"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "偉人ラボ",
    "url": Astro.site?.toString() ?? "https://sengoku-blog.vercel.app/",
    "description": "歴史の偉人が現代の問題を解決するメディア",
    "inLanguage": "ja",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${(Astro.site?.toString() ?? "https://sengoku-blog.vercel.app").replace(/\/$/, "")}/search/?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- HERO -->
  <section class="hero lab-grid">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow"><span class="hero-eyebrow-dot">◉</span> IJIN LAB — RESEARCH STATION</p>
        <h1 class="hero-title">
          歴史の偉人が、<br />
          <span class="hero-accent">あなたの悩みを解決する。</span>
        </h1>
        <p class="hero-desc">
          信長・ナポレオン・シーザー・孫子・龍馬——<br />
          彼らが現代にいたら、今日のあなたの問題をこう解決する。
        </p>
        <div class="hero-actions">
          <a href="/category/decide/" class="hero-btn hero-btn--primary">悩みで読む</a>
          <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="hero-btn hero-btn--outline">📩 ニュースレター登録</a>
        </div>
      </div>

    </div>
  </section>

  <!-- INTRO -->
  <section class="intro">
    <div class="container intro-inner">
      <p class="intro-q">「コロナのパンデミックを、織田信長ならどう乗り越えた？」</p>
      <p class="intro-q">「転職を迷う夜に、坂本龍馬はこう考えた。」</p>
      <p class="intro-q">「プレゼンが苦手な人へ——ナポレオンの話し方を盗む。」</p>
      <p class="intro-body">
        偉人ラボは、歴史の偉人たちの思考・戦略・決断を現代語に翻訳するメディアです。<br />
        Instagram <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="intro-link">@ijin_lab</a> では短動画で、このブログでは深掘り記事で届けます。
      </p>
    </div>
  </section>

  <!-- 悩みカテゴリ -->
  <section class="section themes-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="lab-label">RESEARCH FIELD</p>
          <h2 class="section-title">悩みで探す</h2>
        </div>
        <p class="section-sub">今の気持ちに合う偉人の知恵を</p>
      </div>
      <div class="themes-grid">
        {themes.map(t => (
          <a href={`/category/${t.slug}/`} class="theme-card">
            <span class="theme-icon">{t.icon}</span>
            <div>
              <p class="theme-label">{t.label}</p>
              <p class="theme-tagline">{t.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- もしも歴史 -->
  {whatifPosts.length > 0 && (
    <section class="section whatif-section lab-dots">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="lab-label">EXPERIMENT LOG</p>
            <h2 class="section-title">もしも歴史</h2>
          </div>
          <a href="/blog/" class="section-more">すべて見る →</a>
        </div>
        <div class="whatif-grid">
          {whatifPosts.map((post, i) => (
            <a href={`/blog/${slug(post.collection, post.id)}/`} class="whatif-card">
              {post.data.ogImage && (
                <div class="whatif-img-wrap">
                  <img src={post.data.ogImage} alt={post.data.title} loading="lazy" />
                </div>
              )}
              <div class="whatif-body">
                <p class="whatif-case">CASE #{String(i + 1).padStart(3, '0')}</p>
                <p class="whatif-title">{post.data.title}</p>
                {post.data.lesson && <p class="whatif-lesson">{post.data.lesson}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 哲学コーナー -->
  {philosophyPosts.length > 0 && (
    <section class="section philosophy-section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="lab-label">PHILOSOPHY LAB</p>
            <h2 class="section-title phil-title">哲学の知恵</h2>
          </div>
          <a href="/philosophy/" class="section-more phil-more">すべて見る →</a>
        </div>
        <p class="phil-hook">ニーチェ・カント・ハイデガー——2500年前の問いが、今日のあなたへの答えだ。</p>
        <div class="phil-grid">
          {philosophyPosts.map(post => (
            <a href={`/blog/${slug(post.collection, post.id)}/`} class="phil-card">
              {post.data.ogImage && (
                <div class="phil-img-wrap">
                  <img src={post.data.ogImage} alt={post.data.title} loading="lazy" />
                </div>
              )}
              <div class="phil-body">
                <p class="phil-date">{formatDate(post.data.date)}</p>
                <p class="phil-card-title">{post.data.title}</p>
                {post.data.lesson && <p class="phil-lesson">{post.data.lesson}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 最新記事 -->
  <section class="section recent-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="lab-label">LATEST CASES</p>
          <h2 class="section-title">最新記事</h2>
        </div>
        <a href="/blog/" class="section-more">すべて見る →</a>
      </div>
      <div class="recent-grid">
        {recentPosts.map(post => (
          <a href={`/blog/${slug(post.collection, post.id)}/`} class="recent-card">
            {post.data.ogImage && (
              <div class="recent-img-wrap">
                <img src={post.data.ogImage} alt={post.data.title} loading="lazy" />
              </div>
            )}
            <div class="recent-body">
              <span class="recent-cat">{post.collection}</span>
              <p class="recent-title">{post.data.title}</p>
              <p class="recent-date">{formatDate(post.data.date)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- チャンネルCTA -->
  <section class="channels-section">
    <div class="container channels-grid">

      <div class="ch-card">
        <p class="ch-icon">📸</p>
        <p class="ch-label">INSTAGRAM</p>
        <p class="ch-title">60秒で偉人の知恵</p>
        <p class="ch-desc">リールで毎日「偉人×現代問題」を配信。スキマ時間に見返せる。</p>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="ch-btn ch-btn--amber">
          @ijin_lab をフォロー
        </a>
      </div>

      <div class="ch-card ch-card--mid">
        <p class="ch-icon">📩</p>
        <p class="ch-label">NEWSLETTER</p>
        <p class="ch-title">週1回、深掘りを届ける</p>
        <p class="ch-desc">Substackで無料配信。偉人1人の思考をじっくり読める。</p>
        <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="ch-btn ch-btn--outline">
          無料で購読する
        </a>
      </div>

      <div class="ch-card">
        <p class="ch-icon">🎧</p>
        <p class="ch-label">AUDIBLE</p>
        <p class="ch-title">通勤中に歴史書を</p>
        <p class="ch-desc">偉人の著作・歴史書が耳で読める。30日間無料で体験できる。</p>
        <a href={AUDIBLE_URL} target="_blank" rel="noopener noreferrer" class="ch-btn ch-btn--amber">
          30日間無料で試す
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    padding: calc(var(--nav-height) + 4rem) 0 5rem;
    background: linear-gradient(160deg, #faf9ff 0%, #f0ebff 60%, #faf9ff 100%);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 680px;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    color: var(--violet);
    margin-bottom: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.5em;
    opacity: 0.8;
  }
  .hero-eyebrow-dot {
    color: var(--amber);
    font-size: 0.55rem;
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: var(--ink);
    line-height: 1.35;
    letter-spacing: 0.02em;
    margin-bottom: 1.2rem;
  }
  .hero-accent { color: var(--violet); }
  .hero-desc {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.9;
    color: var(--ink2);
    margin-bottom: 2rem;
  }
  .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.5rem;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .hero-btn--primary { background: var(--violet); color: #fff; }
  .hero-btn--primary:hover { background: var(--violet-dark); }
  .hero-btn--outline { border: 1.5px solid var(--violet); color: var(--violet); }
  .hero-btn--outline:hover { background: var(--violet-light); }

  .intro { padding: 2.8rem 0; background: var(--bg2); border-bottom: 1px solid var(--border); }
  .intro-inner { max-width: 680px; }
  .intro-q {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.7;
    padding-left: 1rem;
    border-left: 3px solid var(--violet);
    margin-bottom: 0.8rem;
  }
  .intro-body { margin-top: 1.5rem; font-family: var(--font-sans); font-size: 0.87rem; line-height: 1.9; color: var(--ink2); }
  .intro-link { color: var(--violet); font-weight: 600; }

  .section { padding: 4rem 0; }
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .section-title { font-family: var(--font-serif); font-size: clamp(1.25rem, 2.5vw, 1.6rem); font-weight: 700; color: var(--ink); }
  .section-sub   { font-family: var(--font-sans); font-size: 0.78rem; color: var(--ink3); }
  .section-more  { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; color: var(--violet); text-decoration: none; }
  .section-more:hover { opacity: 0.7; }

  .themes-section { background: #fff; }
  .themes-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; }
  .theme-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .theme-card:hover { border-color: var(--violet); box-shadow: 0 4px 16px rgba(124,58,237,0.08); transform: translateY(-2px); }
  .theme-icon { font-family: var(--font-serif); font-size: 1.7rem; font-weight: 800; color: var(--violet); flex-shrink: 0; width: 2rem; text-align: center; }
  .theme-label { font-family: var(--font-serif); font-size: 0.92rem; font-weight: 700; color: var(--ink); margin-bottom: 0.2rem; }
  .theme-tagline { font-family: var(--font-sans); font-size: 0.7rem; color: var(--ink3); line-height: 1.5; }

  .whatif-section { background: var(--bg2); }
  .whatif-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.2rem; }
  .whatif-card {
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
    text-decoration: none; transition: box-shadow 0.15s, transform 0.15s;
  }
  .whatif-card:hover { box-shadow: 0 6px 24px rgba(124,58,237,0.1); transform: translateY(-2px); border-color: rgba(124,58,237,0.2); }
  .whatif-img-wrap { aspect-ratio: 16/9; overflow: hidden; background: var(--bg2); }
  .whatif-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .whatif-card:hover .whatif-img-wrap img { transform: scale(1.04); }
  .whatif-body { padding: 1rem 1.1rem; }
  .whatif-case {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    color: var(--amber);
    margin-bottom: 0.4rem;
    opacity: 0.9;
  }
  .whatif-title { font-family: var(--font-serif); font-size: 0.92rem; font-weight: 700; color: var(--ink); line-height: 1.5; margin-bottom: 0.4rem; }
  .whatif-lesson { font-family: var(--font-sans); font-size: 0.73rem; color: var(--ink3); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .recent-section { background: #fff; }
  .recent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .recent-card {
    display: flex; gap: 0.9rem; align-items: flex-start; padding: 0.9rem;
    border: 1px solid var(--border); border-radius: 10px; text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .recent-card:hover { border-color: var(--violet); box-shadow: 0 4px 14px rgba(124,58,237,0.06); }
  .recent-img-wrap { width: 68px; height: 68px; flex-shrink: 0; border-radius: 6px; overflow: hidden; background: var(--bg2); }
  .recent-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .recent-cat { display: inline-block; font-family: var(--font-sans); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--violet); margin-bottom: 0.25rem; }
  .recent-title { font-family: var(--font-serif); font-size: 0.88rem; font-weight: 700; color: var(--ink); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .recent-date  { font-family: var(--font-sans); font-size: 0.68rem; color: var(--ink3); margin-top: 0.35rem; }

  /* ── Philosophy ── */
  .philosophy-section {
    background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 60%, #1e1b4b 100%);
  }
  .philosophy-section .section-header {
    border-bottom-color: rgba(255,255,255,0.1);
  }
  .phil-title { color: #fff; }
  .phil-more { color: var(--gold); }
  .phil-more:hover { color: var(--amber); opacity: 1; }
  .philosophy-section .lab-label { color: rgba(255,255,255,0.4); }
  .phil-hook {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    color: rgba(255,255,255,0.55);
    border-left: 2px solid var(--gold);
    padding-left: 1rem;
    margin-bottom: 2rem;
    line-height: 1.7;
  }
  .phil-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.2rem;
  }
  .phil-card {
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
  }
  .phil-card:hover {
    background: rgba(255,255,255,0.09);
    border-color: rgba(255,255,255,0.25);
    transform: translateY(-2px);
  }
  .phil-img-wrap { aspect-ratio: 16/9; overflow: hidden; background: rgba(0,0,0,0.3); }
  .phil-img-wrap img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; transition: transform 0.3s, opacity 0.3s; }
  .phil-card:hover .phil-img-wrap img { transform: scale(1.04); opacity: 1; }
  .phil-body { padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .phil-date { font-family: var(--font-sans); font-size: 0.62rem; color: rgba(255,255,255,0.35); }
  .phil-card-title { font-family: var(--font-serif); font-size: 0.92rem; font-weight: 700; color: #fff; line-height: 1.5; }
  .phil-lesson { font-family: var(--font-sans); font-size: 0.72rem; color: rgba(255,255,255,0.5); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* ── Channels ── */
  .channels-section {
    background: linear-gradient(135deg, #4C1D95 0%, #1e1b4b 100%);
    padding: 3.5rem 0;
  }
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .ch-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 1.8rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ch-card--mid {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.2);
  }
  .ch-icon { font-size: 1.6rem; margin-bottom: 0.3rem; }
  .ch-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: rgba(255,255,255,0.4);
  }
  .ch-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
  }
  .ch-desc {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
    flex: 1;
  }
  .ch-btn {
    display: inline-block;
    margin-top: 0.8rem;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    transition: all 0.15s;
  }
  .ch-btn--amber { background: var(--amber); color: #fff; }
  .ch-btn--amber:hover { background: var(--amber-dark); }
  .ch-btn--outline { border: 1.5px solid rgba(255,255,255,0.4); color: #fff; }
  .ch-btn--outline:hover { border-color: #fff; background: rgba(255,255,255,0.08); }

  @media (max-width: 768px) {
    .channels-grid { grid-template-columns: 1fr; }
  }
</style>
