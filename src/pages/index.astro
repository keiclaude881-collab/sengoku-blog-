---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ArticleFeatured from "../components/ArticleFeatured.astro";
import ArticleCard from "../components/ArticleCard.astro";
import BookCard from "../components/BookCard.astro";
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";

const allArticles = (await Promise.all([
  getCollection("battle"),
  getCollection("leader"),
  getCollection("strategy").catch(() => []),
  getCollection("books").catch(() => []),
  getCollection("movie").catch(() => []),
  getCollection("whatif").catch(() => []),
  getCollection("anime").catch(() => []),
  getCollection("business").catch(() => []),
  getCollection("sports").catch(() => []),
  getCollection("novel").catch(() => []),
])).flat().sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = allArticles.find(a => a.data.featured) ?? allArticles[0];
const recent   = allArticles.filter(a => a.id !== featured?.id).slice(0, 3);
const sliderArticles = allArticles.slice(0, 10);

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, '')}`;
}

const featuredBooks = [
  { title: "孫子の兵法（知的生きかた文庫）", asin: "4837900186", reason: "情報戦の原典。競合分析の基礎が凝縮されている" },
  { title: "五輪書（宮本武蔵）岩波文庫", asin: "4003300211", reason: "個の強さとは何か。武蔵の戦略哲学を学ぶ" },
  { title: "戦略の本質", asin: "4532194628", reason: "日本の合戦を経営戦略の視点で再解釈した名著" },
  { title: "失敗の本質", asin: "4122018331", reason: "なぜ日本軍は負けたのか。組織論の古典" },
];

const marqueeItems = [
  "関ヶ原の決断",
  "孫子の兵法",
  "信長のイノベーション",
  "家康の忍耐戦略",
  "桶狭間の奇襲",
  "武田信玄の人事",
  "五輪書の哲学",
  "ナポレオンの速戦",
  "戦略的情報収集",
  "謀攻篇の現代応用",
];
---

<BaseLayout
  title="決断の系譜 | 迷ったとき、偉人の知恵がそっと寄り添う。"
  description="仕事・育児・人間関係に疲れたとき、歴史の武将・偉人・物語の主人公たちの決断が、今日を生きるヒントをくれる。"
>
  <!-- ヒーロー -->
  <Hero />

  <!-- マーキー帯 -->
  <div class="marquee-band" aria-hidden="true">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map(item => (
        <span class="marquee-item">
          <span class="marquee-dot">✦</span>
          {item}
        </span>
      ))}
    </div>
  </div>

  <!-- 記事スライダー -->
  {sliderArticles.length > 0 && (
    <section class="slider-section" aria-label="新着記事">
      <div class="slider-header container">
        <span class="slider-label">NEW ARTICLES</span>
        <a href="/blog/" class="slider-more">すべて見る →</a>
      </div>
      <div class="slider-viewport">
        <div class="slider-track" id="slider-track">
          {[...sliderArticles, ...sliderArticles].map((post, i) => (
            <a
              href={`/blog/${slug(post.collection, post.id)}/`}
              class="slider-card"
              aria-hidden={i >= sliderArticles.length ? "true" : undefined}
              tabindex={i >= sliderArticles.length ? -1 : undefined}
            >
              {post.data.ogImage ? (
                <div class="sc-img" style={`background-image: url('${post.data.ogImage}')`}></div>
              ) : (
                <div class="sc-img sc-img--empty"></div>
              )}
              <div class="sc-body">
                <span class="sc-cat">{post.data.category}</span>
                <p class="sc-title">{post.data.title}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- イントロバンド -->
  <section class="intro-band">
    <div class="container intro-inner">
      <span class="intro-label" aria-hidden="true">Philosophy</span>
      <blockquote class="intro-quote">
        <p class="quote-jp">「戦わずして人の兵を屈するは、善の善なる者なり。」</p>
        <p class="quote-en font-italic">— Sun Tzu, The Art of War</p>
      </blockquote>
    </div>
  </section>

  <!-- 注目記事 -->
  {allArticles.length > 0 && (
    <section class="section articles-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">注目記事</h2>
          <a href="/blog/" class="section-more">すべて見る →</a>
        </div>

        {featured && (
          <ArticleFeatured
            title={featured.data.title}
            description={featured.data.description}
            date={featured.data.date}
            category={featured.data.category}
            tags={featured.data.tags}
            readingTime={featured.data.readingTime}
            lesson={featured.data.lesson}
            slug={slug(featured.collection, featured.id)}
          />
        )}

        {recent.length > 0 && (
          <ul class="article-grid" role="list">
            {recent.map(post => (
              <li>
                <ArticleCard
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date}
                  category={post.data.category}
                  tags={post.data.tags}
                  readingTime={post.data.readingTime}
                  lesson={post.data.lesson}
                  slug={slug(post.collection, post.id)}
                  ogImage={post.data.ogImage}
                />
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  <!-- 映画コーナーバナー -->
  <section class="cinema-banner" aria-label="映画コーナー">
    <!-- フィルムストリップ（上） -->
    <div class="film-strip film-strip--top" aria-hidden="true">
      <div class="film-track">
        {Array.from({length: 20}).map(() => (
          <span class="film-hole"></span>
        ))}
      </div>
    </div>

    <!-- ポップコーン粒 -->
    <div class="popcorn-field" aria-hidden="true">
      {Array.from({length: 12}).map((_, i) => (
        <span class="popcorn" style={`--i:${i}`}>🍿</span>
      ))}
    </div>

    <!-- スポットライト -->
    <div class="spotlight" aria-hidden="true"></div>

    <div class="container cinema-inner">
      <div class="cinema-text">
        <span class="cinema-label">CINEMA &amp; STRATEGY</span>
        <h2 class="cinema-heading">映画で学ぶ、戦略の本質。</h2>
        <p class="cinema-body">七人の侍からスター・ウォーズまで。名作映画を戦略の視点で読み解く特設コーナー。</p>
      </div>
      <a href="/movies/" class="cinema-cta">映画コーナーへ →</a>
    </div>

    <!-- フィルムストリップ（下） -->
    <div class="film-strip film-strip--bottom" aria-hidden="true">
      <div class="film-track film-track--reverse">
        {Array.from({length: 20}).map(() => (
          <span class="film-hole"></span>
        ))}
      </div>
    </div>
  </section>

  <!-- フリップカード：気持ちから探す -->
  <section class="flip-section section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">今、どんな気持ちで来ましたか？</h2>
        <p class="flip-sub">カードをめくると、答えが見つかるかもしれない。</p>
      </div>
      <ul class="flip-grid" role="list">
        {[
          {
            tag: "意思決定",
            label: "決められなくて、疲れた",
            quote: "「迷いながらも、決める。それが将の仕事だ。」",
            author: "— 徳川家康",
            href: "/category/strategy/",
          },
          {
            tag: "リーダーシップ",
            label: "誰かを支えるのが、しんどい",
            quote: "「孤独でも前へ。それが大将の覚悟だ。」",
            author: "— 織田信長",
            href: "/category/leader/",
          },
          {
            tag: "ビジネス戦略",
            label: "仕事がうまくいかない",
            quote: "「彼を知り己を知れば、百戦殆うからず。」",
            author: "— 孫子",
            href: "/category/business/",
          },
          {
            tag: "人生の選択",
            label: "もっと自分らしく生きたい",
            quote: "「天下布武——自分の旗を立て、自分の道を切り開け。」",
            author: "— 織田信長",
            href: "/category/whatif/",
          },
        ].map(({ tag, label, quote, author, href }) => (
          <li>
            <div class="flip-card" tabindex="0">
              <div class="flip-inner">
                <!-- 表 -->
                <div class="flip-front">
                  <span class="flip-tag">#{tag}</span>
                  <h3 class="flip-label">{label}</h3>
                  <span class="flip-hint">めくる ↻</span>
                </div>
                <!-- 裏 -->
                <div class="flip-back">
                  <blockquote class="flip-quote">{quote}</blockquote>
                  <p class="flip-author">{author}</p>
                  <a href={href} class="flip-cta">記事を読む →</a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 書籍セクション -->
  <section class="books-section" aria-label="おすすめ書籍">
    <div class="container books-inner">
      <div class="section-header books-header">
        <h2 class="section-title books-title">戦略を深める、厳選の一冊。</h2>
        <a href="/books/" class="books-more">すべて見る →</a>
      </div>
      <p class="books-lead">記事を読んで「もっと深く知りたい」と思ったら、この本から始めよう。</p>
      <AffiliateDisclosure />
      <div class="book-grid">
        {featuredBooks.map(b => (
          <BookCard title={b.title} asin={b.asin} reason={b.reason} />
        ))}
      </div>
    </div>
  </section>

  <!-- Audibleバナー -->
  <section class="audible-banner">
    <div class="container banner-inner">
      <div class="banner-text">
        <span class="banner-tag audible-tag">Audible</span>
        <h3 class="banner-heading audible-heading">通勤中に戦略書を聴く。</h3>
        <p class="banner-body audible-body">孫子・五輪書・ビジネス書——移動時間が「戦略の学習時間」に変わる。30日間無料で体験できる。</p>
      </div>
      <a
        href="https://www.amazon.co.jp/audible?tag=sengokublog20-22"
        target="_blank"
        rel="nofollow sponsored noopener"
        class="banner-cta audible-cta"
      >
        30日間 無料体験 →
      </a>
    </div>
  </section>

  <!-- noteバナー -->
  <section class="note-banner">
    <div class="container banner-inner">
      <div class="banner-text">
        <span class="banner-tag note-tag">note</span>
        <h3 class="banner-heading note-heading">もっと深く知りたい人へ。</h3>
        <p class="banner-body note-body">ブログの一歩先へ。じっくり読みたい夜のための、深掘りコンテンツをnoteで。</p>
      </div>
      <a
        href="https://note.com/ketsudan_keifu"
        target="_blank"
        rel="noopener"
        class="banner-cta note-cta"
      >
        noteで購入する →
      </a>
    </div>
  </section>

</BaseLayout>

<!-- スティッキーCTAバー -->
<div class="sticky-cta" id="sticky-cta" aria-label="常設CTA">
  <div class="sticky-inner">
    <div class="sticky-items">
      <a href="/blog/" class="sticky-btn sticky-btn-primary">
        📖 記事を読む
      </a>
      <a
        href="https://www.amazon.co.jp/audible?tag=sengokublog20-22"
        target="_blank"
        rel="nofollow sponsored noopener"
        class="sticky-btn sticky-btn-secondary"
      >
        🎧 Audible 30日間無料
      </a>
    </div>
    <button class="sticky-close" id="sticky-close" aria-label="閉じる">✕</button>
  </div>
</div>

<script>
  // スティッキーCTA
  const stickyCta = document.getElementById('sticky-cta') as HTMLElement | null;
  const stickyClose = document.getElementById('sticky-close') as HTMLElement | null;
  let ctaClosed = false;

  if (stickyCta && stickyClose) {
    window.addEventListener('scroll', () => {
      if (ctaClosed) return;
      stickyCta.classList.toggle('visible', window.scrollY > 400);
    }, { passive: true });

    stickyClose.addEventListener('click', () => {
      ctaClosed = true;
      stickyCta.classList.remove('visible');
    });
  }
</script>

<style>
  /* ── マーキー ── */
  .marquee-band {
    background: var(--gold);
    padding: 0.7rem 0;
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee-track:hover { animation-play-state: paused; }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0 2rem;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #fff;
    white-space: nowrap;
  }
  .marquee-dot { font-size: 0.45rem; opacity: 0.7; }

  /* ── イントロバンド ── */
  .intro-band {
    background: var(--accent);
    padding: 5rem 0;
  }
  .intro-inner {
    display: flex;
    align-items: flex-start;
    gap: 3rem;
  }
  .intro-label {
    writing-mode: vertical-rl;
    font-family: var(--font-italic);
    font-size: 0.72rem;
    font-style: italic;
    letter-spacing: 0.2em;
    color: var(--gold);
    opacity: 0.7;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .quote-jp {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.5vw, 1.7rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.65;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }
  .quote-en {
    font-family: var(--font-italic);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--gold);
    letter-spacing: 0.05em;
  }

  /* ── 記事スライダー ── */
  .slider-section {
    padding: 2.5rem 0 0;
    overflow: hidden;
  }
  .slider-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .slider-label {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
  }
  .slider-more {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .slider-more:hover { color: var(--gold); }

  .slider-viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }
  .slider-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: slider-scroll 40s linear infinite;
    padding: 0 2rem 2rem;
  }
  .slider-track:hover { animation-play-state: paused; }
  @keyframes slider-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .slider-card {
    width: 240px;
    flex-shrink: 0;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .slider-card:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }
  .sc-img {
    width: 100%;
    height: 140px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    background-color: var(--bg2);
  }
  .sc-img--empty {
    background: linear-gradient(135deg, var(--accent) 0%, var(--gold-dark) 100%);
  }
  .sc-body {
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sc-cat {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--gold);
    text-transform: uppercase;
  }
  .sc-title {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .slider-card:hover .sc-title { color: var(--gold-dark); }

  /* ── 記事セクション ── */
  .articles-section { background: var(--bg); }

  /* ── フリップカード ── */
  .flip-section { background: var(--bg2); }
  /* ヘッダーを縦並びに上書き */
  .flip-section .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }
  .flip-sub {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink3);
  }
  .flip-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-top: 1.8rem;
  }
  /* カード外枠 */
  .flip-card {
    perspective: 900px;
    height: 240px;
    cursor: pointer;
    outline: none;
  }
  .flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .flip-card:hover .flip-inner,
  .flip-card:focus .flip-inner {
    transform: rotateY(180deg);
  }
  /* 表・裏共通 */
  .flip-front,
  .flip-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.4rem;
    overflow: hidden;
  }
  /* 表 */
  .flip-front {
    background: var(--bg);
    border: 1px solid var(--rule);
    justify-content: space-between;
  }
  .flip-tag {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--gold);
  }
  .flip-label {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.45;
    flex: 1;
    display: flex;
    align-items: center;
  }
  .flip-hint {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: var(--ink3);
    letter-spacing: 0.05em;
    text-align: right;
  }
  /* 裏 */
  .flip-back {
    background: var(--accent);
    border: 1px solid var(--gold-dark);
    transform: rotateY(180deg);
    justify-content: space-between;
  }
  .flip-quote {
    font-family: var(--font-serif);
    font-size: clamp(0.78rem, 1.5vw, 0.92rem);
    font-weight: 400;
    color: #fff;
    line-height: 1.7;
    border-left: 2px solid var(--gold);
    padding-left: 0.8rem;
    flex: 1;
    display: flex;
    align-items: center;
    margin: 0;
    overflow: hidden;
  }
  .flip-author {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--gold-light);
    letter-spacing: 0.08em;
    margin: 0.6rem 0;
  }
  .flip-cta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--gold);
    text-decoration: none;
    border: 1px solid rgba(59,140,110,0.4);
    border-radius: 2px;
    padding: 0.4rem 0.9rem;
    text-align: center;
    transition: background 0.2s, color 0.2s;
  }
  .flip-cta:hover {
    background: var(--gold);
    color: #fff;
  }

  /* ── 書籍セクション ── */
  .books-section {
    background: #2A5C43;   /* ミディアムグリーン（黒より明るめ） */
    padding: var(--sp-xl) 0;
  }
  .books-header { border-bottom-color: rgba(255,255,255,0.08); }
  .books-title { color: #fff; }
  .books-more { font-family: var(--font-sans); font-size: 0.82rem; color: var(--gold); transition: color 0.2s; }
  .books-more:hover { color: var(--gold-light); }
  .books-lead {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: rgba(255,255,255,0.75);
    margin-bottom: 0.5rem;
    line-height: 1.8;
  }
  .books-section :global(.affiliate-disclosure) {
    color: rgba(255,255,255,0.5);
    margin-bottom: 1.5rem;
  }
  .book-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-top: 1.5rem;
  }

  /* ── 映画コーナーバナー ── */
  .cinema-banner {
    background: #0d0f14;
    position: relative;
    overflow: hidden;
  }

  /* スポットライト */
  .spotlight {
    position: absolute;
    top: -20%;
    left: -10%;
    width: 50%;
    height: 200%;
