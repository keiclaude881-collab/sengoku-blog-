---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const LABELS: Record<string, string> = {
  money:   "投資・お金",
  career:  "仕事・副業",
  mindset: "思考法",
};

function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}

const heroImages = allPosts.filter(p => p.data.ogImage).slice(0, 3);

const CATS = [
  { key: "money",   label: "投資・お金", href: "/money/",   accent: "#fef3c7", color: "#92400e", border: "#fde68a" },
  { key: "career",  label: "仕事・副業", href: "/career/",  accent: "#dbeafe", color: "#1e40af", border: "#bfdbfe" },
  { key: "mindset", label: "思考法",     href: "/mindset/", accent: "#f3e8ff", color: "#6b21a8", border: "#e9d5ff" },
];
const catPosts = CATS.map(c => ({
  ...c,
  posts: allPosts.filter(p => p.data.category === c.key).slice(0, 3),
}));

function findPost(slug: string) {
  return allPosts.find(p => p.id.replace(/\.mdx?$/, "") === slug);
}
function catMeta(key: string) {
  return CATS.find(c => c.key === key)!;
}

const heroCtaPost = findPost("sunzi-investment-principles") ?? allPosts[0];

const painPoints = [
  {
    catKey: "money",
    icon: "💰",
    worry: "お金の不安がある",
    text: "新NISAを始めたけど、これで合ってるのか正直不安……",
    slug: "babylon-pay-yourself-first",
  },
  {
    catKey: "career",
    icon: "🧱",
    worry: "仕事に詰まっている",
    text: "頑張っているのに評価されない。今のままでいいのか分からない",
    slug: "kuroda-kanbei-win-without-fighting",
  },
  {
    catKey: "mindset",
    icon: "🦋",
    worry: "自分を変えたい",
    text: "今の自分のままでいいのか、それとも変わるべきなのか",
    slug: "hokusai-growth-no-limit",
  },
  {
    catKey: "mindset",
    icon: "😓",
    worry: "人間関係に疲れた",
    text: "気を遣いすぎて疲れる。距離感がいつもうまくいかない",
    slug: "dale-carnegie-workplace-relationships",
  },
  {
    catKey: "mindset",
    icon: "🌫️",
    worry: "将来が見えない",
    text: "このままで大丈夫なのか、誰にも答えを聞けない",
    slug: "yoshida-shoin-remaining-time",
  },
].map(p => ({ ...p, post: findPost(p.slug), cat: catMeta(p.catKey) }));

const startHereSlugs = [
  "sunzi-investment-principles",
  "stoicism-index-investing",
  "toyotomi-hideyoshi-career-strategy",
  "babylon-pay-yourself-first",
  "date-masamune-personal-branding",
];
const startHerePosts = startHereSlugs
  .map(slug => findPost(slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map(p => ({ post: p, cat: catMeta(p.data.category) }));
---

<BaseLayout
  title="偉人ラボ | 偉人の思考で現代のお金と仕事を攻略する"
  description="孫子・ナポレオン・マルクス・アウレリウス——偉人たちの思考法を、投資・副業・キャリアに応用する実践的ブログ。"
>

<!-- ═══ MASTHEAD ══════════════════════════════════════════ -->
<section class="masthead">
  <div class="masthead-inner">
    <div class="masthead-text">
      <p class="masthead-eyebrow">偉人ラボ</p>
      <h1 class="masthead-heading">賢者の答えは、<br/>もう2500年前に<br/>出ている。</h1>
      <p class="masthead-desc">情報があふれるほど、何を信じればいいか分からなくなる。だから、時代を超えて生き残った「本物の知恵」だけを、今日からできる1つの行動に翻訳しています。</p>
      <div class="masthead-cats">
        <a href="/money/"   class="cat-pill cat-pill--money">投資・お金</a>
        <a href="/career/"  class="cat-pill cat-pill--career">仕事・副業</a>
        <a href="/mindset/" class="cat-pill cat-pill--mindset">思考法</a>
      </div>
      {heroCtaPost && (
        <a href={`/blog/${heroCtaPost.id.replace(/\.mdx?$/, '')}/`} class="masthead-cta">
          まずこの1記事から読む <span class="cta-arrow">→</span>
        </a>
      )}
    </div>
    <div class="masthead-visual" aria-hidden="true">
      {heroImages.map((p, i) => (
        <div class={`mast-card mast-card--${i}`}>
          <img src={p.data.ogImage!} alt="" />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PAIN POINTS ═══════════════════════════════════════════ -->
<section class="pain-section">
  <div class="pain-wrap">
    <p class="pain-eyebrow">こんな悩み、ありませんか</p>
    <h2 class="pain-heading">今の自分に近いものを、選んでください。</h2>
    <div class="pain-grid">
      {painPoints.map(p => p.post && (
        <a href={`/blog/${p.post.id.replace(/\.mdx?$/, '')}/`} class="pain-card" style={`--c:${p.cat.color};--bg:${p.cat.accent};--bd:${p.cat.border};`}>
          <span class="pain-icon" aria-hidden="true">{p.icon}</span>
          <span class="pain-badge">{p.cat.label}</span>
          <p class="pain-worry">{p.worry}</p>
          <p class="pain-text">{p.text}</p>
          <span class="pain-link">答えを読む <span class="pain-link-arrow">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══ START HERE ═════════════════════════════════════════ -->
<section class="start-section">
  <div class="start-wrap">
    <div class="start-head">
      <p class="start-eyebrow">まずはここから</p>
      <h2 class="start-heading">最初に読むなら、この5記事</h2>
    </div>
    <div class="start-grid">
      {startHerePosts.map(({ post, cat }) => (
        <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}/`} class="start-card">
          {post.data.ogImage && <img src={post.data.ogImage} alt="" class="start-img" />}
          <div class="start-body">
            <span class="start-badge" style={`color:${cat.color};background:${cat.accent};border-color:${cat.border};`}>{cat.label}</span>
            <p class="start-title">{post.data.title}</p>
            <p class="start-desc">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CATEGORY BLOCKS ═════════════════════════════════════ -->
<section class="cat-section">
  <div class="cat-wrap">
    {catPosts.map(c => (
      <div class="cat-block" style={`background:${c.accent};border-color:${c.border};`}>
        <div class="cat-block-head">
          <span class="cat-block-label" style={`color:${c.color};`}>{c.label}</span>
          <a href={c.href} class="cat-block-more" style={`color:${c.color};`}>すべて見る →</a>
        </div>
        <ol class="cat-block-list">
          {c.posts.map(p => (
            <li>
              <a href={`/blog/${p.id.replace(/\.mdx?$/, '')}/`} class="cat-block-link" style={`--c:${c.color};`}>
                <span class="cat-block-title">{p.data.title}</span>
                <time class="cat-block-date">{fmt(p.data.date)}</time>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</section>

<!-- ═══ AUTHOR MINI PROFILE ═══════════════════════════════ -->
<section class="profile-section">
  <a href="/about/" class="profile-card">
    <img src="/images/profile-avatar.svg" alt="温故" class="profile-avatar" />
    <div class="profile-body">
      <p class="profile-role">この記事を書いた人</p>
      <p class="profile-name">温故（おんこ）<span class="profile-handle">| 偉人ラボ運営</span></p>
      <p class="profile-bio">
        歴史上の偉人や思想家の言葉を読み込み、「お金」「キャリア」「思考法」のヒントに翻訳して発信中。座右の銘は「温故知新」。
      </p>
      <span class="profile-link">プロフィールをもっと見る →</span>
    </div>
  </a>
</section>

<!-- ═══ FINAL CTA ══════════════════════════════════════════ -->
<section class="final-cta">
  <div class="final-cta-inner">
    <h2 class="final-cta-heading">今日、何か一つだけ試してみる。</h2>
    <p class="final-cta-desc">読んで終わりにせず、今日からできる1つの行動だけ持って帰ってください。</p>
    <div class="final-cta-actions">
      <a href="/blog/" class="final-cta-btn">記事一覧を見る →</a>
      <a href="/contact/" class="final-cta-ghost">お問い合わせ</a>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      el.classList.add('is-visible');
      observer.unobserve(el);
    });
  }, { threshold: 0.1 });

  document.querySelectorAll<HTMLElement>('.cat-block').forEach(el => observer.observe(el));
</script>

<style>
/* ── ANIMATIONS ── */
@keyframes float-0 {
  0%, 100% { transform: rotate(2deg) translateY(0); }
  50%       { transform: rotate(2deg) translateY(-14px); }
}
@keyframes float-1 {
  0%, 100% { transform: rotate(-2deg) translateY(0); }
  50%       { transform: rotate(-2deg) translateY(-18px); }
}
@keyframes float-2 {
  0%, 100% { transform: rotate(0.8deg) translateY(0); }
  50%       { transform: rotate(0.8deg) translateY(-10px); }
}
@keyframes ken-burns {
  from { transform: scale(1.06); }
  to   { transform: scale(1); }
}

/* ── MASTHEAD ── */
.masthead {
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--border);
  background-image: radial-gradient(circle, var(--border) 1.2px, transparent 1.2px);
  background-size: 22px 22px;
}
.masthead-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 3rem;
}
.masthead-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 1.2rem;
}
.masthead-heading {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 1.2rem;
  letter-spacing: -0.02em;
}
.masthead-desc {
  font-size: clamp(0.9rem, 1.6vw, 1.05rem);
  line-height: 1.85;
  color: var(--ink2);
  max-width: 520px;
  margin-bottom: 2rem;
}
.masthead-cats {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-bottom: 1.6rem;
}
.masthead-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.8rem 1.6rem;
  background: var(--ink);
  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.15s, gap 0.15s;
}
.masthead-cta:hover { opacity: 0.8; gap: 0.7rem; }
.masthead-cta .cta-arrow { transition: transform 0.15s; }

/* floating OGP collage */
.masthead-visual {
  position: relative;
  height: 300px;
}
.mast-card {
  position: absolute;
  width: 250px;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 16px 48px rgba(28,25,23,0.14);
}
.mast-card img { width: 100%; display: block; }
.mast-card--0 {
  top: 10px; right: 0; z-index: 3;
  animation: float-0 4s ease-in-out infinite;
}
.mast-card--1 {
  top: 55px; right: 56px; z-index: 2;
  animation: float-1 5.5s ease-in-out infinite;
}
.mast-card--2 {
  top: 100px; right: 112px; z-index: 1;
  animation: float-2 7s ease-in-out infinite;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 0.4rem 0.9rem;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.15s;
  border: 1px solid transparent;
}
.cat-pill:hover { opacity: 0.75; }
.cat-pill--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.cat-pill--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.cat-pill--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

/* ── CATEGORY BLOCKS ── */
.cat-section { padding: 56px 0 88px; }
.cat-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.cat-block {
  border: 1px solid;
  border-radius: var(--radius);
  padding: 1.6rem 1.5rem;
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.45s ease, transform 0.45s ease;
}
.cat-block.is-visible { opacity: 1; transform: translateY(0); }
.cat-block:nth-child(2) { transition-delay: 0.1s; }
.cat-block:nth-child(3) { transition-delay: 0.2s; }

.cat-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.2rem;
}
.cat-block-label {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}
.cat-block-more {
  font-size: 0.72rem;
  font-weight: 600;
  text-decoration: none;
  opacity: 0.75;
  transition: opacity 0.15s;
}
.cat-block-more:hover { opacity: 1; }

.cat-block-list {
  list-style: none;
  margin: 0; padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.cat-block-list li + li {
  border-top: 1px solid rgba(0,0,0,0.07);
}
.cat-block-link {
  display: block;
  text-decoration: none;
  padding: 0.75rem 0;
  transition: opacity 0.15s;
}
.cat-block-link:hover { opacity: 0.7; }
.cat-block-title {
  display: block;
  font-family: var(--font-serif);
  font-size: 0.86rem;
  font-weight: 700;
  line-height: 1.55;
  color: var(--ink);
  margin-bottom: 0.2rem;
}
.cat-block-date {
  font-size: 0.68rem;
  color: var(--ink3);
}

/* ── PAIN POINTS ── */
.pain-section { padding: 0 0 72px; }
.pain-wrap { max-width: var(--max-width); margin: 0 auto; padding: 0 2rem; }
.pain-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 0.6rem;
}
.pain-heading {
  font-family: var(--font-serif);
  font-size: clamp(1.2rem, 2.4vw, 1.5rem);
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 1.6rem;
}
.pain-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 18px;
}
.pain-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  padding: 1.8rem 1.6rem;
  background: var(--bg);
  border: 1.5px solid var(--bd);
  border-radius: calc(var(--radius) + 4px);
  text-decoration: none;
  overflow: hidden;
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.pain-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 100% 0%, rgba(255,255,255,0.55), transparent 60%);
  pointer-events: none;
}
.pain-card:hover {
  border-color: var(--c);
  transform: translateY(-5px) scale(1.015);
  box-shadow: 0 18px 34px -10px rgba(28, 25, 23, 0.22);
}
.pain-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  font-size: 1.7rem;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.65);
  border: 1px solid var(--bd);
  margin-bottom: 0.2rem;
  transition: transform 0.25s ease;
}
.pain-card:hover .pain-icon { transform: scale(1.12) rotate(-4deg); }
.pain-badge {
  display: inline-flex;
  align-self: flex-start;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
  background: rgba(255, 255, 255, 0.6);
  color: var(--c);
  border: 1px solid var(--bd);
}
.pain-worry {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  font-weight: 800;
  line-height: 1.45;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.pain-text {
  font-size: 0.82rem;
  line-height: 1.75;
  color: var(--ink2);
  flex: 1;
}
.pain-link {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--c);
}
.pain-link-arrow { display: inline-block; transition: transform 0.2s ease; }
.pain-card:hover .pain-link-arrow { transform: translateX(4px); }

/* ── START HERE ── */
.start-section { padding: 0 0 72px; }
.start-wrap { max-width: var(--max-width); margin: 0 auto; padding: 0 2rem; }
.start-head { margin-bottom: 1.6rem; }
.start-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 0.6rem;
}
.start-heading {
  font-family: var(--font-serif);
  font-size: clamp(1.3rem, 2.6vw, 1.7rem);
  font-weight: 700;
  color: var(--ink);
}
.start-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
}
.start-card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  text-decoration: none;
  transition: border-color 0.15s, transform 0.15s;
}
.start-card:hover { border-color: var(--border-mid); transform: translateY(-2px); }
.start-img { width: 100%; aspect-ratio: 1200 / 630; object-fit: cover; display: block; }
.start-body { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; }
.start-badge {
  align-self: flex-start;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 0.25rem 0.6rem;
  border-radius: 100px;
  border: 1px solid transparent;
}
.start-title {
  font-family: var(--font-serif);
  font-size: 0.84rem;
  font-weight: 700;
  line-height: 1.55;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.start-desc {
  font-size: 0.74rem;
  line-height: 1.7;
  color: var(--ink3);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── AUTHOR PROFILE ── */
.profile-section { padding: 0 0 56px; }
.profile-card {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 1.6rem 2rem;
  display: flex;
  gap: 1.4rem;
  align-items: flex-start;
  text-decoration: none;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.profile-avatar {
  flex-shrink: 0;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: block;
}
.profile-body { min-width: 0; }
.profile-role {
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink3);
  margin: 0 0 0.4rem;
}
.profile-name {
  font-family: var(--font-serif);
  font-size: 1rem;
  font-weight: 700;
  color: var(--ink);
  margin: 0 0 0.6rem;
}
.profile-handle {
  font-size: 0.74rem;
  font-weight: 500;
  color: var(--ink3);
  margin-left: 0.4rem;
}
.profile-bio {
  font-size: 0.8rem;
  line-height: 1.8;
  color: var(--ink2);
  margin: 0 0 0.8rem;
  max-width: 560px;
}
.profile-link {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--ink);
}

/* ── FINAL CTA ── */
.final-cta { padding: 0 0 88px; }
.final-cta-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}
.final-cta-heading {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 0.8rem;
}
