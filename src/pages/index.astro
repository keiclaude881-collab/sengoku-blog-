---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { THEME_INFO, THEME_ORDER } from "../utils/arcMap";

const ALL_COLLECTIONS = ["whatif","philosophy"] as const;
const allPosts = (await Promise.all(
  ALL_COLLECTIONS.map(c => getCollection(c).catch(() => []))
)).flat().sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentPosts = allPosts.slice(0, 6);
const whatifPosts = (await getCollection("whatif").catch(() => []))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const philosophyPosts = (await getCollection("philosophy").catch(() => []))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, "")}`;
}
function formatDate(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}

const themes = THEME_ORDER.map(s => ({ slug: s, ...THEME_INFO[s] }));

const GALLERY_FIGURES = [
  { name: "織田信長",      era: "戦国",        image: "https://upload.wikimedia.org/wikipedia/commons/3/36/Odanobunaga.jpg",                  href: "/blog/whatif/oda-nobunaga-tenka-if/" },
  { name: "徳川家康",      era: "戦国",        image: "https://upload.wikimedia.org/wikipedia/commons/2/20/Tokugawa_Ieyasu2_full.JPG",         href: "/blog/whatif/ieyasu-meigen/" },
  { name: "武田信玄",      era: "戦国",        image: "https://upload.wikimedia.org/wikipedia/commons/3/33/Takeda_Harunobu.jpg",               href: "/blog/whatif/shingen-longlife-if/" },
  { name: "坂本龍馬",      era: "幕末",        image: "https://upload.wikimedia.org/wikipedia/commons/8/84/Portrait_of_Sakamoto_Ryoma_by_Kunisawa_Shinkuro_%28Sakamoto_Ryoma_Memorial_Museum%29.jpg", href: "/blog/whatif/ryoma-longlife-if/" },
  { name: "ナポレオン",    era: "近世欧州",    image: "https://upload.wikimedia.org/wikipedia/commons/a/a9/Jean_Auguste_Dominique_Ingres%2C_Portrait_de_Napol%C3%A9on_Bonaparte_en_premier_consul%2C_Li%C3%A8ge%2C_BAL_%28d%C3%A9tail%29.jpg", href: "/blog/whatif/napoleon-russia-if/" },
  { name: "カエサル",      era: "古代ローマ",  image: "https://upload.wikimedia.org/wikipedia/commons/3/3a/Caesar_by_Rubens.jpg",               href: "/blog/whatif/caesar-last-day/" },
  { name: "エリザベス1世", era: "近世英国",    image: "https://upload.wikimedia.org/wikipedia/commons/7/7b/Elizabeth_I_(Armada_Portrait).jpg",  href: "/blog/whatif/elizabeth-decision/" },
  { name: "ニーチェ",      era: "哲学",        image: "https://upload.wikimedia.org/wikipedia/commons/1/1b/Nietzsche187a.jpg",                  href: "/blog/philosophy/nietzsche-meaning/" },
];

const INSTAGRAM_URL = "https://www.instagram.com/ijin_lab/";
const SUBSTACK_URL  = "https://ijin-lab.substack.com/";
const AUDIBLE_URL   = "https://www.amazon.co.jp/b/ref=adbl_JP_as_0068?ie=UTF8&node=7471076051&tag=sengokublog20-22";

---

<BaseLayout
  title="偉人ラボ | 歴史の偉人が現代の問題を解決する"
  description="信長・ナポレオン・孫子・龍馬——歴史の偉人たちが現代のあなたの悩みに答える。仕事・人間関係・決断・逆境——時代を超えた知恵をあなたへ。"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "偉人ラボ",
    "url": Astro.site?.toString() ?? "https://sengoku-blog.vercel.app/",
    "description": "歴史の偉人が現代の問題を解決するメディア",
    "inLanguage": "ja",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${(Astro.site?.toString() ?? "https://sengoku-blog.vercel.app").replace(/\/$/, "")}/search/?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow">IJIN LAB</p>
      <h1 class="hero-title">
        歴史の偉人が、<br />
        <em class="hero-em">あなたの悩みを</em><br />
        解決する。
      </h1>
      <p class="hero-sub">信長・ナポレオン・シーザー・孫子・龍馬</p>
    </div>
    <div class="hero-scroll">
      <span>scroll</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      <span>織田信長</span><span>·</span>
      <span>ナポレオン</span><span>·</span>
      <span>カエサル</span><span>·</span>
      <span>武田信玄</span><span>·</span>
      <span>クレオパトラ</span><span>·</span>
      <span>徳川家康</span><span>·</span>
      <span>ニーチェ</span><span>·</span>
      <span>坂本龍馬</span><span>·</span>
      <span>アレクサンドロス</span><span>·</span>
      <span>真田幸村</span><span>·</span>
      <span>マキャベリ</span><span>·</span>
      <span>エリザベス1世</span><span>·</span>
      <span>宮本武蔵</span><span>·</span>
      <span>孫子</span><span>·</span>
      <span>曹操</span><span>·</span>
      <!-- duplicate for seamless loop -->
      <span>織田信長</span><span>·</span>
      <span>ナポレオン</span><span>·</span>
      <span>カエサル</span><span>·</span>
      <span>武田信玄</span><span>·</span>
      <span>クレオパトラ</span><span>·</span>
      <span>徳川家康</span><span>·</span>
      <span>ニーチェ</span><span>·</span>
      <span>坂本龍馬</span><span>·</span>
      <span>アレクサンドロス</span><span>·</span>
      <span>真田幸村</span><span>·</span>
      <span>マキャベリ</span><span>·</span>
      <span>エリザベス1世</span><span>·</span>
      <span>宮本武蔵</span><span>·</span>
      <span>孫子</span><span>·</span>
      <span>曹操</span><span>·</span>
    </div>
  </div>

  <!-- 偉人ギャラリー -->
  <section class="section gallery-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="lab-label">FEATURED</p>
          <h2 class="section-title">注目の偉人</h2>
        </div>
        <p class="section-sub">厳選した8人の偉人から読む</p>
      </div>
      <div class="gallery-grid">
        {GALLERY_FIGURES.map(fig => (
          <a href={fig.href} class="gallery-card">
            <div class="gallery-img-wrap">
              <img src={fig.image} alt={fig.name} loading="lazy" />
              <div class="gallery-overlay">
                <span class="gallery-cta">記事を読む →</span>
              </div>
            </div>
            <p class="gallery-era">{fig.era}</p>
            <p class="gallery-name">{fig.name}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 今日の教訓 -->
  <section class="quote-section">
    <div class="container quote-inner">
      <p class="lab-label">TODAY'S LESSON</p>
      <blockquote class="quote-text" id="daily-quote">loading...</blockquote>
      <p class="quote-author" id="daily-author"></p>
      <button class="quote-refresh" id="quote-refresh" aria-label="別の教訓を見る">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
        別の教訓
      </button>
    </div>
    <script>
      const lessons = [
        { text: "改革のスピードと組織の消化速度は、セットで管理しなければならない", author: "織田信長の教訓" },
        { text: "城は壊せる。だが人の心が離れたら、取り戻すのは城より難しい。", author: "武田信玄の教訓" },
        { text: "勝てない戦いはある。でも負け方は選べる。", author: "真田幸村の教訓" },
        { text: "最速で遠くまで行ける人間と、長く走り続けられる人間は、違う走り方をしている。", author: "アレクサンドロス大王の教訓" },
        { text: "敵を部下にできる人間が、最強の組織を作る。", author: "曹操の教訓" },
        { text: "人は城、人は石垣、人は堀。情けは味方、仇は敵なり。", author: "武田信玄の言葉" },
        { text: "正しさは武器になる。だが正しさだけでは、人は動かない。", author: "上杉謙信の教訓" },
        { text: "リーダーの最終的な仕事は、自分が不要になる組織を作ることだ。", author: "偉人ラボの考察" },
        { text: "生き様は、結果より先に人の記憶に残る。", author: "真田幸村の教訓" },
        { text: "改革者が潰されても、改革の本質は残ることがある。", author: "偉人ラボの考察" },
      ];
      let current = Math.floor(Math.random() * lessons.length);
      const quoteEl = document.getElementById('daily-quote');
      const authorEl = document.getElementById('daily-author');

      function show(idx) {
        quoteEl.style.opacity = '0';
        authorEl.style.opacity = '0';
        setTimeout(() => {
          quoteEl.textContent = `「${lessons[idx].text}」`;
          authorEl.textContent = `— ${lessons[idx].author}`;
          quoteEl.style.opacity = '1';
          authorEl.style.opacity = '1';
        }, 400);
      }

      // initial
      quoteEl.textContent = `「${lessons[current].text}」`;
      authorEl.textContent = `— ${lessons[current].author}`;
      quoteEl.style.transition = 'opacity 0.4s ease';
      authorEl.style.transition = 'opacity 0.4s ease';

      // auto-rotate every 5s
      setInterval(() => {
        current = (current + 1) % lessons.length;
        show(current);
      }, 5000);

      // keep refresh button working
      const btn = document.getElementById('quote-refresh');
      if (btn) btn.addEventListener('click', () => {
        current = (current + 1) % lessons.length;
        show(current);
      });
    </script>
  </section>

  <!-- もしも歴史 -->
  {whatifPosts.length > 0 && (
    <section class="section whatif-section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="lab-label">EXPERIMENT LOG</p>
            <h2 class="section-title">もしも歴史</h2>
          </div>
          <a href="/blog/" class="section-more">すべて見る →</a>
        </div>
        <div class="whatif-grid">
          {whatifPosts.map((post, i) => (
            <a href={`/blog/${slug(post.collection, post.id)}/`} class="whatif-card">
              {post.data.ogImage && (
                <div class="whatif-img-wrap">
                  <img src={post.data.ogImage} alt={post.data.title} loading="lazy" />
                </div>
              )}
              <div class="whatif-body">
                <p class="whatif-case">CASE #{String(i + 1).padStart(3, '0')}</p>
                <p class="whatif-title">{post.data.title}</p>
                {post.data.lesson && <p class="whatif-lesson">{post.data.lesson}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 哲学コーナー -->
  {philosophyPosts.length > 0 && (
    <section class="section philosophy-section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="lab-label">PHILOSOPHY LAB</p>
            <h2 class="section-title phil-title">哲学の知恵</h2>
          </div>
          <a href="/philosophy/" class="section-more phil-more">すべて見る →</a>
        </div>
        <p class="phil-hook">ニーチェ・カント・ハイデガー——2500年前の問いが、今日のあなたへの答えだ。</p>
        <div class="phil-grid">
          {philosophyPosts.map(post => (
            <a href={`/blog/${slug(post.collection, post.id)}/`} class="phil-card">
              {post.data.ogImage && (
                <div class="phil-img-wrap">
                  <img src={post.data.ogImage} alt={post.data.title} loading="lazy" />
                </div>
              )}
              <div class="phil-body">
                <p class="phil-date">{formatDate(post.data.date)}</p>
                <p class="phil-card-title">{post.data.title}</p>
                {post.data.lesson && <p class="phil-lesson">{post.data.lesson}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 最新記事 -->
  <section class="section recent-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="lab-label">LATEST CASES</p>
          <h2 class="section-title">最新記事</h2>
        </div>
        <a href="/blog/" class="section-more">すべて見る →</a>
      </div>
      <div class="recent-grid">
        {recentPosts.map(post => (
          <a href={`/blog/${slug(post.collection, post.id)}/`} class="recent-card">
            {post.data.ogImage && (
              <div class="recent-img-wrap">
                <img src={post.data.ogImage} alt={post.data.title} loading="lazy" />
              </div>
            )}
            <div class="recent-body">
              <span class="recent-cat">{post.collection}</span>
              <p class="recent-title">{post.data.title}</p>
              <p class="recent-date">{formatDate(post.data.date)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- チャンネルCTA -->
  <section class="channels-section">
    <div class="container channels-grid">

      <div class="ch-card">
        <p class="ch-icon">📸</p>
        <p class="ch-label">INSTAGRAM</p>
        <p class="ch-title">60秒で偉人の知恵</p>
        <p class="ch-desc">リールで毎日「偉人×現代問題」を配信。スキマ時間に見返せる。</p>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="ch-btn ch-btn--amber">
          @ijin_lab をフォロー
        </a>
      </div>

      <div class="ch-card ch-card--mid">
        <p class="ch-icon">📩</p>
        <p class="ch-label">NEWSLETTER</p>
        <p class="ch-title">週1回、深掘りを届ける</p>
        <p class="ch-desc">Substackで無料配信。偉人1人の思考をじっくり読める。</p>
        <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="ch-btn ch-btn--outline">
          無料で購読する
        </a>
      </div>

      <div class="ch-card">
        <p class="ch-icon">🎧</p>
        <p class="ch-label">AUDIBLE</p>
        <p class="ch-title">通勤中に歴史書を</p>
        <p class="ch-desc">偉人の著作・歴史書が耳で読める。30日間無料で体験できる。</p>
        <a href={AUDIBLE_URL} target="_blank" rel="noopener noreferrer" class="ch-btn ch-btn--amber">
          30日間無料で試す
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: #000;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://upload.wikimedia.org/wikipedia/commons/9/97/Bishu_Okehazama-gassen.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.12;
    filter: grayscale(100%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    padding-top: var(--nav-height);
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    color: rgba(255,255,255,0.35);
    margin-bottom: 2rem;
    display: block;
  }
  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #fff;
    margin-bottom: 2rem;
  }
  .hero-em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,0.9);
    letter-spacing: -0.04em;
  }
  .hero-sub {
    font-family: var(--font-sans);
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.1em;
    font-weight: 300;
  }
  .hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.2);
    animation: bounce 2s ease-in-out infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  .section { padding: 4rem 0; }
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .section-title { font-family: var(--font-sans); font-size: clamp(1.25rem, 2.5vw, 1.6rem); font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
  .section-sub   { font-family: var(--font-sans); font-size: 0.78rem; color: var(--ink3); }
  .section-more  { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 500; color: var(--ink2); text-decoration: none; }
  .section-more:hover { color: var(--ink); }

  .marquee-wrap {
    background: #fff;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
    padding: 1rem 0;
  }
  .marquee-track {
    display: flex;
    gap: 2rem;
    width: max-content;
    animation: marquee 30s linear infinite;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink2);
    letter-spacing: 0.05em;
  }
  .marquee-track span:nth-child(even) {
    color: var(--ink3);
    font-size: 0.6rem;
    align-self: center;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .whatif-section { background: var(--bg2); }
  .whatif-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.2rem; }
  .whatif-card {
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
    text-decoration: none; transition: box-shadow 0.15s, transform 0.15s;
  }
  .whatif-card:hover { box-shadow: 0 6px 24px rgba(124,58,237,0.1); transform: translateY(-2px); border-color: rgba(124,58,237,0.2); }
  .whatif-img-wrap { aspect-ratio: 16/9; overflow: hidden; background: var(--bg2); }
  .whatif-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .whatif-card:hover .whatif-img-wrap img { transform: scale(1.04); }
  .whatif-body { padding: 1rem 1.1rem; }
  .whatif-case {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    color: var(--amber);
    margin-bottom: 0.4rem;
    opacity: 0.9;
  }
  .whatif-title { font-family: var(--font-serif); font-size: 0.92rem; font-weight: 700; color: var(--ink); line-height: 1.5; margin-bottom: 0.4rem; }
  .whatif-lesson { font-family: var(--font-sans); font-size: 0.73rem; color: var(--ink3); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .recent-section { background: #fff; }
  .recent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .recent-card {
    display: flex; gap: 0.9rem; align-items: flex-start; padding: 0.9rem;
    border: 1px solid var(--border); border-radius: 10px; text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .recent-card:hover { border-color: var(--violet); box-shadow: 0 4px 14px rgba(124,58,237,0.06); }
  .recent-img-wrap { width: 68px; height: 68px; flex-shrink: 0; border-radius: 6px; overflow: hidden; background: var(--bg2); }
  .recent-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .recent-cat { display: inline-block; font-family: var(--font-sans); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--violet); margin-bottom: 0.25rem; }
  .recent-title { font-family: var(--font-serif); font-size: 0.88rem; font-weight: 700; color: var(--ink); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .recent-date  { font-family: var(--font-sans); font-size: 0.68rem; color: var(--ink3); margin-top: 0.35rem; }

  /* ── Philosophy ── */
  .philosophy-section {
    background: #1d1d1f;
  }
  .philosophy-section .section-header {
    border-bottom-color: rgba(255,255,255,0.1);
