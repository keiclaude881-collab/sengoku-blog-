---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function findPost(slug: string) {
  return allPosts.find(p => p.id.replace(/\.mdx?$/, "") === slug);
}

const heroCtaPost = findPost("sunzi-investment-principles") ?? allPosts[0];
const featuredPost = findPost("sunzi-investment-principles") ?? allPosts[0];

const recentPosts = allPosts.slice(0, 6);
function catLabel(cat: string) {
  const m: Record<string, string> = { money: "投資・お金", career: "仕事・副業", mindset: "思考法" };
  return m[cat] ?? cat;
}

const figureQuotes = [
  {
    slug: "sunzi-investment-principles",
    name: "孫子",
    quote: "勝ちに行くより、負けない仕組みを作れ。それが最善の戦略だ。",
  },
  {
    slug: "marcus-aurelius-morning-rehearsal",
    name: "マルクス・アウレリウス",
    quote: "今日、嫌な人に出会うかもしれない。それでも揺れない自分でいられるか。",
  },
  {
    slug: "napoleon-focus-side-business",
    name: "ナポレオン",
    quote: "一点に絞れない者は、何も手に入れられない。",
  },
  {
    slug: "yoshida-shoin-remaining-time",
    name: "吉田松陰",
    quote: "残り時間を数えてから、今日何をするかを決めよ。",
  },
  {
    slug: "fukuzawa-independence-mindset",
    name: "福沢諭吉",
    quote: "砲声が轟く中でも、いつもの授業を続けた。それが独立自尊の意味だ。",
  },
].map((f, i) => ({ ...f, post: findPost(f.slug), delay: `${i * 0.12}s` }));
---

<BaseLayout
  title="偉人ラボ | 偉人の思考で現代のお金と仕事を攻略する"
  description="孫子・ナポレオン・マルクス・アウレリウス——偉人たちの思考法を、投資・副業・キャリアに応用する実践的ブログ。"
>

<!-- ═══ MASTHEAD ══════════════════════════════════════════ -->
<section class="masthead">
  <div class="masthead-inner">
    <div class="masthead-text">
      <p class="masthead-eyebrow">偉人ラボ</p>
      <h1 class="masthead-heading">賢者の答えは、<br/>もう2500年前に<br/>出ている。</h1>
      <p class="masthead-desc">情報があふれるほど、何を信じればいいか分からなくなる。だから、時代を超えて生き残った「本物の知恵」だけを、今日からできる1つの行動に翻訳しています。</p>
      <div class="masthead-cats">
        <a href="/money/"   class="cat-pill cat-pill--money">投資・お金</a>
        <a href="/career/"  class="cat-pill cat-pill--career">仕事・副業</a>
        <a href="/mindset/" class="cat-pill cat-pill--mindset">思考法</a>
      </div>
    </div>
    <div class="masthead-quote" aria-hidden="true">
      <p class="masthead-big-quote">「知恵は、<br/>時代を<br/>越える。」</p>
      <p class="masthead-quote-attr">— 2500年の問いから</p>
    </div>
  </div>
</section>

<!-- ═══ RECENT ════════════════════════════════════════════ -->
<section class="recent-section">
  <div class="recent-wrap">
    <p class="sec-eyebrow">新着記事</p>
    <ul class="recent-grid">
      {recentPosts.map(p => {
        const slug = p.id.replace(/\.mdx?$/, '');
        const cat = p.data.category as string;
        const dateStr = p.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'short', day: 'numeric' });
        return (
          <li>
            <a href={`/blog/${slug}/`} class="recent-card">
              <div class="recent-card-head">
                <span class={`recent-cat recent-cat--${cat}`}>{catLabel(cat)}</span>
                <time class="recent-date" datetime={p.data.date.toISOString()}>{dateStr}</time>
              </div>
              <h3 class="recent-title">{p.data.title}</h3>
              <p class="recent-desc">{p.data.description}</p>
              <span class="recent-cta">読む →</span>
            </a>
          </li>
        );
      })}
    </ul>
    <div class="recent-foot">
      <a href="/blog/" class="recent-all">すべての記事を見る →</a>
    </div>
  </div>
</section>

<!-- ═══ FEATURED ═══════════════════════════════════════════ -->
{featuredPost && (
<section class="featured-section">
  <div class="featured-wrap">
    <p class="sec-eyebrow">今日の1記事</p>
    <a href={`/blog/${featuredPost.id.replace(/\.mdx?$/, '')}/`} class="featured-card">
      <p class="featured-label">PICK UP</p>
      <h2 class="featured-title">{featuredPost.data.title}</h2>
      <p class="featured-desc">{featuredPost.data.description}</p>
      <span class="featured-cta">読む <span class="featured-arrow">→</span></span>
    </a>
  </div>
</section>
)}

<!-- ═══ FIGURES ═══════════════════════════════════════════ -->
<section class="figures-section">
  <div class="figures-wrap">
    <p class="sec-eyebrow">偉人たちの言葉</p>
    <h2 class="figures-heading">答えは、すでに残されている</h2>
    <ul class="figure-list" id="figure-list">
      {figureQuotes.map((f, i) => f.post && (
        <li class="figure-item" style={`--delay:${f.delay}`}>
          <a href={`/blog/${f.post.id.replace(/\.mdx?$/, '')}/`} class="figure-link">
            <span class="figure-index">{String(i + 1).padStart(2, "0")}</span>
            <span class="figure-name">{f.name}</span>
            <q class="figure-quote">{f.quote}</q>
            <span class="figure-read">読む <span class="figure-arrow">→</span></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="figures-foot">
      <a href="/blog/" class="figures-all">すべての記事を読む →</a>
    </div>
  </div>
</section>

<!-- ═══ FINAL CTA ══════════════════════════════════════════ -->
<section class="final-cta">
  <div class="final-cta-inner">
    <h2 class="final-cta-heading">今日、何か一つだけ試してみる。</h2>
    <p class="final-cta-desc">読んで終わりにせず、今日からできる1つの行動だけ持って帰ってください。</p>
    <div class="final-cta-actions">
      <a href="/blog/" class="final-cta-link">記事一覧を見る →</a>
      <a href="/contact/" class="final-cta-link final-cta-link--sub">お問い合わせ</a>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  // featured card: animate in on next frame (avoids headless opacity:0 flash)
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      document.querySelector<HTMLElement>('.featured-card')?.classList.add('is-visible');
    });
  });

  // figure list: stagger on scroll-into-view
  const list = document.getElementById('figure-list');
  if (list) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        list.classList.add('is-loaded');
        obs.unobserve(list);
      });
    }, { threshold: 0.08 });
    obs.observe(list);
  }
</script>

<style>
/* ── KEYFRAMES ── */
@keyframes ken-burns {
  from { transform: scale(1.06); }
  to   { transform: scale(1); }
}
@keyframes slide-up {
  from { opacity: 0; transform: translateY(36px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes line-grow {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}

/* ── MASTHEAD ── */
.masthead {
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--border);
}
.masthead-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 3rem;
}
.masthead-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 1.2rem;
}
.masthead-heading {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 1.2rem;
  letter-spacing: -0.02em;
}
.masthead-desc {
  font-size: clamp(0.9rem, 1.6vw, 1.05rem);
  line-height: 1.85;
  color: var(--ink2);
  max-width: 520px;
  margin-bottom: 2rem;
}
.masthead-cats {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.masthead-quote {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 3.5rem;
  border-left: 1px solid var(--border-mid);
}
.masthead-big-quote {
  font-family: var(--font-serif);
  font-size: clamp(2.4rem, 4.5vw, 4rem);
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink);
  letter-spacing: -0.03em;
  margin-bottom: 1.4rem;
}
.masthead-quote-attr {
  font-family: var(--font-serif);
  font-size: 0.85rem;
  font-style: italic;
  color: var(--ink3);
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 0.4rem 0.9rem;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.15s;
  border: 1px solid transparent;
}
.cat-pill:hover { opacity: 0.75; }
.cat-pill--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.cat-pill--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.cat-pill--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

/* ── EYEBROW (shared) ── */
.sec-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 0.8rem;
}

/* ── RECENT ── */
.recent-section {
  padding: 64px 0;
  border-bottom: 1px solid var(--border);
}
.recent-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.recent-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 1.6rem;
}
.recent-card {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  padding: 1.3rem;
  border: 1px solid var(--border);
  border-radius: 4px;
  text-decoration: none;
  color: inherit;
  height: 100%;
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.recent-card:hover {
  border-color: var(--ink3);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.07);
}
.recent-card-head {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.recent-cat {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 0.2rem 0.55rem;
  border-radius: 100px;
  border: 1px solid transparent;
  white-space: nowrap;
}
.recent-cat--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.recent-cat--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.recent-cat--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }
.recent-date {
  font-size: 0.68rem;
  color: var(--ink3);
  margin-left: auto;
  white-space: nowrap;
}
.recent-title {
  font-family: var(--font-serif);
  font-size: 0.93rem;
  font-weight: 700;
  line-height: 1.6;
  color: var(--ink);
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.recent-desc {
  font-size: 0.77rem;
  line-height: 1.75;
  color: var(--ink2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.recent-cta {
  font-size: 0.74rem;
  font-weight: 600;
  color: var(--ink3);
  margin-top: auto;
  transition: color 0.15s;
}
.recent-card:hover .recent-cta { color: var(--ink); }
.recent-foot { text-align: right; }
.recent-all {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--ink2);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
  transition: color 0.15s;
}
.recent-all:hover { color: var(--ink); }

/* ── FEATURED ── */
.featured-section {
  padding: 64px 0;
  border-bottom: 1px solid var(--border);
}
.featured-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.featured-card {
  display: block;
  max-width: 680px;
  text-decoration: none;
  color: inherit;
  border-left: 3px solid var(--ink);
  padding: 1.6rem 2rem;
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.featured-card.is-visible {
  opacity: 1;
  transform: translateY(0);
}
.featured-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--ink3);
  margin-bottom: 0.9rem;
}
.featured-title {
  font-family: var(--font-serif);
  font-size: clamp(1.15rem, 2vw, 1.55rem);
  font-weight: 700;
  line-height: 1.55;
  color: var(--ink);
  margin-bottom: 0.9rem;
  letter-spacing: -0.01em;
}
.featured-desc {
  font-size: 0.9rem;
  line-height: 1.85;
  color: var(--ink2);
  margin-bottom: 1.2rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.featured-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.84rem;
  font-weight: 700;
  color: var(--ink);
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
  transition: opacity 0.15s;
}
.featured-card:hover .featured-cta { opacity: 0.65; }
.featured-arrow {
  display: inline-block;
  transition: transform 0.2s ease;
}
.featured-card:hover .featured-arrow { transform: translateX(4px); }

/* ── FIGURES ── */
.figures-section { padding: 64px 0 0; }
.figures-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.figures-heading {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 2.8rem;
  letter-spacing: -0.02em;
}

.figure-list {
  list-style: none;
  border-top: 1px solid var(--border);
}
.figure-item {
  border-bottom: 1px solid var(--border);
  opacity: 0;
  transform: translateY(24px);
}
.figure-list.is-loaded .figure-item {
  animation: slide-up 0.55s ease both;
  animation-delay: var(--delay);
}

.figure-link {
  display: grid;
  grid-template-columns: 2.4rem 14rem 1fr auto;
  align-items: center;
  gap: 1.6rem;
  padding: 1.5rem 0.4rem;
  text-decoration: none;
  color: inherit;
  position: relative;
  transition: background 0.15s;
}
.figure-link::before {
  content: '';
  position: absolute;
  left: -2rem;
  top: 0; bottom: 0;
  width: 3px;
  background: var(--ink);
  transform: scaleY(0);
  transform-origin: top;
  transition: transform 0.2s ease;
}
.figure-link:hover::before { transform: scaleY(1); }
.figure-link:hover { background: var(--bg2); margin: 0 -2rem; padding-left: 2rem; padding-right: 2rem; }

.figure-index {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--ink3);
  transition: color 0.15s;
}
.figure-link:hover .figure-index { color: var(--ink); }

.figure-name {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.35;
}

.figure-quote {
  font-family: var(--font-serif);
  font-size: 0.9rem;
  font-style: italic;
  line-height: 1.7;
  color: var(--ink2);
  quotes: none;
  position: relative;
}
.figure-quote::after {
  content: '';
  position: absolute;
  left: 0; bottom: -3px;
  height: 1px;
  width: 100%;
  background: var(--ink3);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s ease;
  transition-delay: calc(var(--delay, 0s) + 0.35s);
}
.figure-list.is-loaded .figure-quote::after { transform: scaleX(1); }

.figure-read {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}
.figure-arrow {
  display: inline-block;
  transition: transform 0.2s ease;
}
.figure-link:hover .figure-arrow { transform: translateX(5px); }

.figures-foot {
  padding: 2rem 0 2.4rem;
  border-top: 1px solid var(--border);
  margin-top: 0;
}
.figures-all {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--ink2);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
  transition: color 0.15s;
}
.figures-all:hover { color: var(--ink); }

/* ── FINAL CTA ── */
.final-cta { padding: 0 0 88px; }
.final-cta-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 2rem; text-align: center; }
.final-cta-heading {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 0.8rem;
}
.final-cta-desc { font-size: 0.9rem; color: var(--ink2); margin-bottom: 1.6rem; }
.final-cta-actions { display: flex; justify-content: center; align-items: center; gap: 2rem; flex-wrap: wrap; }
.final-cta-link {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--ink);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 2px;
  transition: opacity 0.15s;
}
.final-cta-link:hover { opacity: 0.55; }
.final-cta-link--sub {
  font-weight: 400;
  color: var(--ink3);
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .figure-link { grid-template-columns: 2rem 1fr; grid-template-rows: auto auto; gap: 0.5rem 1rem; }
  .figure-name { font-size: 1.1rem; }
  .figure-quote { display: none; }
  .figure-read { grid-column: 2; }
  .recent-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .masthead-inner { grid-template-columns: 1fr; }
  .masthead-quote { display: none; }
  .featured-card { padding: 1.2rem 1.4rem; }
}
@media (max-width: 640px) {
  .masthead { padding: 40px 0; }
  .featured-section, .figures-section { padding-top: 48px; }
  .figure-link::before { left: -1rem; }
  .figure-link:hover { margin: 0 -1rem; padding-left: 1rem; padding-right: 1rem; }
  .recent-grid { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .masthead-inner, .featured-wrap, .figures-wrap, .final-cta-inner { padding-left: 1rem; padding-right: 1rem; }
  .recent-wrap { padding-left: 1rem; padding-right: 1rem; }
}
</style>
