---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

type Post = {
  id: string;
  col: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    ogImage?: string;
  };
};

const allPosts: Post[] = (await Promise.all([
  getCollection("whatif").then(posts => posts.map(p => ({ ...p, col: "whatif" }))).catch(() => []),
  getCollection("philosophy").then(posts => posts.map(p => ({ ...p, col: "philosophy" }))).catch(() => []),
])).flat().sort((a: Post, b: Post) => b.data.date.getTime() - a.data.date.getTime());

function href(col: string, id: string) {
  return `/blog/${col}/${id.replace(/\.mdx?$/, "")}/`;
}
function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}
function label(col: string) {
  return col === "whatif" ? "もしも歴史" : "哲学";
}

const FIRST = 12;
const featured = allPosts[0];
const rest     = allPosts.slice(1);
---

<BaseLayout
  title="偉人ラボ | 歴史の偉人が現代の問題を解決する"
  description="信長・ナポレオン・孫子・龍馬——歴史の偉人たちが現代のあなたの悩みに答える。仕事・人間関係・決断・逆境——時代を超えた知恵をあなたへ。"
>
  <main class="page">

    <!-- ─── Featured ─────────────────────────────── -->
    {featured && (
      <a class="featured" href={href(featured.col, featured.id)}>
        <div class="featured-img-wrap">
          {featured.data.ogImage
            ? <img src={featured.data.ogImage} alt={featured.data.title} loading="eager" />
            : <div class="img-placeholder" />
          }
        </div>
        <div class="featured-body">
          <span class="badge">{label(featured.col)}</span>
          <h2 class="featured-title">{featured.data.title}</h2>
          {featured.data.description && (
            <p class="featured-desc">{featured.data.description}</p>
          )}
          <time class="meta-date">{fmt(featured.data.date)}</time>
        </div>
      </a>
    )}

    <!-- ─── Grid ──────────────────────────────────── -->
    <div class="grid" id="grid">
      {rest.map((p, i) => (
        <a
          class="card"
          href={href(p.col, p.id)}
          data-index={i}
          style={i >= FIRST - 1 ? "display:none" : ""}
        >
          <div class="card-img-wrap">
            {p.data.ogImage
              ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" />
              : <div class="img-placeholder" />
            }
          </div>
          <div class="card-body">
            <div class="card-meta">
              <span class="badge">{label(p.col)}</span>
              <time class="meta-date">{fmt(p.data.date)}</time>
            </div>
            <h3 class="card-title">{p.data.title}</h3>
            {p.data.description && (
              <p class="card-desc">{p.data.description}</p>
            )}
          </div>
        </a>
      ))}
    </div>

    <!-- ─── Load more ─────────────────────────────── -->
    {rest.length >= FIRST && (
      <div class="more-wrap" id="more-wrap">
        <button class="more-btn" id="more-btn">もっと読む</button>
      </div>
    )}

  </main>
</BaseLayout>

<script>
  const btn  = document.getElementById("more-btn");
  const wrap = document.getElementById("more-wrap");
  if (btn) {
    btn.addEventListener("click", () => {
      const hidden = document.querySelectorAll<HTMLElement>(".card[style*='display:none']");
      hidden.forEach(el => {
        el.style.display = "";
        el.classList.add("reveal");
      });
      if (hidden.length === 0 || document.querySelectorAll(".card[style*='display:none']").length === 0) {
        wrap?.remove();
      }
    });
  }
</script>

<style>
/* ── Page shell ───────────────────────────────────── */
.page {
  max-width: 1120px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

/* ── Featured card ───────────────────────────────── */
.featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border: 1px solid #e5e5e5;
  border-radius: 16px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  margin-bottom: 40px;
  transition: box-shadow 0.25s ease;
}
.featured:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,.10);
}
.featured-img-wrap {
  aspect-ratio: 4/3;
  overflow: hidden;
  background: #f0f0f0;
}
.featured-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.4s ease;
}
.featured:hover .featured-img-wrap img {
  transform: scale(1.03);
}
.featured-body {
  padding: 40px 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
  background: #fff;
}
.featured-title {
  font-size: 1.55rem;
  font-weight: 700;
  line-height: 1.45;
  color: #1d1d1f;
  margin: 0;
  letter-spacing: -.01em;
}
.featured-desc {
  font-size: .9rem;
  line-height: 1.7;
  color: #6e6e73;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Grid ────────────────────────────────────────── */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

/* ── Card ────────────────────────────────────────── */
.card {
  display: flex;
  flex-direction: column;
  border: 1px solid #e5e5e5;
  border-radius: 14px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  background: #fff;
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}
.card:hover {
  box-shadow: 0 6px 24px rgba(0,0,0,.09);
  transform: translateY(-2px);
}
.card.reveal {
  animation: fadeUp 0.4s ease both;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

.card-img-wrap {
  aspect-ratio: 4/3;
  overflow: hidden;
  background: #f0f0f0;
  flex-shrink: 0;
}
.card-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.4s ease;
}
.card:hover .card-img-wrap img {
  transform: scale(1.04);
}
.img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
}

.card-body {
  padding: 18px 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}
.card-meta {
  display: flex;
  align-items: center;
  gap: 10px;
}
.card-title {
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.5;
  color: #1d1d1f;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-desc {
  font-size: .82rem;
  line-height: 1.65;
  color: #6e6e73;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Badge & date ────────────────────────────────── */
.badge {
  display: inline-block;
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: .04em;
  padding: 2px 8px;
  border-radius: 4px;
  background: #1d1d1f;
  color: #fff;
  white-space: nowrap;
  flex-shrink: 0;
}
.meta-date {
  font-size: .78rem;
  color: #86868b;
}

/* ── More button ─────────────────────────────────── */
.more-wrap {
  display: flex;
  justify-content: center;
  padding: 56px 0 0;
}
.more-btn {
  font-family: inherit;
  font-size: .9rem;
  font-weight: 500;
  color: #1d1d1f;
  background: transparent;
  border: 1px solid #1d1d1f;
  border-radius: 100px;
  padding: 12px 40px;
  cursor: pointer;
  letter-spacing: .04em;
  transition: background .2s, color .2s;
}
.more-btn:hover {
  background: #1d1d1f;
  color: #fff;
}

/* ── Responsive ──────────────────────────────────── */
@media (max-width: 900px) {
  .featured {
    grid-template-columns: 1fr;
  }
  .featured-img-wrap {
    aspect-ratio: 16/9;
  }
  .featured-body {
    padding: 28px 24px;
  }
  .featured-title {
    font-size: 1.25rem;
  }
  .grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
}

@media (max-width: 560px) {
  .page {
    padding: 24px 16px 60px;
  }
  .featured-title {
    font-size: 1.1rem;
  }
  .featured-body {
    padding: 22px 20px;
  }
  .grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
}
</style>
