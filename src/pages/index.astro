---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const LABELS: Record<string, string> = {
  money:   "投資・お金",
  career:  "仕事・副業",
  mindset: "思考法",
};

function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}

const featured = allPosts.find(p => p.data.featured) ?? allPosts[0];
const recent   = allPosts.filter(p => p.id !== featured.id).slice(0, 6);
---

<BaseLayout
  title="偉人ラボ | 偉人の思考で現代のお金と仕事を攻略する"
  description="孫子・ナポレオン・マルクス・アウレリウス——偉人たちの思考法を、投資・副業・キャリアに応用する実践的ブログ。"
>

<!-- ═══ MASTHEAD ══════════════════════════════════════════ -->
<section class="masthead">
  <div class="masthead-inner">
    <p class="masthead-eyebrow">偉人ラボ</p>
    <h1 class="masthead-heading">偉人の思考で、<br/>現代のお金と仕事を攻略する</h1>
    <p class="masthead-desc">孫子・ナポレオン・マルクス・アウレリウス——時代を超えた知恵を、投資・副業・キャリアに応用する。</p>
    <div class="masthead-cats">
      <a href="/money/"   class="cat-pill cat-pill--money">投資・お金</a>
      <a href="/career/"  class="cat-pill cat-pill--career">仕事・副業</a>
      <a href="/mindset/" class="cat-pill cat-pill--mindset">思考法</a>
    </div>
  </div>
</section>

<!-- ═══ FEATURED ══════════════════════════════════════════ -->
{featured && (
  <section class="featured">
    <div class="featured-inner">
      <a href={`/blog/${featured.id.replace(/\.mdx?$/, '')}/`} class="featured-card">
        <div class="featured-img-wrap">
          {featured.data.ogImage
            ? <img src={featured.data.ogImage} alt={featured.data.title} class="featured-img" />
            : <div class="featured-img-empty" />
          }
        </div>
        <div class="featured-body">
          <span class={`feat-cat feat-cat--${featured.data.category}`}>
            {LABELS[featured.data.category]}
          </span>
          <h2 class="feat-title">{featured.data.title}</h2>
          {featured.data.description && <p class="feat-desc">{featured.data.description}</p>}
          <div class="feat-foot">
            <time class="feat-date">{fmt(featured.data.date)}</time>
            <span class="feat-cta">読む <span class="feat-arrow">→</span></span>
          </div>
        </div>
      </a>
    </div>
  </section>
)}

<!-- ═══ RECENT GRID ════════════════════════════════════════ -->
{recent.length > 0 && (
  <section class="recent">
    <div class="section-wrap">
      <div class="section-header">
        <h2 class="section-title">新着記事</h2>
        <a href="/blog/" class="section-more">すべて見る →</a>
      </div>
      <ul class="card-grid">
        {recent.map(p => (
          <li class="fade-in">
            <a href={`/blog/${p.id.replace(/.mdx?$/, '')}/`} class="card-link">
              <div class="card-img-wrap">
                {p.data.ogImage
                  ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="card-img" />
                  : <div class="card-img-empty" />
                }
              </div>
              <div class="card-body">
                <span class={`card-cat card-cat--${p.data.category}`}>
                  {LABELS[p.data.category]}
                </span>
                <h3 class="card-title">{p.data.title}</h3>
                {p.data.description && <p class="card-desc">{p.data.description}</p>}
                <time class="card-date">{fmt(p.data.date)}</time>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

</BaseLayout>

<style>
/* ── MASTHEAD ── */
.masthead {
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--border);
}
.masthead-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.masthead-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 1.2rem;
}
.masthead-heading {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 1.2rem;
  letter-spacing: -0.02em;
}
.masthead-desc {
  font-size: clamp(0.9rem, 1.6vw, 1.05rem);
  line-height: 1.85;
  color: var(--ink2);
  max-width: 520px;
  margin-bottom: 2rem;
}
.masthead-cats {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.cat-pill {
  display: inline-flex;
  align-items: center;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 0.4rem 0.9rem;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.15s;
  border: 1px solid transparent;
}
.cat-pill:hover { opacity: 0.75; }
.cat-pill--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.cat-pill--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.cat-pill--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

/* ── FEATURED ── */
.featured {
  padding: 56px 0;
  border-bottom: 1px solid var(--border);
}
.featured-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.featured-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 52px;
  align-items: center;
  text-decoration: none;
  color: inherit;
}
.featured-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
}
.featured-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.featured-card:hover .featured-img { transform: scale(1.04); }
.featured-img-empty { width: 100%; height: 100%; background: var(--bg3); }

.feat-cat {
  display: inline-flex;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
  text-decoration: none;
  margin-bottom: 1rem;
  border: 1px solid transparent;
}
.feat-cat--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.feat-cat--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.feat-cat--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

.feat-title {
  font-family: var(--font-serif);
  font-size: clamp(1.25rem, 2.5vw, 1.85rem);
  font-weight: 700;
  line-height: 1.5;
  color: var(--ink);
  margin-bottom: 1rem;
}
.feat-desc {
  font-size: 0.9rem;
  line-height: 1.85;
  color: var(--ink2);
  margin-bottom: 1.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.feat-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.feat-date { font-size: 0.73rem; color: var(--ink3); }
.feat-cta {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.06em;
}
.feat-arrow {
  display: inline-block;
  transition: transform 0.2s ease;
}
.featured-card:hover .feat-arrow { transform: translateX(4px); }

/* ── SHARED SECTION ── */
.section-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}

/* ── CARD GRID ── */
.recent {
  padding: 56px 0 88px;
}
.card-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 36px 28px;
}
.card-link {
  display: block;
  text-decoration: none;
  color: inherit;
}
.card-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
  margin-bottom: 1rem;
}
.card-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.5s ease;
}
.card-link:hover .card-img { transform: scale(1.04); }
.card-img-empty { width: 100%; height: 100%; background: var(--bg3); }
.card-cat {
  display: inline-flex;
  align-items: center;
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  padding: 0.25rem 0.6rem;
  border-radius: 100px;
  text-decoration: none;
  margin-bottom: 0.6rem;
  border: 1px solid transparent;
}
.card-cat--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.card-cat--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.card-cat--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }
.card-title {
  font-family: var(--font-serif);
  font-size: clamp(0.92rem, 1.4vw, 1.05rem);
  font-weight: 700;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 0.5rem;
  transition: color 0.2s;
}
.card-link:hover .card-title { color: var(--ink2); }
.card-desc {
  font-size: 0.8rem;
  line-height: 1.75;
  color: var(--ink2);
  margin-bottom: 0.6rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-date { font-size: 0.7rem; color: var(--ink3); }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .card-grid { grid-template-columns: repeat(2, 1fr); }
  .featured-card { gap: 32px; }
}
@media (max-width: 680px) {
  .featured-card { grid-template-columns: 1fr; gap: 24px; }
  .masthead, .featured { padding: 40px 0; }
  .recent { padding: 40px 0 64px; }
}
@media (max-width: 540px) {
  .card-grid { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .masthead-inner, .featured-inner, .section-wrap { padding: 0 1rem; }
}
</style>
