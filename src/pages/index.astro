---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

type Post = {
  id: string;
  col: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    ogImage?: string;
  };
};

const allPosts: Post[] = (await Promise.all([
  getCollection("whatif").then(posts => posts.map(p => ({ ...p, col: "whatif" }))).catch(() => []),
  getCollection("philosophy").then(posts => posts.map(p => ({ ...p, col: "philosophy" }))).catch(() => []),
])).flat().sort((a: Post, b: Post) => b.data.date.getTime() - a.data.date.getTime());

function href(col: string, id: string) {
  return `/blog/${col}/${id.replace(/\.mdx?$/, "")}/`;
}
function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}
function label(col: string) {
  return col === "whatif" ? "もしも歴史" : "哲学";
}

const featured = allPosts[0];
const rest     = allPosts.slice(1);
const SHOW     = 10;
---

<BaseLayout
  title="偉人ラボ | 歴史の偉人が現代の問題を解決する"
  description="信長・ナポレオン・孫子・龍馬——歴史の偉人たちが現代のあなたの悩みに答える。仕事・人間関係・決断・逆境——時代を超えた知恵をあなたへ。"
>
  <main class="page">

    <!-- ─── Featured ─── -->
    {featured && (
      <a class="hero" href={href(featured.col, featured.id)}>
        <div class="hero-img">
          {featured.data.ogImage
            ? <img src={featured.data.ogImage} alt={featured.data.title} loading="eager" />
            : <div class="no-img" />
          }
          <div class="hero-scrim" />
        </div>
        <div class="hero-text">
          <span class="tag">{label(featured.col)}</span>
          <h2 class="hero-title">{featured.data.title}</h2>
          {featured.data.description &&
            <p class="hero-desc">{featured.data.description}</p>
          }
          <time class="date">{fmt(featured.data.date)}</time>
        </div>
      </a>
    )}

    <!-- ─── Article list ─── -->
    <ul class="list" id="list">
      {rest.map((p, i) => (
        <li class="row" data-i={i} style={i >= SHOW ? "display:none" : ""}>
          <a class="row-inner" href={href(p.col, p.id)}>
            <div class="row-img">
              {p.data.ogImage
                ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" />
                : <div class="no-img" />
              }
            </div>
            <div class="row-text">
              <span class="tag">{label(p.col)}</span>
              <h3 class="row-title">{p.data.title}</h3>
              {p.data.description &&
                <p class="row-desc">{p.data.description}</p>
              }
              <time class="date">{fmt(p.data.date)}</time>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <!-- ─── More ─── -->
    {rest.length > SHOW && (
      <div class="more" id="more">
        <button id="btn">もっと読む</button>
      </div>
    )}

  </main>
</BaseLayout>

<script>
  document.getElementById("btn")?.addEventListener("click", () => {
    const hidden = document.querySelectorAll<HTMLElement>("#list li[style*='display:none']");
    hidden.forEach(el => { el.style.display = ""; el.classList.add("in"); });
    if (!document.querySelector("#list li[style*='display:none']")) {
      document.getElementById("more")?.remove();
    }
  });
</script>

<style>
/* ── Shell ── */
.page {
  max-width: 960px;
  margin: 0 auto;
  padding: 0 24px 100px;
}

/* ── Hero ── */
.hero {
  display: block;
  text-decoration: none;
  color: inherit;
  position: relative;
  margin-bottom: 64px;
}
.hero-img {
  position: relative;
  width: 100%;
  aspect-ratio: 16/7;
  overflow: hidden;
  background: #111;
}
.hero-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform .5s ease;
  filter: brightness(.82);
}
.hero:hover .hero-img img { transform: scale(1.03); }
.hero-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 30%, rgba(0,0,0,.55) 100%);
}

.hero-text {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 32px 36px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: #fff;
}
.hero-title {
  font-size: clamp(1.3rem, 3vw, 2rem);
  font-weight: 800;
  line-height: 1.4;
  margin: 0;
  letter-spacing: -.01em;
}
.hero-desc {
  font-size: .9rem;
  line-height: 1.65;
  margin: 0;
  opacity: .85;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── List ── */
.list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.row {
  border-top: 1px solid #e5e5e5;
}
.row:last-child { border-bottom: 1px solid #e5e5e5; }
.row.in { animation: fadeIn .35s ease both; }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: none; }
}

.row-inner {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 28px;
  padding: 28px 0;
  text-decoration: none;
  color: inherit;
  transition: opacity .2s;
}
.row-inner:hover { opacity: .72; }

.row-img {
  aspect-ratio: 4/3;
  overflow: hidden;
  background: #f0f0f0;
  flex-shrink: 0;
}
.row-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform .4s ease;
}
.row-inner:hover .row-img img { transform: scale(1.04); }

.no-img {
  width: 100%;
  height: 100%;
  background: #e8e8e8;
}

.row-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10px;
}
.row-title {
  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1.5;
  margin: 0;
  color: #1d1d1f;
}
.row-desc {
  font-size: .85rem;
  line-height: 1.7;
  color: #6e6e73;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Tag & date ── */
.tag {
  display: inline-block;
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #6e6e73;
}
.date {
  font-size: .75rem;
  color: #aeaeb2;
}

/* ── More ── */
.more {
  display: flex;
  justify-content: center;
  padding-top: 60px;
}
#btn {
  font-family: inherit;
  font-size: .85rem;
  font-weight: 500;
  letter-spacing: .08em;
  color: #1d1d1f;
  background: none;
  border: 1px solid #1d1d1f;
  border-radius: 2px;
  padding: 13px 48px;
  cursor: pointer;
  transition: background .18s, color .18s;
}
#btn:hover { background: #1d1d1f; color: #fff; }

/* ── Responsive ── */
@media (max-width: 640px) {
  .page { padding: 0 16px 80px; }
  .hero-img { aspect-ratio: 4/3; }
  .hero-text { padding: 20px; }
  .row-inner {
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding: 20px 0;
  }
  .row-title { font-size: 1rem; }
}
</style>
