---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

type Post = {
  id: string;
  col: string;
  data: { title: string; date: Date; description?: string; ogImage?: string; };
};

const allPosts: Post[] = (await Promise.all([
  getCollection("whatif").then(p => p.map(x => ({ ...x, col: "whatif" }))).catch(() => []),
  getCollection("philosophy").then(p => p.map(x => ({ ...x, col: "philosophy" }))).catch(() => []),
])).flat().sort((a: Post, b: Post) => b.data.date.getTime() - a.data.date.getTime());

function href(col: string, id: string) {
  return `/blog/${col}/${id.replace(/\.mdx?$/, "")}/`;
}
function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year:"numeric", month:"short", day:"numeric" });
}
function label(col: string) { return col === "whatif" ? "もしも歴史" : "哲学"; }

const hero = allPosts[0];
const entries = allPosts.slice(1, 9);
const rest = allPosts.slice(9);
---

<BaseLayout
  title="偉人ラボ | 歴史の偉人が現代の問題を解決する"
  description="信長・ナポレオン・孫子・龍馬——歴史の偉人たちが現代のあなたの悩みに答える。"
>

<!-- ═══ HERO ═══════════════════════════════════════════════ -->
{hero && (
  <section class="hero">
    <div class="hero-bg">
      {hero.data.ogImage && <img src={hero.data.ogImage} alt="" class="hero-img" />}
      <div class="hero-veil" />
    </div>

    <!-- floating ancient glyphs -->
    <div class="glyphs" aria-hidden="true">
      <span style="--x:8%;--y:15%;--s:7rem;--o:.07;--d:0s">𒀭</span>
      <span style="--x:80%;--y:10%;--s:5rem;--o:.09;--d:.8s">𓂀</span>
      <span style="--x:15%;--y:70%;--s:9rem;--o:.06;--d:1.2s">ﻋ</span>
      <span style="--x:70%;--y:60%;--s:11rem;--o:.05;--d:.4s">𓃭</span>
      <span style="--x:45%;--y:80%;--s:6rem;--o:.08;--d:2s">𒁁</span>
      <span style="--x:88%;--y:78%;--s:8rem;--o:.06;--d:1.6s">ق</span>
      <span style="--x:3%;--y:45%;--s:10rem;--o:.05;--d:.2s">𓇋</span>
      <span style="--x:55%;--y:5%;--s:6rem;--o:.07;--d:1s">𒄖</span>
    </div>

    <div class="hero-content">
      <a href={href(hero.col, hero.id)} class="hero-link">
        <p class="hero-label">{label(hero.col)}</p>
        <h1 class="hero-title" id="scramble-title" data-text={hero.data.title}>{hero.data.title}</h1>
        {hero.data.description && <p class="hero-desc">{hero.data.description}</p>}
        <span class="hero-cta">読む <span class="arrow">→</span></span>
      </a>
    </div>

    <div class="scroll-hint" aria-hidden="true">
      <span>scroll</span>
      <span class="scroll-line" />
    </div>
  </section>
)}

<!-- ═══ TICKER ══════════════════════════════════════════════ -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[...Array(3)].map(() => (
      <span class="ticker-inner">
        𒀭&nbsp;偉人ラボ&nbsp;✦&nbsp;織田信長&nbsp;✦&nbsp;ﻋﻞ&nbsp;✦&nbsp;ナポレオン&nbsp;✦&nbsp;𓂀&nbsp;✦&nbsp;徳川家康&nbsp;✦&nbsp;ق&nbsp;✦&nbsp;孫子&nbsp;✦&nbsp;𒁁&nbsp;✦&nbsp;カエサル&nbsp;✦&nbsp;𓃭&nbsp;✦&nbsp;坂本龍馬&nbsp;✦&nbsp;ﻏ&nbsp;✦&nbsp;ニーチェ&nbsp;✦&nbsp;𒄖&nbsp;✦&nbsp;クレオパトラ&nbsp;✦&nbsp;𓇋&nbsp;✦&nbsp;
      </span>
    ))}
  </div>
</div>

<!-- ═══ ENTRIES ═════════════════════════════════════════════ -->
<main class="entries">
  {entries.map((p, i) => (
    <article class={`entry js-reveal ${i % 2 === 1 ? "entry--rev" : ""}`}>
      <a class="entry-img-wrap" href={href(p.col, p.id)} tabindex="-1" aria-hidden="true">
        <div class="entry-img-inner">
          {p.data.ogImage
            ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="entry-img" />
            : <div class="entry-img no-img" />
          }
        </div>
        <div class="entry-img-glyph" aria-hidden="true">
          {["𒀭","𓂀","ﻋ","ق","𒁁","𓃭","𓇋","𒄖"][i % 8]}
        </div>
      </a>
      <div class="entry-text">
        <p class="entry-cat">{label(p.col)}</p>
        <h2 class="entry-title">
          <a href={href(p.col, p.id)}>{p.data.title}</a>
        </h2>
        {p.data.description && <p class="entry-desc">{p.data.description}</p>}
        <div class="entry-foot">
          <time class="entry-date">{fmt(p.data.date)}</time>
          <a class="entry-read" href={href(p.col, p.id)}>読む →</a>
        </div>
      </div>
    </article>
  ))}
</main>

<!-- ═══ REST (compact) ══════════════════════════════════════ -->
{rest.length > 0 && (
  <section class="compact-section">
    <p class="compact-heading" aria-hidden="true">𒀭 MORE 𒀭</p>
    <ul class="compact-list" id="compact-list">
      {rest.map((p, i) => (
        <li class={`compact-item js-reveal ${i >= 12 ? "hidden" : ""}`}>
          <a href={href(p.col, p.id)} class="compact-link">
            <span class="compact-cat">{label(p.col)}</span>
            <span class="compact-title">{p.data.title}</span>
            <time class="compact-date">{fmt(p.data.date)}</time>
          </a>
        </li>
      ))}
    </ul>
    {rest.length > 12 && (
      <div class="more-wrap" id="more-wrap">
        <button id="more-btn" class="more-btn">もっと読む</button>
      </div>
    )}
  </section>
)}

</BaseLayout>

<!-- ═══ SCRIPTS ════════════════════════════════════════════ -->
<script>
/* ── Text scramble on hero ── */
const CHARS = "アイウエオカキクケコサシスセソタチツテトナニヌネノ𒀭𓂀𒁁ﻋقABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
function scramble(el: HTMLElement) {
  const final = el.dataset.text ?? el.textContent ?? "";
  let frame = 0;
  const speed = 2;
  const maxFrames = final.length * speed + 20;
  function tick() {
    if (frame >= maxFrames) { el.textContent = final; return; }
    const revealed = Math.floor(frame / speed);
    el.textContent = final.split("").map((ch, i) => {
      if (i < revealed) return ch;
      return CHARS[Math.floor(Math.random() * CHARS.length)];
    }).join("");
    frame++;
    requestAnimationFrame(tick);
  }
  tick();
}
window.addEventListener("DOMContentLoaded", () => {
  const el = document.getElementById("scramble-title") as HTMLElement | null;
  if (el) setTimeout(() => scramble(el), 300);
});

/* ── Scroll reveal ── */
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      (e.target as HTMLElement).classList.add("visible");
      observer.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });
document.querySelectorAll(".js-reveal").forEach(el => observer.observe(el));

/* ── More button ── */
document.getElementById("more-btn")?.addEventListener("click", () => {
  document.querySelectorAll<HTMLElement>(".compact-item.hidden").forEach(el => {
    el.classList.remove("hidden");
    el.classList.add("js-reveal");
    observer.observe(el);
  });
  document.getElementById("more-wrap")?.remove();
});
</script>

<style is:global>
/* ══ Reset for full-bleed ════════════════════════════════ */
body { background: #0d0b0a; color: #f0ede6; }

/* ══ HERO ═══════════════════════════════════════════════ */
.hero {
  position: relative;
  height: 100svh;
  min-height: 560px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  animation: kenBurns 18s ease-in-out infinite alternate;
  filter: brightness(.55) saturate(1.1);
}
@keyframes kenBurns {
  from { transform: scale(1)    translate(0, 0); }
  to   { transform: scale(1.08) translate(-2%, 1%); }
}
.hero-veil {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to top,  rgba(13,11,10,.95) 0%, transparent 55%),
    linear-gradient(to right, rgba(13,11,10,.4)  0%, transparent 60%);
}

/* floating glyphs */
.glyphs { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
.glyphs span {
  position: absolute;
  left: var(--x);
  top:  var(--y);
  font-size: var(--s);
  opacity: var(--o);
  color: #c9a84c;
  animation: float 8s ease-in-out infinite alternate;
  animation-delay: var(--d);
  line-height: 1;
  user-select: none;
}
@keyframes float {
  from { transform: translateY(0)   rotate(-3deg); }
  to   { transform: translateY(-16px) rotate(3deg); }
}

/* hero text */
.hero-content {
  position: relative;
  z-index: 2;
  padding: clamp(24px, 6vw, 80px);
  max-width: 780px;
}
.hero-link { text-decoration: none; color: inherit; display: block; }
.hero-label {
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #c9a84c;
  margin: 0 0 14px;
}
.hero-title {
  font-size: clamp(1.6rem, 4.5vw, 3.2rem);
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: -.02em;
  margin: 0 0 18px;
  color: #fff;
  text-shadow: 0 2px 32px rgba(0,0,0,.6);
}
.hero-desc {
  font-size: clamp(.85rem, 1.5vw, 1rem);
  line-height: 1.75;
  color: rgba(240,237,230,.72);
  margin: 0 0 28px;
  max-width: 560px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: .85rem;
  font-weight: 600;
  letter-spacing: .1em;
  color: #c9a84c;
  border-bottom: 1px solid #c9a84c;
  padding-bottom: 2px;
}
.hero-cta .arrow { transition: transform .25s ease; }
.hero-link:hover .hero-cta .arrow { transform: translateX(5px); }

/* scroll hint */
.scroll-hint {
  position: absolute;
  right: 32px;
  bottom: 32px;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  color: rgba(240,237,230,.4);
  font-size: .65rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.scroll-line {
  width: 1px;
  height: 48px;
  background: rgba(240,237,230,.25);
  animation: scrollDown 1.6s ease-in-out infinite;
}
@keyframes scrollDown {
  0%   { transform: scaleY(0); transform-origin: top; }
  50%  { transform: scaleY(1); transform-origin: top; }
  51%  { transform: scaleY(1); transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

/* ══ TICKER ═════════════════════════════════════════════ */
.ticker {
  background: #c9a84c;
  overflow: hidden;
  padding: 10px 0;
  white-space: nowrap;
}
.ticker-track {
  display: inline-flex;
  animation: marquee 28s linear infinite;
}
@keyframes marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-33.333%); }
}
.ticker-inner {
  display: inline-block;
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .08em;
  color: #0d0b0a;
  padding-right: 0;
}

/* ══ ENTRIES ════════════════════════════════════════════ */
.entries {
  max-width: 1100px;
  margin: 0 auto;
  padding: 80px 32px 0;
}

.entry {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  min-height: 420px;
  margin-bottom: 2px;
  overflow: hidden;
  opacity: 0;
  transform: translateY(40px);
  transition: opacity .7s ease, transform .7s ease;
}
.entry.visible { opacity: 1; transform: none; }
.entry--rev { direction: rtl; }
.entry--rev > * { direction: ltr; }

.entry-img-wrap {
  position: relative;
  overflow: hidden;
  display: block;
  background: #1a1714;
  cursor: pointer;
}
.entry-img-inner {
  width: 100%;
  height: 100%;
  min-height: 360px;
}
.entry-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform .8s cubic-bezier(.25,.46,.45,.94);
  filter: brightness(.9);
}
.entry-img-wrap:hover .entry-img { transform: scale(1.06); }
.entry-img-wrap:hover .entry-img-glyph { opacity: .35; }
.entry-img-glyph {
  position: absolute;
  bottom: -12px;
  right: -8px;
  font-size: 9rem;
  color: #c9a84c;
  opacity: .15;
  line-height: 1;
  pointer-events: none;
  transition: opacity .5s ease;
  user-select: none;
}

.entry-text {
  padding: 52px 48px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 18px;
  background: #111009;
  border: 1px solid #2a2520;
}
.entry-cat {
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #c9a84c;
  margin: 0;
}
.entry-title {
  font-size: clamp(1.05rem, 2vw, 1.45rem);
  font-weight: 800;
  line-height: 1.5;
  margin: 0;
}
.entry-title a {
  text-decoration: none;
  color: #f0ede6;
  transition: color .2s;
}
.entry-title a:hover { color: #c9a84c; }
.entry-desc {
  font-size: .85rem;
  line-height: 1.8;
  color: rgba(240,237,230,.6);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.entry-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
}
.entry-date {
  font-size: .72rem;
  color: rgba(240,237,230,.35);
  letter-spacing: .04em;
}
.entry-read {
  font-size: .78rem;
  font-weight: 600;
  color: #c9a84c;
  text-decoration: none;
  letter-spacing: .08em;
  transition: letter-spacing .25s ease;
}
.entry-read:hover { letter-spacing: .18em; }

/* ══ COMPACT LIST ═══════════════════════════════════════ */
.compact-section {
  max-width: 1100px;
  margin: 60px auto 0;
  padding: 0 32px 100px;
}
.compact-heading {
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .2em;
  color: #c9a84c;
  text-align: center;
  margin-bottom: 40px;
}
.compact-list { list-style: none; margin: 0; padding: 0; }
.compact-item {
  border-top: 1px solid #2a2520;
  opacity: 0;
  transform: translateY(16px);
  transition: opacity .5s ease, transform .5s ease;
}
.compact-item:last-child { border-bottom: 1px solid #2a2520; }
.compact-item.visible { opacity: 1; transform: none; }
.compact-item.hidden  { display: none; }

.compact-link {
  display: grid;
  grid-template-columns: 80px 1fr auto;
  gap: 20px;
  align-items: center;
  padding: 20px 0;
  text-decoration: none;
  color: inherit;
  transition: opacity .2s;
}
.compact-link:hover { opacity: .65; }
.compact-cat {
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .1em;
  color: #c9a84c;
  text-transform: uppercase;
}
.compact-title {
  font-size: .95rem;
  font-weight: 600;
  color: #f0ede6;
  line-height: 1.4;
}
.compact-date {
  font-size: .72rem;
  color: rgba(240,237,230,.35);
  white-space: nowrap;
}

/* ══ MORE ═══════════════════════════════════════════════ */
.more-wrap { display: flex; justify-content: center; padding-top: 48px; }
.more-btn {
  font-family: inherit;
  font-size: .78rem;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #c9a84c;
  background: transparent;
  border: 1px solid #c9a84c;
  padding: 14px 52px;
  cursor: pointer;
  transition: background .2s, color .2s;
}
.more-btn:hover { background: #c9a84c; color: #0d0b0a; }

/* ══ Responsive ═════════════════════════════════════════ */
@media (max-width: 768px) {
  .entry { grid-template-columns: 1fr; min-height: auto; }
  .entry--rev { direction: ltr; }
  .entry-img-inner { min-height: 240px; }
  .entry-text { padding: 28px 24px; }
  .compact-link { grid-template-columns: 60px 1fr; }
  .compact-date { display: none; }
  .entries { padding: 40px 16px 0; }
  .compact-section { padding: 0 16px 80px; }
}
@media (max-width: 480px) {
  .hero-content { padding: 24px; }
  .entry-img-inner { min-height: 200px; }
}
</style>
