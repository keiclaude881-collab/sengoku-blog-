---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import BookCard from "../components/BookCard.astro";
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";

// ④ decideカテゴリから直近3件
const allDecide = (await Promise.all([
  getCollection("battle"),
  getCollection("leader"),
  getCollection("strategy"),
  getCollection("whatif"),
  getCollection("world"),
].map(p => p.catch(() => [])))).flat()
  .filter(p => p.data.category === "decide")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, "")}`;
}

// ⑥ 書籍3冊
const books = [
  { title: "孫子の兵法（知的生きかた文庫）", asin: "4837900186", reason: "情報戦の原典。競合分析の基礎が凝縮されている" },
  { title: "五輪書（宮本武蔵）", asin: "4003300211", reason: "個の強さとは何か。武蔵の戦略哲学を学ぶ" },
  { title: "失敗の本質", asin: "4122018331", reason: "なぜ日本軍は負けたのか。組織論の古典" },
];

const AUDIBLE_URL = "https://af.moshimo.com/af/c/click?a_id=5427522&p_id=170&pc_id=185&pl_id=4062&url=https%3A%2F%2Fwww.amazon.co.jp%2Fftu%2Fhome";
---

<BaseLayout
  title="決断の系譜 | 決断できない夜、あなたは一人じゃない。"
  description="月曜日の悩みに、戦国武将が答える。500年前の武将たちが、意外なほどリアルな答えを持っている。"
>

  <!-- ① Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-sub">月曜日の悩みに、戦国武将が答える。</p>
      <h1 class="hero-title">決断できない夜、<br>あなたは一人じゃない。</h1>
      <a href="/blog/" class="hero-cta">記事を読む →</a>
    </div>
  </section>

  <!-- ② 共感ブロック -->
  <section class="empathy">
    <div class="container">
      <h2 class="empathy-heading">こんな状況、ありませんか？</h2>
      <ul class="empathy-list">
        <li>部下に何を言っても伝わらない</li>
        <li>決断しなければいけないのに、正解が見えない</li>
        <li>頑張っているのに、結果が出ない</li>
      </ul>
    </div>
  </section>

  <!-- ③ このブログの答え -->
  <section class="answer">
    <div class="container">
      <p class="answer-text">
        500年前の武将たちが、<br class="br-sp">意外なほどリアルな答えを持っている。
      </p>
    </div>
  </section>

  <!-- ④ 注目記事3本 -->
  {allDecide.length > 0 && (
    <section class="articles">
      <div class="container">
        <h2 class="section-heading">注目記事</h2>
        <ul class="article-grid" role="list">
          {allDecide.map(post => (
            <li>
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                category={post.data.category}
                tags={post.data.tags}
                readingTime={post.data.readingTime}
                lesson={post.data.lesson}
                slug={slug(post.collection, post.id)}
                ogImage={post.data.ogImage}
              />
            </li>
          ))}
        </ul>
        <div class="articles-more">
          <a href="/blog/" class="more-link">すべての記事を見る →</a>
        </div>
      </div>
    </section>
  )}

  <!-- ⑤ Audibleバナー -->
  <section class="audible">
    <div class="container audible-inner">
      <p class="audible-text">通勤中に戦略書を聴く。</p>
      <a
        href={AUDIBLE_URL}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="audible-cta"
      >
        30日間無料体験 →
      </a>
    </div>
  </section>

  <!-- ⑥ おすすめ書籍 -->
  <section class="books">
    <div class="container">
      <h2 class="section-heading">あわせて読みたい</h2>
      <AffiliateDisclosure />
      <div class="book-grid">
        {books.map(b => (
          <BookCard title={b.title} asin={b.asin} reason={b.reason} />
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    background:
      linear-gradient(to bottom, rgba(5,12,5,0.75) 0%, rgba(5,12,5,0.6) 100%),
      url('/images/header-bg.jpg') center center / cover no-repeat;
    min-height: 92svh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
  }

  .hero-inner {
    max-width: 640px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    color: var(--gold-light);
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 7vw, 4rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    letter-spacing: 0.04em;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.4rem;
    background: var(--gold);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .hero-cta:hover {
    background: var(--gold-dark);
    transform: translateY(-2px);
  }

  /* ── 共感ブロック ── */
  .empathy {
    background: var(--bg2);
    padding: 5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .empathy-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 2.4rem;
    letter-spacing: 0.04em;
  }

  .empathy-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .empathy-list li {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: var(--ink2);
    line-height: 1.7;
    padding-left: 1.5rem;
    position: relative;
  }
  .empathy-list li::before {
    content: "・";
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 1.2em;
    line-height: 1.4;
  }

  /* ── このブログの答え ── */
  .answer {
    background: var(--accent);
    padding: 5rem 0;
  }

  .answer-text {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.8;
    letter-spacing: 0.04em;
    text-align: center;
  }

  /* ── 注目記事 ── */
  .articles {
    background: var(--bg);
    padding: 5rem 0;
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.08em;
    margin-bottom: 2.4rem;
    padding-bottom: 0.8rem;
    border-bottom: 2px solid var(--gold);
    display: inline-block;
  }

  .article-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .articles-more {
    margin-top: 2.4rem;
    text-align: center;
  }

  .more-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .more-link:hover { color: var(--gold-dark); }

  /* ── Audibleバナー ── */
  .audible {
    background: var(--ink);
    padding: 3.5rem 0;
  }

  .audible-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .audible-text {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
  }

  .audible-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 2rem;
    background: var(--gold);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    border-radius: 2px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, transform 0.2s;
    flex-shrink: 0;
  }
  .audible-cta:hover {
    background: var(--gold-dark);
    transform: translateY(-1px);
  }

  /* ── 書籍 ── */
  .books {
    background: var(--bg2);
    padding: 5rem 0;
    border-top: 1px solid var(--rule);
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  /* ── container ── */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── レスポンシブ ── */
  @media (max-width: 768px) {
    .hero-inner { padding: 3rem 1.5rem 4rem; }
    .article-grid { grid-template-columns: 1fr; }
    .book-grid { grid-template-columns: 1fr; gap: 1rem; }
    .audible-inner { flex-direction: column; align-items: flex-start; }
    .answer-text { text-align: left; }
  }

  @media (max-width: 480px) {
    .empathy { padding: 3.5rem 0; }
    .answer  { padding: 3.5rem 0; }
    .articles { padding: 3.5rem 0; }
    .books  { padding: 3.5rem 0; }
    .br-sp  { display: block; }
  }
  @media (min-width: 481px) {
    .br-sp { display: none; }
  }
</style>
