---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ArticleFeatured from "../components/ArticleFeatured.astro";
import ArticleCard from "../components/ArticleCard.astro";
import BookCard from "../components/BookCard.astro";
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";

const formspreeId = import.meta.env.FORMSPREE_ID ?? '';

const allArticles = (await Promise.all([
  getCollection("battle"),
  getCollection("leader"),
  getCollection("strategy").catch(() => []),
  getCollection("books").catch(() => []),
  getCollection("movie").catch(() => []),
  getCollection("whatif").catch(() => []),
])).flat().sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = allArticles.find(a => a.data.featured) ?? allArticles[0];
const recent   = allArticles.filter(a => a.id !== featured?.id).slice(0, 3);

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, '')}`;
}

const featuredBooks = [
  { title: "孫子の兵法（知的生きかた文庫）", asin: "4837900186", reason: "情報戦の原典。競合分析の基礎が凝縮されている" },
  { title: "五輪書（宮本武蔵）岩波文庫", asin: "4003300211", reason: "個の強さとは何か。武蔵の戦略哲学を学ぶ" },
  { title: "戦略の本質", asin: "4532194628", reason: "日本の合戦を経営戦略の視点で再解釈した名著" },
  { title: "失敗の本質", asin: "4122018331", reason: "なぜ日本軍は負けたのか。組織論の古典" },
];

const marqueeItems = [
  "関ヶ原の決断",
  "孫子の兵法",
  "信長のイノベーション",
  "家康の忍耐戦略",
  "桶狭間の奇襲",
  "武田信玄の人事",
  "五輪書の哲学",
  "ナポレオンの速戦",
  "戦略的情報収集",
  "謀攻篇の現代応用",
];
---

<BaseLayout
  title="決断の系譜 | 歴史の選択が、未来を変える。"
  description="古今東西の英傑の決断・合戦・映画・SF・歴史IFまで。戦略と選択を深掘りする歴史×エンタメブログ。"
>
  <!-- ヒーロー -->
  <Hero />

  <!-- マーキー帯 -->
  <div class="marquee-band" aria-hidden="true">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map(item => (
        <span class="marquee-item">
          <span class="marquee-dot">✦</span>
          {item}
        </span>
      ))}
    </div>
  </div>

  <!-- イントロバンド -->
  <section class="intro-band">
    <div class="container intro-inner">
      <span class="intro-label" aria-hidden="true">Philosophy</span>
      <blockquote class="intro-quote">
        <p class="quote-jp">「戦わずして人の兵を屈するは、善の善なる者なり。」</p>
        <p class="quote-en font-italic">— Sun Tzu, The Art of War</p>
      </blockquote>
    </div>
  </section>

  <!-- メルマガ登録 -->
  <section class="email-section">
    <div class="container email-inner">
      <div class="email-left">
        <h2 class="email-heading">週1回、武将の戦略Tipsを届ける。</h2>
        <ul class="email-benefits">
          <li><span class="benefit-check">✓</span> 歴史×ビジネスの深掘りコラム（週1回）</li>
          <li><span class="benefit-check">✓</span> 登録者限定の深掘りコラム</li>
          <li><span class="benefit-check">✓</span> 新着記事の先行通知</li>
        </ul>
        <p class="email-note">無料・いつでも解除可能</p>
      </div>
      <div class="email-right">
        <form
          class="email-form"
          id="newsletter-form"
          action="https://ketsudankeifu.substack.com/subscribe"
          method="get"
          target="_blank"
        >
          <label class="form-label" for="email-input">メールアドレス</label>
          <div class="form-row">
            <input
              type="email"
              id="email-input"
              name="email"
              placeholder="your@email.com"
              required
              class="form-input"
            />
            <button type="submit" class="form-btn">登録する →</button>
          </div>
          <p class="form-privacy">
            <a href="/privacy/">プライバシーポリシー</a>に同意のうえご登録ください。
          </p>
        </form>
        <div class="email-thanks" id="email-thanks" hidden>
          <p class="thanks-icon">✓</p>
          <p class="thanks-text">ご登録ありがとうございます。<br>確認メールをお送りします。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 注目記事 -->
  {allArticles.length > 0 && (
    <section class="section articles-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">注目記事</h2>
          <a href="/blog/" class="section-more">すべて見る →</a>
        </div>

        {featured && (
          <ArticleFeatured
            title={featured.data.title}
            description={featured.data.description}
            date={featured.data.date}
            category={featured.data.category}
            tags={featured.data.tags}
            readingTime={featured.data.readingTime}
            lesson={featured.data.lesson}
            slug={slug(featured.collection, featured.id)}
          />
        )}

        {recent.length > 0 && (
          <ul class="article-grid" role="list">
            {recent.map(post => (
              <li>
                <ArticleCard
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date}
                  category={post.data.category}
                  tags={post.data.tags}
                  readingTime={post.data.readingTime}
                  lesson={post.data.lesson}
                  slug={slug(post.collection, post.id)}
                  ogImage={post.data.ogImage}
                />
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  <!-- カテゴリ -->
  <section class="categories-section section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">どの視点から切り込む？</h2>
      </div>
      <ul class="cat-grid" role="list">
        {[
          {
            cat: "battle",
            label: "合戦と戦略",
            hook: "なぜあの戦いは、その結末になったのか",
            desc: "関ヶ原・川中島・桶狭間を現代の視点で解剖する",
          },
          {
            cat: "leader",
            label: "武将の思想",
            hook: "信長はなぜ、既存の秩序を壊せたのか",
            desc: "英傑たちのリーダーシップと意思決定の深層",
          },
          {
            cat: "strategy",
            label: "兵法・現代応用",
            hook: "孫子の言葉は、会議室でも使えるか",
            desc: "古典兵法をビジネス・交渉・組織論に翻訳する",
          },
          {
            cat: "books",
            label: "書籍レビュー",
            hook: "この一冊が、あなたの思考を変える",
            desc: "歴史×戦略で厳選した推薦図書をレビュー",
          },
        ].map(({ cat, label, hook, desc }) => (
          <li>
            <a href={`/category/${cat}/`} class="cat-card">
              <span class="cat-name">{label}</span>
              <h3 class="cat-hook">{hook}</h3>
              <p class="cat-desc">{desc}</p>
              <span class="cat-link">記事一覧 →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 悩み別おすすめ -->
  <section class="needs-section section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">何を学びたい？</h2>
        <p class="needs-sub">テーマから記事を探す</p>
      </div>
      <ul class="needs-grid" role="list">
        {[
          {
            tag: "リーダーシップ",
            label: "人を動かしたい",
            desc: "信長・家康・武田信玄のリーダーシップから、現代の組織論を学ぶ",
          },
          {
            tag: "意思決定",
            label: "判断力を鍛えたい",
            desc: "合戦の瞬間に磨かれた決断の技術。不確実な局面での思考法",
          },
          {
            tag: "ビジネス戦略",
            label: "競争に勝ちたい",
            desc: "孫子・ポーター・ランチェスターを横断した実践的な戦略思考",
          },
          {
            tag: "組織論",
            label: "チームを強くしたい",
            desc: "武田の人材育成、徳川の組織設計。チームビルディングの原点",
          },
        ].map(({ tag, label, desc }) => (
          <li>
            <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="needs-card" data-tag={tag}>
              <span class="needs-tag">#{tag}</span>
              <h3 class="needs-label">{label}</h3>
              <p class="needs-desc">{desc}</p>
              <span class="needs-cta">記事を読む →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 書籍セクション -->
  <section class="books-section" aria-label="おすすめ書籍">
    <div class="container books-inner">
      <div class="section-header books-header">
        <h2 class="section-title books-title">戦略を深める、厳選の一冊。</h2>
        <a href="/books/" class="books-more">すべて見る →</a>
      </div>
      <p class="books-lead">記事を読んで「もっと深く知りたい」と思ったら、この本から始めよう。</p>
      <AffiliateDisclosure />
      <div class="book-grid">
        {featuredBooks.map(b => (
          <BookCard title={b.title} asin={b.asin} reason={b.reason} />
        ))}
      </div>
    </div>
  </section>

  <!-- Audibleバナー -->
  <section class="audible-banner">
    <div class="container banner-inner">
      <div class="banner-text">
        <span class="banner-tag audible-tag">Audible</span>
        <h3 class="banner-heading audible-heading">通勤中に孫子・五輪書を聴く。</h3>
        <p class="banner-body audible-body">移動時間が「戦略の学習時間」に変わる。30日間無料で体験できる。</p>
      </div>
      <a
        href="https://www.amazon.co.jp/audible?tag=sengokublog20-22"
        target="_blank"
        rel="nofollow sponsored noopener"
        class="banner-cta audible-cta"
      >
        30日間 無料体験 →
      </a>
    </div>
  </section>

  <!-- noteバナー -->
  <section class="note-banner">
    <div class="container banner-inner">
      <div class="banner-text">
        <span class="banner-tag note-tag">note</span>
        <h3 class="banner-heading note-heading">記事の深掘り・思考フレームをnoteで。</h3>
        <p class="banner-body note-body">歴史×ビジネスの戦略思考を深掘りしたコンテンツを発信中。</p>
      </div>
      <a
        href="https://note.com/"
        target="_blank"
        rel="noopener"
        class="banner-cta note-cta"
      >
        noteで購入する →
      </a>
    </div>
  </section>

</BaseLayout>

<!-- スティッキーCTAバー -->
<div class="sticky-cta" id="sticky-cta" aria-label="常設CTA">
  <div class="sticky-inner">
    <div class="sticky-items">
      <a href="#newsletter-form" class="sticky-btn sticky-btn-primary">
        📩 メルマガ登録（無料）
      </a>
      <a
        href="https://www.amazon.co.jp/audible?tag=sengokublog20-22"
        target="_blank"
        rel="nofollow sponsored noopener"
        class="sticky-btn sticky-btn-secondary"
      >
        🎧 Audible 30日間無料
      </a>
    </div>
    <button class="sticky-close" id="sticky-close" aria-label="閉じる">✕</button>
  </div>
</div>

<script>
  // メルマガフォーム（Substack）
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const thanks = document.getElementById('email-thanks') as HTMLElement | null;
  if (form && thanks) {
    form.addEventListener('submit', () => {
      setTimeout(() => {
        form.hidden = true;
        thanks.hidden = false;
      }, 100);
    });
  }

  // スティッキーCTA
  const stickyCta = document.getElementById('sticky-cta') as HTMLElement | null;
  const stickyClose = document.getElementById('sticky-close') as HTMLElement | null;
  let ctaClosed = false;

  if (stickyCta && stickyClose) {
    window.addEventListener('scroll', () => {
      if (ctaClosed) return;
      stickyCta.classList.toggle('visible', window.scrollY > 400);
    }, { passive: true });

    stickyClose.addEventListener('click', () => {
      ctaClosed = true;
      stickyCta.classList.remove('visible');
    });
  }
</script>

<style>
  /* ── マーキー ── */
  .marquee-band {
    background: var(--gold);
    padding: 0.7rem 0;
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee-track:hover { animation-play-state: paused; }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0 2rem;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #fff;
    white-space: nowrap;
  }
  .marquee-dot { font-size: 0.45rem; opacity: 0.7; }

  /* ── イントロバンド ── */
  .intro-band {
    background: var(--accent);
    padding: 5rem 0;
  }
  .intro-inner {
    display: flex;
    align-items: flex-start;
    gap: 3rem;
  }
  .intro-label {
    writing-mode: vertical-rl;
    font-family: var(--font-italic);
    font-size: 0.72rem;
    font-style: italic;
    letter-spacing: 0.2em;
    color: var(--gold);
    opacity: 0.7;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .quote-jp {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.5vw, 1.7rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.65;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }
  .quote-en {
    font-family: var(--font-italic);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--gold);
    letter-spacing: 0.05em;
  }

  /* ── メルマガ ── */
  .email-section {
    background: var(--bg2);
    padding: var(--sp-xl) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .email-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .email-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.4;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }
  .email-benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }
  .email-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--ink2);
    line-height: 1.5;
  }
  .benefit-check { color: var(--gold); font-weight: 700; flex-shrink: 0; }
  .email-note {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink3);
  }
  .form-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink2);
    margin-bottom: 0.6rem;
  }
  .form-row {
    display: flex;
    margin-bottom: 0.75rem;
  }
  .form-input {
    flex: 1;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--rule);
    border-right: none;
    border-radius: 2px 0 0 2px;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--ink);
    background: var(--bg);
    outline: none;
    transition: border-color 0.2s;
  }
  .form-input:focus { border-color: var(--gold); }
  .form-btn {
    padding: 0.85rem 1.6rem;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    border: none;
    border-radius: 0 2px 2px 0;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .form-btn:hover { background: var(--accent); }
  .form-privacy {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink3);
  }
  .form-privacy a { color: var(--gold); text-decoration: underline; }
  .email-thanks {
    text-align: center;
    padding: 2.5rem;
    background: var(--bg);
    border: 1px solid var(--gold-light);
    border-radius: 4px;
  }
  .thanks-icon { font-size: 2rem; color: var(--gold); margin-bottom: 0.75rem; }
  .thanks-text {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--ink2);
  }

  /* ── 記事・カテゴリ ── */
  .articles-section { background: var(--bg); }
  .categories-section { background: var(--bg2); }

  .cat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    background: var(--rule);
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem 1.6rem;
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: background 0.25s;
    height: 100%;
  }
  .cat-card:hover { background: var(--ink); }
  .cat-card:hover .cat-name { color: var(--gold); }
  .cat-card:hover .cat-hook,
  .cat-card:hover .cat-link { color: #fff; }
  .cat-card:hover .cat-desc { color: rgba(255,255,255,0.5); }

  .cat-name {
    font-family: var(--font-sans);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
    transition: color 0.25s;
  }
  .cat-hook {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.55;
    transition: color 0.25s;
  }
  .cat-desc {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink3);
    line-height: 1.65;
    flex: 1;
    transition: color 0.25s;
  }
  .cat-link {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--gold);
    margin-top: auto;
    transition: color 0.25s;
  }

  /* ── 悩み別おすすめ ── */
  .needs-section { background: var(--bg); }
  .needs-sub {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink3);
    margin-top: 0.3rem;
  }
  .needs-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .needs-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.8rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: background 0.22s, border-color 0.22s, transform 0.22s;
  }
  .needs-card:hover {
    background: var(--accent);
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .needs-tag {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--gold);
    transition: color 0.22s;
  }
  .needs-label {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.4;
    transition: color 0.22s;
  }
  .needs-card:hover .needs-label { color: #fff; }
  .needs-desc {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--ink3);
    flex: 1;
    transition: color 0.22s;
  }
  .needs-card:hover .needs-desc { color: rgba(255,255,255,0.55); }
  .needs-cta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--gold);
    margin-top: auto;
    transition: color 0.22s;
  }
  .needs-card:hover .needs-cta { color: var(--gold-light); }

  /* ── 書籍セクション ── */
  .books-section {
    background: #2A5C43;   /* ミディアムグリーン（黒より明るめ） */
    padding: var(--sp-xl) 0;
  }
  .books-header { border-bottom-color: rgba(255,255,255,0.08); }
  .books-title { color: #fff; }
