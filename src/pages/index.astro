---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { THEME_INFO, THEME_ORDER } from "../utils/arcMap";

const ALL_COLLECTIONS = ["battle","world","leader","strategy","whatif","anime","movie","novel","books","philosophy"] as const;
const allPosts = (await Promise.all(
  ALL_COLLECTIONS.map(c => getCollection(c).catch(() => []))
)).flat().sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentPosts = allPosts.slice(0, 4);

const philosophyPosts = (await getCollection("philosophy").catch(() => []))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, "")}`;
}

const AUDIBLE_URL = "https://af.moshimo.com/af/c/click?a_id=5427522&p_id=170&pc_id=185&pl_id=4062&url=https%3A%2F%2Fwww.amazon.co.jp%2Fftu%2Fhome";

const TICKER_ITEMS = [
  "桶狭間の戦い 1560","関ヶ原の戦い 1600","川中島の戦い 1561","長篠の戦い 1575",
  "ガウガメラの戦い BC331","カンナエの戦い BC216","テルモピュライ BC480",
  "アクティウムの海戦 BC31","アウステルリッツ 1805","ノルマンディー上陸 1944",
  "本能寺の変 1582","大坂の陣 1614","トラファルガー 1805","スターリングラード 1943","マラトンの戦い BC490",
];

function formatDate(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
}

const catLabel: Record<string, string> = {
  battle:"合戦", world:"世界史", leader:"武将", strategy:"戦略",
  whatif:"もしも", anime:"アニメ", movie:"映画", novel:"小説",
  books:"書評", philosophy:"哲学",
};
---

<BaseLayout
  title="決断の系譜 | 500年前の武将の知恵が、今日の答えになる。"
  description="決断できない夜に、武将の記録が答えをくれる。月曜日の悩みに、500年前の戦国武将が答える日本史ビジネスブログ。"
>
  <!-- スクロールプログレスバー -->
  <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

  <!-- ① HERO -->
  <section class="hero">
    <canvas class="lightning-canvas" id="lightning-canvas" aria-hidden="true"></canvas>
    <div class="hero-flash" id="hero-flash" aria-hidden="true"></div>
    <div class="ember-container" id="ember-container" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="hero-eyebrow">決断の系譜</p>
      <h1 class="hero-title" id="hero-title">武将の知恵が、今日の答えになる。</h1>
      <p class="hero-sub">500年前の決断から、あなたの悩みを解く。</p>
      <a href="#concerns" class="hero-cta">悩みから記事を探す ↓</a>
    </div>
    <div class="hero-scroll-hint" aria-hidden="true"><span></span></div>
  </section>

  <!-- ② TICKER -->
  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker">
      {[...TICKER_ITEMS, ...TICKER_ITEMS].map(text => (
        <span class="ticker-item">◆ {text}</span>
      ))}
    </div>
  </div>

  <!-- ③ THEMES ── ページの主役 -->
  <section class="themes" id="concerns">
    <div class="container">
      <div class="themes-head reveal">
        <p class="eyebrow eyebrow--light">YOUR CONCERN</p>
        <h2 class="themes-title">今日の悩みはどれ？</h2>
        <p class="themes-sub">テーマを選ぶと、その悩みに答える記事一覧へ。</p>
      </div>
      <ul class="theme-rows reveal" role="list">
        {THEME_ORDER.map((themeSlug, i) => {
          const t = THEME_INFO[themeSlug];
          return (
            <li class="theme-row-item">
              <a href={`/category/${themeSlug}/`} class="theme-row">
                <span class="row-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-icon" aria-hidden="true">{t.icon}</span>
                <span class="row-body">
                  <strong class="row-label">{t.label}</strong>
                  <span class="row-tagline">{t.tagline}</span>
                </span>
                <span class="row-arrow" aria-hidden="true">記事を見る →</span>
              </a>
            </li>
          );
        })}
      </ul>
      <div class="themes-foot reveal">
        <a href="/blog/" class="themes-all-link">全記事を見る →</a>
      </div>
    </div>
  </section>

  <!-- ④ ARTICLES -->
  <section class="articles reveal">
    <div class="container">
      <p class="eyebrow">LATEST</p>
      <h2 class="display-heading">最新記事</h2>
      <div class="articles-grid">
        <!-- メイン記事 -->
        {recentPosts[0] && (
          <a href={`/blog/${slug(recentPosts[0].collection, recentPosts[0].id)}/`} class="art-hero">
            <div class="art-hero-img-wrap">
              {recentPosts[0].data.ogImage
                ? <img src={recentPosts[0].data.ogImage} alt="" class="art-hero-img" loading="lazy" />
                : <div class="art-hero-img art-hero-img--ph" aria-hidden="true"><span>記</span></div>
              }
            </div>
            <div class="art-hero-body">
              <span class="art-cat">{catLabel[recentPosts[0].data.category] ?? recentPosts[0].data.category}</span>
              <p class="art-hero-title">{recentPosts[0].data.title}</p>
              {recentPosts[0].data.lesson && (
                <p class="art-hero-lesson"><span class="lesson-arrow">→</span>{recentPosts[0].data.lesson}</p>
              )}
              <p class="art-date">{formatDate(recentPosts[0].data.date)}</p>
              <span class="art-read-more">続きを読む →</span>
            </div>
          </a>
        )}
        <!-- サブリスト -->
        <ul class="art-list" role="list">
          {recentPosts.slice(1, 4).map(post => (
            <li>
              <a href={`/blog/${slug(post.collection, post.id)}/`} class="art-list-item">
                {post.data.ogImage
                  ? <img src={post.data.ogImage} alt="" class="art-list-img" loading="lazy" />
                  : <div class="art-list-img art-list-img--ph" aria-hidden="true"><span>記</span></div>
                }
                <div class="art-list-body">
                  <span class="art-cat">{catLabel[post.data.category] ?? post.data.category}</span>
                  <p class="art-list-title">{post.data.title}</p>
                  <p class="art-date">{formatDate(post.data.date)}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="articles-more">
        <a href="/blog/" class="pill-link">すべての記事を見る →</a>
      </div>
    </div>
  </section>

  <!-- ⑤ PHILOSOPHY -->
  {philosophyPosts.length > 0 && (
    <section class="philosophy reveal">
      <div class="container">
        <p class="eyebrow">PHILOSOPHY</p>
        <div class="phil-head">
          <h2 class="display-heading">哲学の知恵</h2>
          <a href="/philosophy/" class="pill-link">すべて見る →</a>
        </div>
        <p class="phil-sub">仕事・決断・生きる意味——2500年の問いが、今日のあなたに答える。</p>
        <ul class="phil-grid" role="list">
          {philosophyPosts.map(post => (
            <li>
              <a href={`/blog/${slug(post.collection, post.id)}/`} class="phil-card">
                {post.data.ogImage && (
                  <div class="phil-card-img-wrap">
                    <img src={post.data.ogImage} alt={post.data.title} class="phil-card-img" loading="lazy" />
                  </div>
                )}
                <div class="phil-card-body">
                  <span class="phil-card-tag">哲学</span>
                  <p class="phil-card-title">{post.data.title}</p>
                  {post.data.lesson && (
                    <p class="phil-card-lesson">{post.data.lesson}</p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ⑥ AUDIBLE -->
  <section class="audible reveal">
    <div class="container audible-inner">
      <div class="audible-text-wrap">
        <p class="audible-head">📚 通勤中に孫子を聴く。</p>
        <p class="audible-body">戦略書を聴く30分が、明日の判断を変える。30日間無料で体験できる。</p>
      </div>
      <a href={AUDIBLE_URL} target="_blank" rel="nofollow sponsored noopener" class="audible-btn">
        無料で試す →
      </a>
    </div>
  </section>

</BaseLayout>

<!-- ⚡ Lightning -->
<script>
  const canvas = document.getElementById('lightning-canvas') as HTMLCanvasElement | null;
  const flash  = document.getElementById('hero-flash') as HTMLElement | null;
  const title  = document.getElementById('hero-title') as HTMLElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    function resize() {
      canvas!.width  = canvas!.parentElement!.offsetWidth;
      canvas!.height = canvas!.parentElement!.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    function drawBolt(x1: number, y1: number, x2: number, y2: number, depth: number) {
      if (!ctx) return;
      if (depth === 0) { ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke(); return; }
      const dx = x2-x1, dy = y2-y1, len = Math.sqrt(dx*dx+dy*dy);
      const mx = (x1+x2)/2+(Math.random()-0.5)*len*0.45;
      const my = (y1+y2)/2+(Math.random()-0.25)*Math.abs(dy)*0.3;
      drawBolt(x1,y1,mx,my,depth-1); drawBolt(mx,my,x2,y2,depth-1);
      if (depth>2 && Math.random()>0.55) {
        const bx=mx+(Math.random()-0.35)*dx*0.6, by=my+Math.random()*dy*0.5;
        ctx.globalAlpha=0.45; drawBolt(mx,my,bx,by,depth-2); ctx.globalAlpha=1;
      }
    }

    function strike() {
      if (!ctx||!canvas) return;
      const W=canvas.width,H=canvas.height;
      const sx=W*(0.42+Math.random()*0.5), sy=H*(0.04+Math.random()*0.12);
      const ex=sx+(Math.random()-0.5)*W*0.25, ey=H*(0.45+Math.random()*0.35);
      ctx.clearRect(0,0,W,H);
      ctx.strokeStyle='rgba(210,235,255,0.92)'; ctx.lineWidth=1.2;
      ctx.shadowColor='rgba(150,210,255,1)'; ctx.shadowBlur=14; ctx.globalAlpha=1;
      drawBolt(sx,sy,ex,ey,7);
      if (flash) {
        flash.style.transition='none'; flash.style.opacity='0.18';
        setTimeout(()=>{if(flash){flash.style.transition='opacity 0.25s';flash.style.opacity='0';}},120);
        setTimeout(()=>{if(flash){flash.style.transition='none';flash.style.opacity='0.08';}},250);
        setTimeout(()=>{if(flash){flash.style.transition='opacity 0.4s';flash.style.opacity='0';}},350);
      }
      if (title) { title.classList.add('title-flash'); setTimeout(()=>title?.classList.remove('title-flash'),600); }
      setTimeout(()=>{
        if(!ctx||!canvas) return;
        let alpha=1;
        const fade=setInterval(()=>{
          alpha-=0.08; if(alpha<=0){clearInterval(fade);ctx.clearRect(0,0,canvas!.width,canvas!.height);return;}
          ctx.clearRect(0,0,canvas!.width,canvas!.height);ctx.globalAlpha=alpha;
          drawBolt(sx,sy,ex,ey,7);ctx.globalAlpha=1;
        },30);
      },300);
    }

    function scheduleNext(){ setTimeout(()=>{strike();scheduleNext();},5000+Math.random()*10000); }
    setTimeout(()=>{strike();scheduleNext();},2000);
  }
</script>

<!-- Reveal + Stagger + Progress + Embers -->
<script>
  // ── Scroll reveal ──
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); revealObs.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

  // ── Scroll progress bar ──
  const progressBar = document.getElementById('scroll-progress') as HTMLElement | null;
  function updateProgress() {
    if (!progressBar) return;
    const pct = document.documentElement.scrollHeight - window.innerHeight;
    progressBar.style.width = (pct > 0 ? (window.scrollY / pct) * 100 : 0) + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });

  // ── Ember particles ──
  const emberContainer = document.getElementById('ember-container');
  function spawnEmber() {
    if (!emberContainer) return;
    const e = document.createElement('span');
    e.className = 'ember';
    const size = 1.5 + Math.random() * 3;
    const x    = 5 + Math.random() * 90;
    const dur  = 3.5 + Math.random() * 4;
    const drift = (Math.random() - 0.5) * 80;
    e.style.cssText = `left:${x}%;width:${size}px;height:${size}px;--d:${dur}s;--dx:${drift}px`;
    emberContainer.appendChild(e);
    setTimeout(() => e.remove(), (dur + 0.5) * 1000);
  }
  for (let i = 0; i < 10; i++) setTimeout(spawnEmber, i * 180);
  setInterval(spawnEmber, 700);

  // ── Theme rows stagger ──
  const themeRowItems = document.querySelectorAll('.theme-row-item');
  themeRowItems.forEach(el => el.classList.add('stagger-ready'));
  const themeObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      (e.target as HTMLElement).querySelectorAll('.stagger-ready').forEach((item, i) => {
        setTimeout(() => item.classList.add('stagger-in'), i * 80);
      });
      themeObs.unobserve(e.target);
    });
  }, { threshold: 0.05 });
  const themeRowsList = document.querySelector('.theme-rows');
  if (themeRowsList) themeObs.observe(themeRowsList);

  // ── Articles stagger ──
  document.querySelectorAll('.art-hero, .art-list li').forEach(el => el.classList.add('stagger-ready'));
  const artObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      (e.target as HTMLElement).querySelectorAll('.stagger-ready').forEach((item, i) => {
        setTimeout(() => item.classList.add('stagger-in'), i * 90);
      });
      artObs.unobserve(e.target);
    });
  }, { threshold: 0.05 });
  const artGrid = document.querySelector('.articles-grid');
  if (artGrid) artObs.observe(artGrid);

  // ── Philosophy stagger ──
  document.querySelectorAll('.phil-grid > li').forEach(el => el.classList.add('stagger-ready'));
  const philObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      (e.target as HTMLElement).querySelectorAll('.stagger-ready').forEach((item, i) => {
        setTimeout(() => item.classList.add('stagger-in'), i * 110);
      });
      philObs.unobserve(e.target);
    });
  }, { threshold: 0.08 });
  const philGrid = document.querySelector('.phil-grid');
  if (philGrid) philObs.observe(philGrid);
</script>

<style>
  /* ── RESET / UTIL ── */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
  }
  .eyebrow--light { color: var(--gold-light); }
  .display-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.04em;
    margin-bottom: 2.5rem;
    line-height: 1.35;
  }
  .pill-link {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.6rem;
    border: 1.5px solid var(--gold);
    border-radius: 980px;
    color: var(--gold);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.25s, color 0.25s;
  }
  .pill-link:hover { background: var(--gold); color: #fff; }

  /* scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.25,0.46,0.45,0.94),
                transform 0.7s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .reveal.revealed { opacity: 1; transform: translateY(0); }

  /* stagger */
  .stagger-ready {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s cubic-bezier(0.25,0.46,0.45,0.94),
                transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .stagger-ready.stagger-in { opacity: 1; transform: translateY(0); }

  /* progress bar */
  .scroll-progress {
    position: fixed;
    top: 0; left: 0;
    height: 2.5px; width: 0%;
    background: linear-gradient(to right, var(--gold), #a8e4c0, var(--gold-light));
    z-index: 9999;
    pointer-events: none;
    box-shadow: 0 0 8px rgba(59,140,110,0.7);
  }

  /* ── HERO ── */
  .hero {
    position: relative;
    background:
      linear-gradient(to bottom, rgba(5,12,5,0.78) 0%, rgba(5,12,5,0.52) 60%, rgba(5,12,5,0.78) 100%),
      url('/images/header-bg.jpg') center center / cover no-repeat;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .lightning-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none; z-index: 1;
  }
  .hero-flash {
    position: absolute; inset: 0;
    background: rgba(200,230,255,1);
    opacity: 0; pointer-events: none;
    z-index: 2; mix-blend-mode: overlay;
  }
  .ember-container {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 2; overflow: hidden;
  }
  .ember {
    position: absolute; bottom: -4px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #a8e4c0, rgba(59,140,110,0.6));
    box-shadow: 0 0 6px rgba(59,140,110,0.9), 0 0 14px rgba(59,140,110,0.4);
    animation: ember-rise var(--d, 4s) ease-out forwards;
    opacity: 0;
  }
  @keyframes ember-rise {
    0%   { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
    10%  { opacity: 0.85; }
    80%  { opacity: 0.4; }
    100% { transform: translateY(-65vh) translateX(var(--dx, 40px)) scale(0.3); opacity: 0; }
  }
  .hero-inner {
    position: relative; z-index: 3;
    display: flex; flex-direction: column;
    align-items: center; gap: 1.6rem;
    padding: calc(var(--nav-height) + 4rem) 2rem 6rem;
    max-width: 760px; width: 100%;
  }
  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem; font-weight: 700;
    letter-spacing: 0.35em;
    color: var(--gold-light);
    text-transform: uppercase;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 8vw, 5rem);
    font-weight: 700; color: #fff;
    line-height: 1.25; letter-spacing: 0.04em;
    text-shadow: 0 0 60px rgba(59,140,110,0.2);
    transition: text-shadow 0.2s;
    text-wrap: balance; word-break: keep-all; overflow-wrap: anywhere;
  }
  .hero-title.title-flash {
    text-shadow: 0 0 20px rgba(200,230,255,0.7), 0 0 60px rgba(200,230,255,0.35);
  }
  .hero-sub {
    font-family: var(--font-serif);
    font-size: clamp(0.92rem, 2vw, 1.1rem); font-weight: 400;
    color: rgba(255,255,255,0.65);
    letter-spacing: 0.06em; line-height: 1.8;
  }
  .hero-cta {
    display: inline-flex; align-items: center;
    padding: 0.9rem 2.6rem;
    background: var(--gold); color: #fff;
    font-family: var(--font-sans);
    font-size: 0.9rem; font-weight: 600;
    letter-spacing: 0.06em; border-radius: 980px;
    text-decoration: none;
    transition: background 0.25s, transform 0.25s;
    margin-top: 0.4rem;
  }
  .hero-cta:hover { background: var(--gold-dark); transform: scale(1.03); }
  .hero-scroll-hint {
    position: absolute; bottom: 2.2rem; left: 50%;
    transform: translateX(-50%); z-index: 3;
  }
  .hero-scroll-hint span {
    display: block; width: 1px; height: 52px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.4));
    animation: scroll-line 1.8s ease-in-out infinite;
  }
  @keyframes scroll-line {
    0%     { transform: scaleY(0); transform-origin: top; }
    50%    { transform: scaleY(1); transform-origin: top; }
    50.01% { transform-origin: bottom; }
    100%   { transform: scaleY(0); transform-origin: bottom; }
  }

  /* ── TICKER ── */
  .ticker-wrap {
    background: var(--accent);
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.04);
    border-bottom: 1px solid rgba(255,255,255,0.04);
    padding: 0.75rem 0; position: relative;
  }
  .ticker-wrap::before, .ticker-wrap::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 80px;
    z-index: 1; pointer-events: none;
  }
  .ticker-wrap::before { left: 0; background: linear-gradient(to right, var(--accent), transparent); }
  .ticker-wrap::after  { right: 0; background: linear-gradient(to left, var(--accent), transparent); }
  .ticker {
    display: flex; white-space: nowrap; width: max-content;
    animation: ticker-scroll 40s linear infinite;
  }
  .ticker:hover { animation-play-state: paused; }
  .ticker-item {
    font-family: var(--font-sans); font-size: 0.68rem;
    font-weight: 500; letter-spacing: 0.08em;
    color: rgba(255,255,255,0.45); padding: 0 2rem;
  }
  @keyframes ticker-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ── THEMES ── ページの主役 */
  .themes {
    background: var(--accent);
    padding: 6rem 0 5rem;
  }
  .themes-head {
    margin-bottom: 3rem;
  }
  .themes-title {
