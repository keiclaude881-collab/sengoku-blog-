---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCard from "../components/BookCard.astro";
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";
import { THEME_INFO, THEME_ORDER } from "../utils/arcMap";

// 最新記事（全カテゴリ、最新3件）
const ALL_COLLECTIONS = ["battle","world","leader","strategy","whatif","anime","movie","novel","books"] as const;
const allPosts = (await Promise.all(
  ALL_COLLECTIONS.map(c => getCollection(c).catch(() => []))
)).flat().sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentPosts = allPosts.slice(0, 3);

// フィーチャー記事（ogImageがあるdecide記事の最新1件）
const featured = allPosts.find(p => p.data.category === "decide" && p.data.ogImage) ?? allPosts[0];

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, "")}`;
}

const AUDIBLE_URL = "https://af.moshimo.com/af/c/click?a_id=5427522&p_id=170&pc_id=185&pl_id=4062&url=https%3A%2F%2Fwww.amazon.co.jp%2Fftu%2Fhome";

const books = [
  { title: "孫子の兵法（知的生きかた文庫）", asin: "4837900186", reason: "情報戦の原典。戦略思考の基礎が凝縮" },
  { title: "五輪書（宮本武蔵）", asin: "4003300211", reason: "個の強さとは何か。武蔵の戦略哲学" },
  { title: "失敗の本質", asin: "4122018331", reason: "なぜ日本軍は負けたのか。組織論の古典" },
];

const catLabel: Record<string, string> = {
  decide: "決断できない時", lead: "チームがうまくいかない時",
  recover: "逆境・失敗した時", strategy: "戦略・方向性に迷った時",
  change: "自分を変えたい時", books: "書籍レビュー",
  movie: "映画の知恵", anime: "アニメの知恵", novel: "小説・物語",
};

function formatDate(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout
  title="決断の系譜 | 500年前の武将の知恵が、今日の答えになる。"
  description="決断できない夜に、武将の記録が答えをくれる。月曜日の悩みに、500年前の戦国武将が答える日本史ビジネスブログ。"
>

  <!-- ①  H E R O -->
  <section class="hero">
    <canvas class="lightning-canvas" id="lightning-canvas" aria-hidden="true"></canvas>
    <div class="hero-flash" id="hero-flash" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="hero-eyebrow">決断の系譜</p>
      <h1 class="hero-title" id="hero-title">武将の知恵が、今日の答えになる。</h1>
      <p class="hero-sub">500年前の決断から、あなたの悩みを解く。</p>
      <a href="/blog/" class="hero-cta">記事を読む</a>
    </div>
    <div class="hero-scroll-hint" aria-hidden="true">
      <span></span>
    </div>
  </section>

  <!-- ②  C A T E G O R Y  G R I D -->
  <section class="themes reveal">
    <div class="container">
      <p class="eyebrow">THEMES</p>
      <h2 class="display-heading">あなたの悩みから探す</h2>
      <ul class="theme-grid" role="list">
        {THEME_ORDER.map((slug, i) => {
          const t = THEME_INFO[slug];
          const num = String(i + 1).padStart(2, '0');
          return (
            <li>
              <a href={`/category/${slug}/`} class="theme-card">
                <span class="theme-num" aria-hidden="true">{num}</span>
                <span class="theme-icon" aria-hidden="true">{t.icon}</span>
                <strong class="theme-label">{t.label}</strong>
                <span class="theme-tagline">{t.tagline}</span>
                <span class="theme-arrow" aria-hidden="true">記事を見る →</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ③  F E A T U R E  S P O T L I G H T -->
  {featured && (
    <section class="spotlight reveal">
      <div class="spotlight-inner container">
        <div class="spotlight-text">
          <p class="eyebrow eyebrow--light">FEATURED</p>
          <h2 class="spotlight-title">{featured.data.title}</h2>
          <p class="spotlight-desc">{featured.data.description}</p>
          <a href={`/blog/${slug(featured.collection, featured.id)}/`} class="spotlight-cta">
            記事を読む →
          </a>
        </div>
        {featured.data.ogImage && (
          <div class="spotlight-img-wrap">
            <img
              src={featured.data.ogImage}
              alt={featured.data.title}
              class="spotlight-img"
              loading="lazy"
            />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ④  R E C E N T  A R T I C L E S -->
  <section class="recent reveal">
    <div class="container">
      <p class="eyebrow">LATEST</p>
      <h2 class="display-heading">最新記事</h2>
      <ul class="recent-grid" role="list">
        {recentPosts.map(post => (
          <li>
            <a href={`/blog/${slug(post.collection, post.id)}/`} class="recent-card">
              {post.data.ogImage
                ? <img src={post.data.ogImage} alt="" class="recent-card-img" loading="lazy" />
                : <div class="recent-card-img recent-card-img--placeholder" aria-hidden="true">
                    <span>{THEME_INFO[post.data.category as keyof typeof THEME_INFO]?.icon ?? "記"}</span>
                  </div>
              }
              <div class="recent-card-body">
                <span class="recent-cat">{catLabel[post.data.category] ?? post.data.category}</span>
                <p class="recent-title">{post.data.title}</p>
                <p class="recent-date">{formatDate(post.data.date)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div class="recent-more">
        <a href="/blog/" class="pill-link">すべての記事を見る →</a>
      </div>
    </div>
  </section>

  <!-- ⑤  M A N I F E S T O -->
  <section class="manifesto reveal">
    <div class="container manifesto-inner">
      <blockquote class="manifesto-quote">
        <p>迷いながらも動いた。<br>負けながらも立った。</p>
        <p class="manifesto-quote-2">その記録の中に、<br>あなたへの答えがある。</p>
      </blockquote>
    </div>
  </section>

  <!-- ⑥  A U D I B L E -->
  <section class="audible reveal">
    <div class="container audible-inner">
      <div class="audible-text-wrap">
        <p class="audible-head">📚 通勤中に孫子を聴く。</p>
        <p class="audible-body">戦略書を聴く30分が、明日の判断を変える。30日間無料で体験できる。</p>
      </div>
      <a href={AUDIBLE_URL} target="_blank" rel="nofollow sponsored noopener" class="audible-btn">
        無料で試す →
      </a>
    </div>
  </section>

  <!-- ⑦  B O O K S -->
  <section class="books reveal">
    <div class="container">
      <p class="eyebrow">BOOKS</p>
      <h2 class="display-heading">あわせて読みたい</h2>
      <AffiliateDisclosure />
      <div class="book-grid">
        {books.map(b => (
          <BookCard title={b.title} asin={b.asin} reason={b.reason} />
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<!-- Lightning script (hero) -->
<script>
  const canvas = document.getElementById('lightning-canvas') as HTMLCanvasElement | null;
  const flash  = document.getElementById('hero-flash') as HTMLElement | null;
  const title  = document.getElementById('hero-title') as HTMLElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    function resize() {
      canvas!.width  = canvas!.parentElement!.offsetWidth;
      canvas!.height = canvas!.parentElement!.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    function drawBolt(x1: number, y1: number, x2: number, y2: number, depth: number) {
      if (!ctx) return;
      if (depth === 0) { ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke(); return; }
      const dx = x2-x1, dy = y2-y1, len = Math.sqrt(dx*dx+dy*dy);
      const mx = (x1+x2)/2+(Math.random()-0.5)*len*0.45;
      const my = (y1+y2)/2+(Math.random()-0.25)*Math.abs(dy)*0.3;
      drawBolt(x1,y1,mx,my,depth-1); drawBolt(mx,my,x2,y2,depth-1);
      if (depth>2 && Math.random()>0.55) {
        const bx=mx+(Math.random()-0.35)*dx*0.6, by=my+Math.random()*dy*0.5;
        ctx.globalAlpha=0.45; drawBolt(mx,my,bx,by,depth-2); ctx.globalAlpha=1;
      }
    }

    function strike() {
      if (!ctx||!canvas) return;
      const W=canvas.width,H=canvas.height;
      const sx=W*(0.42+Math.random()*0.5), sy=H*(0.04+Math.random()*0.12);
      const ex=sx+(Math.random()-0.5)*W*0.25, ey=H*(0.45+Math.random()*0.35);
      ctx.clearRect(0,0,W,H);
      ctx.strokeStyle='rgba(210,235,255,0.92)'; ctx.lineWidth=1.2;
      ctx.shadowColor='rgba(150,210,255,1)'; ctx.shadowBlur=14; ctx.globalAlpha=1;
      drawBolt(sx,sy,ex,ey,7);
      if (flash) {
        flash.style.transition='none'; flash.style.opacity='0.18';
        setTimeout(()=>{if(flash){flash.style.transition='opacity 0.25s';flash.style.opacity='0';}},120);
        setTimeout(()=>{if(flash){flash.style.transition='none';flash.style.opacity='0.08';}},250);
        setTimeout(()=>{if(flash){flash.style.transition='opacity 0.4s';flash.style.opacity='0';}},350);
      }
      if (title) { title.classList.add('title-flash'); setTimeout(()=>title?.classList.remove('title-flash'),600); }
      setTimeout(()=>{
        if(!ctx||!canvas) return;
        let alpha=1;
        const fade=setInterval(()=>{
          alpha-=0.08; if(alpha<=0){clearInterval(fade);ctx.clearRect(0,0,canvas!.width,canvas!.height);return;}
          ctx.clearRect(0,0,canvas!.width,canvas!.height);ctx.globalAlpha=alpha;
          drawBolt(sx,sy,ex,ey,7);ctx.globalAlpha=1;
        },30);
      },300);
    }

    function scheduleNext(){ setTimeout(()=>{strike();scheduleNext();},5000+Math.random()*10000); }
    setTimeout(()=>{strike();scheduleNext();},2000);
  }
</script>

<!-- Scroll reveal -->
<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

<style>
  /* ── UTILITIES ── */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
  }

  .eyebrow--light { color: var(--gold-light); }

  .display-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.04em;
    margin-bottom: 3rem;
    line-height: 1.35;
  }

  /* pill link */
  .pill-link {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.6rem;
    border: 1.5px solid var(--gold);
    border-radius: 980px;
    color: var(--gold);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.25s, color 0.25s;
  }
  .pill-link:hover { background: var(--gold); color: #fff; }

  /* scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .reveal.revealed { opacity: 1; transform: translateY(0); }

  /* ── ① HERO ── */
  .hero {
    position: relative;
    background:
      linear-gradient(to bottom, rgba(5,12,5,0.78) 0%, rgba(5,12,5,0.52) 60%, rgba(5,12,5,0.78) 100%),
      url('/images/header-bg.jpg') center center / cover no-repeat;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .lightning-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none; z-index: 1;
  }

  .hero-flash {
    position: absolute; inset: 0;
    background: rgba(200,230,255,1);
    opacity: 0; pointer-events: none;
    z-index: 2; mix-blend-mode: overlay;
  }

  .hero-inner {
    position: relative; z-index: 3;
    display: flex; flex-direction: column;
    align-items: center; gap: 1.6rem;
    padding: calc(var(--nav-height) + 4rem) 2rem 6rem;
    max-width: 760px;
    width: 100%;
  }

  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    color: var(--gold-light);
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 8vw, 5rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-shadow: 0 0 60px rgba(59,140,110,0.2);
    transition: text-shadow 0.2s;
    text-wrap: balance;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .hero-title.title-flash {
    text-shadow: 0 0 20px rgba(200,230,255,0.7), 0 0 60px rgba(200,230,255,0.35);
  }

  .hero-sub {
    font-family: var(--font-serif);
    font-size: clamp(0.92rem, 2vw, 1.1rem);
    font-weight: 400;
    color: rgba(255,255,255,0.65);
    letter-spacing: 0.06em;
    line-height: 1.8;
  }

  .hero-cta {
    display: inline-flex; align-items: center;
    padding: 0.9rem 2.6rem;
    background: var(--gold);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.9rem; font-weight: 600;
    letter-spacing: 0.06em;
    border-radius: 980px;
    text-decoration: none;
    transition: background 0.25s, transform 0.25s;
    margin-top: 0.4rem;
  }
  .hero-cta:hover { background: var(--gold-dark); transform: scale(1.03); }

  /* scroll hint */
  .hero-scroll-hint {
    position: absolute; bottom: 2.2rem; left: 50%; transform: translateX(-50%);
    z-index: 3;
  }
  .hero-scroll-hint span {
    display: block; width: 1px; height: 52px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.4));
    animation: scroll-line 1.8s ease-in-out infinite;
  }
  @keyframes scroll-line {
    0%   { transform: scaleY(0); transform-origin: top; }
    50%  { transform: scaleY(1); transform-origin: top; }
    50.01% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* ── ② THEMES ── */
  .themes {
    background: var(--bg);
    padding: 8rem 0;
    border-bottom: 1px solid var(--rule);
  }

  /* Flex layout — 5 items wrap & center. No empty cell at any width. */
  .theme-grid {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
  }

  .theme-grid > li {
    flex: 1 1 calc(20% - 1.2rem);
    min-width: 150px;
    max-width: 260px;
  }

  .theme-card {
    display: flex;
    flex-direction: column;
    padding: 1.8rem 1.4rem 1.5rem;
    height: 100%;
    background: var(--bg);
    border: 1.5px solid var(--rule);
    border-radius: 14px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }
  .theme-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--gold);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .theme-card:hover {
    border-color: var(--gold);
    box-shadow: 0 10px 36px rgba(59,140,110,0.11);
    transform: translateY(-3px);
  }
  .theme-card:hover::before { opacity: 1; }
  .theme-card:hover .theme-arrow { opacity: 1; transform: translateX(0); }

  .theme-num {
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--ink3);
    display: block;
    margin-bottom: 1.2rem;
  }

  .theme-icon {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    color: var(--gold);
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
  }

  .theme-label {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.03em;
    line-height: 1.5;
    display: block;
    margin-bottom: 0.6rem;
  }

  .theme-tagline {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink3);
    line-height: 1.7;
    flex: 1;
    display: block;
  }

  .theme-arrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--gold);
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity 0.2s, transform 0.2s;
    margin-top: 1.2rem;
    display: block;
  }

  /* ── ③ SPOTLIGHT ── */
  .spotlight {
    background: var(--accent);
    padding: 8rem 0;
  }

  .spotlight-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .spotlight-title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
    letter-spacing: 0.03em;
    margin-bottom: 1.2rem;
  }

  .spotlight-desc {
    font-family: var(--font-sans);
    font-size: 0.9rem; line-height: 1.9;
    color: rgba(255,255,255,0.6);
    margin-bottom: 2rem;
    max-width: 480px;
  }

  .spotlight-cta {
    display: inline-flex; align-items: center;
    padding: 0.8rem 2rem;
    border: 1.5px solid rgba(255,255,255,0.5);
    border-radius: 980px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.84rem; font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .spotlight-cta:hover { border-color: var(--gold-light); background: rgba(255,255,255,0.06); }

  .spotlight-img-wrap {
    border-radius: 12px; overflow: hidden;
    box-shadow: 0 32px 64px rgba(0,0,0,0.4);
    aspect-ratio: 4/3;
  }
  .spotlight-img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .spotlight-img-wrap:hover .spotlight-img { transform: scale(1.03); }

  /* ── ④ RECENT ── */
  .recent {
    background: var(--bg);
    padding: 8rem 0;
  }

  .recent-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .recent-card {
    display: flex; flex-direction: column;
    border-radius: 12px; overflow: hidden;
    border: 1px solid var(--rule);
    text-decoration: none; color: inherit;
    background: var(--bg);
    transition: box-shadow 0.3s, transform 0.3s;
  }
  .recent-card:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.1);
    transform: translateY(-4px);
  }

  .recent-card-img {
    width: 100%; aspect-ratio: 16/10;
    object-fit: cover; display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .recent-card:hover .recent-card-img { transform: scale(1.04); }

  .recent-card-img--placeholder {
    background: var(--accent);
    display: flex; align-items: center; justify-content: center;
  }
  .recent-card-img--placeholder span {
    font-family: var(--font-serif);
    font-size: 3rem; color: rgba(255,255,255,0.25);
  }

  .recent-card-body {
    padding: 1.4rem 1.4rem 1.6rem;
    display: flex; flex-direction: column; gap: 0.5rem;
    flex: 1;
  }

  .recent-cat {
    font-family: var(--font-sans);
    font-size: 0.6rem; font-weight: 700;
    letter-spacing: 0.18em; color: var(--gold);
    text-transform: uppercase;
  }

  .recent-title {
    font-family: var(--font-serif);
    font-size: 0.92rem; font-weight: 700;
    color: var(--ink); line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recent-date {
    font-family: var(--font-sans);
    font-size: 0.68rem; color: var(--ink3);
    margin-top: auto;
  }

  .recent-more { text-align: center; }

  /* ── ⑤ MANIFESTO ── */
  .manifesto {
    background: #000;
    padding: 9rem 0;
  }

  .manifesto-inner { text-align: center; }

  .manifesto-quote {
    font-style: normal;
  }

  .manifesto-quote p {
    font-family: var(--font-serif);
