---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const LABELS: Record<string, string> = {
  money:   "投資・お金",
  career:  "仕事・副業",
  mindset: "思考法",
};

function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}

const featured    = allPosts.find(p => p.data.featured) ?? allPosts[0];
const heroImages  = allPosts.filter(p => p.data.ogImage).slice(0, 3);

const CATS = [
  { key: "money",   label: "投資・お金", href: "/money/",   accent: "#fef3c7", color: "#92400e", border: "#fde68a", num: "① " },
  { key: "career",  label: "仕事・副業", href: "/career/",  accent: "#dbeafe", color: "#1e40af", border: "#bfdbfe", num: "② " },
  { key: "mindset", label: "思考法",     href: "/mindset/", accent: "#f3e8ff", color: "#6b21a8", border: "#e9d5ff", num: "③ " },
];
const catPosts = CATS.map(c => ({
  ...c,
  posts: allPosts.filter(p => p.id !== featured.id && p.data.category === c.key).slice(0, 3),
}));
---

<BaseLayout
  title="偉人ラボ | 偉人の思考で現代のお金と仕事を攻略する"
  description="孫子・ナポレオン・マルクス・アウレリウス——偉人たちの思考法を、投資・副業・キャリアに応用する実践的ブログ。"
>

<!-- ═══ MASTHEAD ══════════════════════════════════════════ -->
<section class="masthead">
  <div class="masthead-inner">
    <div class="masthead-text">
      <p class="masthead-eyebrow">偉人ラボ</p>
      <h1 class="masthead-heading">偉人の思考で、<br/>現代のお金と仕事を攻略する</h1>
      <p class="masthead-desc">孫子・ナポレオン・マルクス・アウレリウス——時代を超えた知恵を、投資・副業・キャリアに応用する。</p>
      <div class="masthead-cats">
        <a href="/money/"   class="cat-pill cat-pill--money">投資・お金</a>
        <a href="/career/"  class="cat-pill cat-pill--career">仕事・副業</a>
        <a href="/mindset/" class="cat-pill cat-pill--mindset">思考法</a>
      </div>
    </div>
    <div class="masthead-visual" aria-hidden="true">
      {heroImages.map((p, i) => (
        <div class={`mast-card mast-card--${i}`}>
          <img src={p.data.ogImage!} alt="" />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ FEATURED ══════════════════════════════════════════ -->
{featured && (
  <section class="featured">
    <div class="featured-inner">
      <a href={`/blog/${featured.id.replace(/\.mdx?$/, '')}/`} class="featured-card">
        <div class="featured-img-wrap">
          {featured.data.ogImage
            ? <img src={featured.data.ogImage} alt={featured.data.title} class="featured-img" />
            : <div class="featured-img-empty" />
          }
        </div>
        <div class="featured-body">
          <span class={`feat-cat feat-cat--${featured.data.category}`}>
            {LABELS[featured.data.category]}
          </span>
          <h2 class="feat-title">{featured.data.title}</h2>
          {featured.data.description && <p class="feat-desc">{featured.data.description}</p>}
          <div class="feat-foot">
            <time class="feat-date">{fmt(featured.data.date)}</time>
            <span class="feat-cta">読む <span class="feat-arrow">→</span></span>
          </div>
        </div>
      </a>
    </div>
  </section>
)}

<!-- ═══ CATEGORY BLOCKS ═════════════════════════════════════ -->
<section class="cat-section">
  <div class="cat-wrap">
    {catPosts.map(c => (
      <div class="cat-block" style={`background:${c.accent};border-color:${c.border};`}>
        <div class="cat-block-head">
          <span class="cat-block-label" style={`color:${c.color};`}>{c.label}</span>
          <a href={c.href} class="cat-block-more" style={`color:${c.color};`}>すべて見る →</a>
        </div>
        <ol class="cat-block-list">
          {c.posts.map(p => (
            <li>
              <a href={`/blog/${p.id.replace(/\.mdx?$/, '')}/`} class="cat-block-link" style={`--c:${c.color};`}>
                <span class="cat-block-title">{p.data.title}</span>
                <time class="cat-block-date">{fmt(p.data.date)}</time>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</section>

</BaseLayout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      el.classList.add('is-visible');
      observer.unobserve(el);
    });
  }, { threshold: 0.1 });

  document.querySelectorAll<HTMLElement>('.cat-block').forEach(el => observer.observe(el));
</script>

<style>
/* ── ANIMATIONS ── */
@keyframes float-0 {
  0%, 100% { transform: rotate(2deg) translateY(0); }
  50%       { transform: rotate(2deg) translateY(-14px); }
}
@keyframes float-1 {
  0%, 100% { transform: rotate(-2deg) translateY(0); }
  50%       { transform: rotate(-2deg) translateY(-18px); }
}
@keyframes float-2 {
  0%, 100% { transform: rotate(0.8deg) translateY(0); }
  50%       { transform: rotate(0.8deg) translateY(-10px); }
}
@keyframes ken-burns {
  from { transform: scale(1.06); }
  to   { transform: scale(1); }
}

/* ── MASTHEAD ── */
.masthead {
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--border);
  background-image: radial-gradient(circle, var(--border) 1.2px, transparent 1.2px);
  background-size: 22px 22px;
}
.masthead-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 3rem;
}
.masthead-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 1.2rem;
}
.masthead-heading {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 1.2rem;
  letter-spacing: -0.02em;
}
.masthead-desc {
  font-size: clamp(0.9rem, 1.6vw, 1.05rem);
  line-height: 1.85;
  color: var(--ink2);
  max-width: 520px;
  margin-bottom: 2rem;
}
.masthead-cats {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}

/* floating OGP collage */
.masthead-visual {
  position: relative;
  height: 300px;
}
.mast-card {
  position: absolute;
  width: 250px;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 16px 48px rgba(28,25,23,0.14);
}
.mast-card img { width: 100%; display: block; }
.mast-card--0 {
  top: 10px; right: 0; z-index: 3;
  animation: float-0 4s ease-in-out infinite;
}
.mast-card--1 {
  top: 55px; right: 56px; z-index: 2;
  animation: float-1 5.5s ease-in-out infinite;
}
.mast-card--2 {
  top: 100px; right: 112px; z-index: 1;
  animation: float-2 7s ease-in-out infinite;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 0.4rem 0.9rem;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.15s;
  border: 1px solid transparent;
}
.cat-pill:hover { opacity: 0.75; }
.cat-pill--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.cat-pill--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.cat-pill--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

/* ── FEATURED ── */
.featured {
  padding: 56px 0;
  border-bottom: 1px solid var(--border);
}
.featured-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.featured-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 52px;
  align-items: center;
  text-decoration: none;
  color: inherit;
}
.featured-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
}
.featured-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  animation: ken-burns 6s ease-out forwards;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.featured-card:hover .featured-img {
  animation: none;
  transform: scale(1.04);
}
.featured-img-empty { width: 100%; height: 100%; background: var(--bg3); }

.feat-cat {
  display: inline-flex;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
  text-decoration: none;
  margin-bottom: 1rem;
  border: 1px solid transparent;
}
.feat-cat--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.feat-cat--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.feat-cat--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

.feat-title {
  font-family: var(--font-serif);
  font-size: clamp(1.25rem, 2.5vw, 1.85rem);
  font-weight: 700;
  line-height: 1.5;
  color: var(--ink);
  margin-bottom: 1rem;
}
.feat-desc {
  font-size: 0.9rem;
  line-height: 1.85;
  color: var(--ink2);
  margin-bottom: 1.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.feat-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.feat-date { font-size: 0.73rem; color: var(--ink3); }
.feat-cta {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.06em;
}
.feat-arrow {
  display: inline-block;
  transition: transform 0.2s ease;
}
.featured-card:hover .feat-arrow { transform: translateX(4px); }

/* ── CATEGORY BLOCKS ── */
.cat-section { padding: 56px 0 88px; }
.cat-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.cat-block {
  border: 1px solid;
  border-radius: var(--radius);
  padding: 1.6rem 1.5rem;
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.45s ease, transform 0.45s ease;
}
.cat-block.is-visible { opacity: 1; transform: translateY(0); }
.cat-block:nth-child(2) { transition-delay: 0.1s; }
.cat-block:nth-child(3) { transition-delay: 0.2s; }

.cat-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.2rem;
}
.cat-block-label {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}
.cat-block-more {
  font-size: 0.72rem;
  font-weight: 600;
  text-decoration: none;
  opacity: 0.75;
  transition: opacity 0.15s;
}
.cat-block-more:hover { opacity: 1; }

.cat-block-list {
  list-style: none;
  margin: 0; padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.cat-block-list li + li {
  border-top: 1px solid rgba(0,0,0,0.07);
}
.cat-block-link {
  display: block;
  text-decoration: none;
  padding: 0.75rem 0;
  transition: opacity 0.15s;
}
.cat-block-link:hover { opacity: 0.7; }
.cat-block-title {
  display: block;
  font-family: var(--font-serif);
  font-size: 0.86rem;
  font-weight: 700;
  line-height: 1.55;
  color: var(--ink);
  margin-bottom: 0.2rem;
}
.cat-block-date {
  font-size: 0.68rem;
  color: var(--ink3);
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .cat-wrap { grid-template-columns: 1fr; gap: 16px; }
  .featured-card { gap: 32px; }
  .mast-card { width: 200px; }
}
@media (max-width: 768px) {
  .masthead-inner { grid-template-columns: 1fr; }
  /* show single OGP image below text on mobile */
  .masthead-visual {
    position: relative;
    height: auto;
    margin-top: 1.5rem;
  }
  .mast-card {
    position: relative;
    width: 100%;
    animation: none !important;
    transform: none !important;
    box-shadow: 0 8px 24px rgba(28,25,23,0.12);
  }
  .mast-card--1,
  .mast-card--2 { display: none; }
}
@media (max-width: 680px) {
  .featured-card { grid-template-columns: 1fr; gap: 24px; }
  .masthead, .featured { padding: 40px 0; }
  .cat-section { padding: 40px 0 64px; }
}
@media (max-width: 480px) {
  .masthead-inner, .featured-inner, .cat-wrap { padding: 0 1rem; }
}
</style>
