---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

type Post = {
  id: string;
  col: string;
  data: { title: string; date: Date; description?: string; ogImage?: string; };
};

const allPosts: Post[] = (await Promise.all([
  getCollection("whatif").then(p => p.map(x => ({ ...x, col: "whatif" }))).catch(() => []),
  getCollection("philosophy").then(p => p.map(x => ({ ...x, col: "philosophy" }))).catch(() => []),
])).flat().sort((a: Post, b: Post) => b.data.date.getTime() - a.data.date.getTime());

function href(col: string, id: string) {
  return `/blog/${col}/${id.replace(/\.mdx?$/, "")}/`;
}
function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}
function label(col: string) { return col === "whatif" ? "もしも歴史" : "哲学"; }

const featured = allPosts[0];
const recent   = allPosts.slice(1, 7);
const rest     = allPosts.slice(7);
---

<BaseLayout
  title="偉人ラボ | 歴史の偉人が現代の問題を解決する"
  description="信長・ナポレオン・孫子・龍馬——歴史の偉人たちが現代のあなたの悩みに答える。"
>

<!-- ═══ MASTHEAD ══════════════════════════════════════════ -->
<section class="masthead">
  <div class="masthead-inner">
    <p class="masthead-eyebrow">偉人ラボ</p>
    <h1 class="masthead-heading">歴史の偉人が、<br/>現代の問題を解決する</h1>
    <p class="masthead-desc">信長・ナポレオン・孫子・龍馬——時代を超えた知恵を、今日の悩みに。</p>
  </div>
</section>

<!-- ═══ FEATURED ══════════════════════════════════════════ -->
{featured && (
  <section class="featured">
    <div class="featured-inner">
      <a href={href(featured.col, featured.id)} class="featured-card">
        <div class="featured-img-wrap">
          {featured.data.ogImage
            ? <img src={featured.data.ogImage} alt={featured.data.title} class="featured-img" />
            : <div class="featured-img-empty" />
          }
        </div>
        <div class="featured-body">
          <p class="feat-label">{label(featured.col)}</p>
          <h2 class="feat-title">{featured.data.title}</h2>
          {featured.data.description && <p class="feat-desc">{featured.data.description}</p>}
          <div class="feat-foot">
            <time class="feat-date">{fmt(featured.data.date)}</time>
            <span class="feat-cta">読む <span class="feat-arrow">→</span></span>
          </div>
        </div>
      </a>
    </div>
  </section>
)}

<!-- ═══ RECENT GRID ════════════════════════════════════════ -->
<section class="recent">
  <div class="section-wrap">
    <div class="section-header">
      <h2 class="section-title">最近の記事</h2>
      <a href="/blog/" class="section-more">すべて見る →</a>
    </div>
    <ul class="card-grid">
      {recent.map(p => (
        <li class="card fade-in">
          <a href={href(p.col, p.id)} class="card-link">
            <div class="card-img-wrap">
              {p.data.ogImage
                ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="card-img" />
                : <div class="card-img-empty" />
              }
            </div>
            <div class="card-body">
              <span class="card-cat">{label(p.col)}</span>
              <h3 class="card-title">{p.data.title}</h3>
              {p.data.description && <p class="card-desc">{p.data.description}</p>}
              <time class="card-date">{fmt(p.data.date)}</time>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ═══ ARTICLE LIST ═════════════════════════════════════════ -->
{rest.length > 0 && (
  <section class="list-section">
    <div class="section-wrap">
      <div class="section-header">
        <h2 class="section-title">もっと読む</h2>
      </div>
      <ul class="article-list" id="article-list">
        {rest.map((p, i) => (
          <li class={`article-item fade-in${i >= 10 ? " js-hidden" : ""}`}>
            <a href={href(p.col, p.id)} class="article-link">
              <span class="article-cat">{label(p.col)}</span>
              <span class="article-title">{p.data.title}</span>
              <time class="article-date">{fmt(p.data.date)}</time>
            </a>
          </li>
        ))}
      </ul>
      {rest.length > 10 && (
        <div class="show-more-wrap" id="show-more-wrap">
          <button id="show-more-btn" class="show-more-btn">もっと読む</button>
        </div>
      )}
    </div>
  </section>
)}

</BaseLayout>

<script>
  document.getElementById('show-more-btn')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.js-hidden').forEach(el => {
      el.classList.remove('js-hidden');
    });
    document.getElementById('show-more-wrap')?.remove();
  });
</script>

<style>
/* ── MASTHEAD ── */
.masthead {
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--border);
}
.masthead-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.masthead-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 1.2rem;
}
.masthead-heading {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 1.2rem;
  letter-spacing: -0.02em;
}
.masthead-desc {
  font-size: clamp(0.9rem, 1.6vw, 1.05rem);
  line-height: 1.85;
  color: var(--ink2);
  max-width: 440px;
}

/* ── FEATURED ── */
.featured {
  padding: 56px 0;
  border-bottom: 1px solid var(--border);
}
.featured-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}
.featured-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 52px;
  align-items: center;
  text-decoration: none;
  color: inherit;
}
.featured-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 4 / 3;
  background: var(--bg2);
}
.featured-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.featured-card:hover .featured-img { transform: scale(1.04); }
.featured-img-empty {
  width: 100%;
  height: 100%;
  background: var(--bg3);
}
.feat-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 1rem;
}
.feat-title {
  font-family: var(--font-serif);
  font-size: clamp(1.25rem, 2.5vw, 1.85rem);
  font-weight: 700;
  line-height: 1.5;
  color: var(--ink);
  margin-bottom: 1rem;
}
.feat-desc {
  font-size: 0.9rem;
  line-height: 1.85;
  color: var(--ink2);
  margin-bottom: 1.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.feat-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.feat-date {
  font-size: 0.73rem;
  color: var(--ink3);
}
.feat-cta {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.06em;
}
.feat-arrow {
  display: inline-block;
  transition: transform 0.2s ease;
}
.featured-card:hover .feat-arrow { transform: translateX(4px); }

/* ── SHARED SECTION WRAPPER ── */
.section-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem;
}

/* ── RECENT GRID ── */
.recent {
  padding: 56px 0;
  border-bottom: 1px solid var(--border);
}
.card-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 36px 28px;
}
.card-link {
  display: block;
  text-decoration: none;
  color: inherit;
}
.card-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
  margin-bottom: 1rem;
}
.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.5s ease;
}
.card-link:hover .card-img { transform: scale(1.04); }
.card-img-empty { width: 100%; height: 100%; background: var(--bg3); }
.card-cat {
  display: block;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 0.5rem;
}
.card-title {
  font-family: var(--font-serif);
  font-size: clamp(0.92rem, 1.4vw, 1.05rem);
  font-weight: 700;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 0.5rem;
  transition: color 0.2s;
}
.card-link:hover .card-title { color: var(--ink2); }
.card-desc {
  font-size: 0.8rem;
  line-height: 1.75;
  color: var(--ink2);
  margin-bottom: 0.6rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-date {
  font-size: 0.7rem;
  color: var(--ink3);
}

/* ── ARTICLE LIST ── */
.list-section {
  padding: 56px 0 88px;
}
.article-list { list-style: none; }
.article-item {
  border-top: 1px solid var(--border);
}
.article-item:last-of-type { border-bottom: 1px solid var(--border); }
.article-item.js-hidden { display: none; }
.article-link {
  display: grid;
  grid-template-columns: 88px 1fr auto;
  gap: 20px;
  align-items: center;
  padding: 18px 0;
  text-decoration: none;
  color: inherit;
  transition: opacity 0.15s;
}
.article-link:hover { opacity: 0.6; }
.article-cat {
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink3);
}
.article-title {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.5;
}
.article-date {
  font-size: 0.7rem;
  color: var(--ink3);
  white-space: nowrap;
}

/* ── SHOW MORE ── */
.show-more-wrap {
  display: flex;
  justify-content: center;
  padding-top: 44px;
}
.show-more-btn {
  font-family: inherit;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--ink);
  background: transparent;
  border: 1px solid var(--border-mid);
  padding: 13px 52px;
  cursor: pointer;
  border-radius: var(--radius);
  transition: background 0.2s, border-color 0.2s;
}
.show-more-btn:hover {
  background: var(--bg2);
  border-color: var(--ink3);
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .card-grid { grid-template-columns: repeat(2, 1fr); }
  .featured-card { gap: 32px; }
}
@media (max-width: 680px) {
  .featured-card {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .masthead { padding: 48px 0 40px; }
  .featured,
  .recent { padding: 40px 0; }
  .list-section { padding: 40px 0 64px; }
}
@media (max-width: 540px) {
  .card-grid { grid-template-columns: 1fr; }
  .article-link { grid-template-columns: 1fr; gap: 4px; }
  .article-date { display: none; }
}
@media (max-width: 480px) {
  .masthead-inner,
  .featured-inner,
  .section-wrap { padding: 0 1rem; }
}
</style>
