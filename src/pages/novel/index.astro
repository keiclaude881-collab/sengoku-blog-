---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MovieCard from "../../components/MovieCard.astro";

const novels = (await getCollection("novel"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function slug(id: string) {
  return `novel/${id.replace(/\.mdx?$/, "")}`;
}

const AUTHORS = [
  { name: "司馬遼太郎", en: "Ryotaro Shiba", tagline: "国盗り・龍馬・坂の上の雲" },
  { name: "吉川英治", en: "Eiji Yoshikawa", tagline: "宮本武蔵・三国志" },
  { name: "山岡荘八", en: "Souhachi Yamaoka", tagline: "徳川家康" },
  { name: "海音寺潮五郎", en: "Chogoroh Kaionji", tagline: "武将列伝" },
];
---

<BaseLayout
  title="歴史小説で学ぶ戦略 | 決断の系譜"
  description={`司馬遼太郎・吉川英治が描いた武将の選択——歴史小説の中に戦略の本質がある。龍馬・武蔵・坂の上の雲ほか全${novels.length}作品。`}
  ogImage="https://upload.wikimedia.org/wikipedia/commons/4/4c/Sakamoto_Ryoma.jpg"
>
  <!-- ヒーロー -->
  <section class="novel-hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="hero-label">HISTORICAL NOVEL &amp; STRATEGY</span>
      <h1 class="hero-heading">歴史小説で学ぶ<br />戦略の本質</h1>
      <p class="hero-sub">
        龍馬の行動力、武蔵の哲学、秋山兄弟の合理精神——<br />
        司馬遼太郎・吉川英治が描いた人物に、現代ビジネスの答えがある。
      </p>
    </div>
  </section>

  <!-- 著者ナビ -->
  <section class="authors-section">
    <div class="container">
      <p class="nav-label">著者で探す</p>
      <ul class="authors-nav" role="list">
        {AUTHORS.map(a => (
          <li>
            <div class="author-chip">
              <span class="chip-name">{a.name}</span>
              <span class="chip-en">{a.en}</span>
              <span class="chip-tagline">{a.tagline}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 作品一覧 -->
  <section class="novel-section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">全{novels.length}作品</h2>
        <p class="section-sub">各記事の末尾に関連書籍・Audibleリンクあり</p>
      </div>

      <ul class="novel-grid" role="list">
        {novels.map(n => (
          <li>
            <MovieCard
              title={n.data.title}
              description={n.data.description}
              lesson={n.data.lesson}
              slug={slug(n.id)}
              ogImage={n.data.ogImage}
              tags={n.data.tags}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── ヒーロー ── */
  .novel-hero {
    position: relative;
    background: #0f0c08;
    padding: calc(var(--nav-height) + 4rem) 0 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 70% 30%, rgba(184, 134, 60, 0.10) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 20% 80%, rgba(59, 140, 110, 0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .hero-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #c8a96e;
    text-transform: uppercase;
  }

  .hero-heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    color: #f0ede8;
    line-height: 1.3;
    letter-spacing: 0.05em;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: #8a8778;
    line-height: 1.8;
    max-width: 520px;
  }

  /* ── 著者ナビ ── */
  .authors-section {
    background: #130f0a;
    padding: 3rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .nav-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #5a5550;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }

  .authors-nav {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .author-chip {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1.1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(184, 134, 60, 0.2);
    border-radius: 4px;
    min-width: 150px;
  }

  .chip-name {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 700;
    color: #f0ede8;
  }

  .chip-en {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #c8a96e;
  }

  .chip-tagline {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: #6a6558;
    margin-top: 0.1rem;
  }

  /* ── 一覧 ── */
  .novel-section {
    background: #130f0a;
    padding: 4rem 0 6rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2.4rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: #f0ede8;
  }

  .section-sub {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #5a5550;
  }

  .novel-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.6rem;
  }

  @media (max-width: 480px) {
    .novel-hero { padding-top: calc(var(--nav-height) + 2.5rem); }
    .novel-grid { grid-template-columns: 1fr; gap: 1.2rem; }
    .section-head { flex-direction: column; gap: 0.2rem; }
    .authors-nav { gap: 0.6rem; }
    .author-chip { min-width: 130px; }
  }
</style>
