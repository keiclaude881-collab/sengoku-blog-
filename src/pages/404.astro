---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 ページが見つかりません | 戦略の系譜"
  description="お探しのページは存在しません。"
>
  <div class="not-found-wrap">
    <div class="not-found-inner">
      <div class="sword-wrap">
        <div class="sword">⚔</div>
      </div>
      <h1 class="code">404</h1>
      <p class="message">このページは存在しない——<br>撤退し、兵を立て直せ。</p>
      <p class="countdown-text"><span id="count">5</span> 秒後にトップへ戻ります</p>
      <a href="/" class="home-btn">今すぐトップへ</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-wrap {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }

  .not-found-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    animation: fadeUp 0.8s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .sword-wrap {
    animation: spin 3s linear infinite;
  }

  @keyframes spin {
    0%   { transform: rotate(0deg); }
    25%  { transform: rotate(-15deg); }
    75%  { transform: rotate(15deg); }
    100% { transform: rotate(0deg); }
  }

  .sword {
    font-size: 4rem;
    line-height: 1;
  }

  .code {
    font-size: 6rem;
    font-weight: 900;
    margin: 0;
    line-height: 1;
    letter-spacing: -2px;
    color: var(--color-accent, #c0392b);
  }

  .message {
    font-size: 1.1rem;
    line-height: 1.8;
    margin: 0;
    color: var(--color-text-muted, #666);
  }

  .countdown-text {
    font-size: 0.95rem;
    margin: 0;
    color: var(--color-text-muted, #888);
  }

  #count {
    font-weight: bold;
    font-size: 1.2rem;
    display: inline-block;
    animation: pulse 1s ease infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50%       { transform: scale(1.3); }
  }

  .home-btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.75rem 2rem;
    background: var(--color-accent, #c0392b);
    color: #fff;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    transition: opacity 0.2s;
  }

  .home-btn:hover {
    opacity: 0.85;
  }
</style>

<script>
  let n = 5;
  const el = document.getElementById('count');
  const timer = setInterval(() => {
    n--;
    if (el) el.textContent = String(n);
    if (n <= 0) {
      clearInterval(timer);
      window.location.href = '/';
    }
  }, 1000);
</script>
