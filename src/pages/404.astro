---
import BaseLayout from "../layouts/BaseLayout.astro";

const QUOTES = [
  { text: "道に迷った者は、立ち止まって考えよ。焦りは更なる迷いを生む。", figure: "孫子" },
  { text: "不可能とは、小さな人間の都合であって、偉大な人間には存在しない。", figure: "ナポレオン・ボナパルト" },
  { text: "失敗とは、より賢く再挑戦するための好機にすぎない。", figure: "ヘンリー・フォード" },
  { text: "転んでもただでは起きるな。転んだ場所から何かを拾って立ち上がれ。", figure: "豊臣秀吉" },
  { text: "コントロールできないことに悩む時間を、コントロールできることに使え。", figure: "マルクス・アウレリウス" },
  { text: "準備なき行動は、行動なきより危険だ。", figure: "マキャベリ" },
];
---

<BaseLayout
  title="404 — ページが見つかりません | 偉人ラボ"
  description="お探しのページは存在しません。偉人ラボに戻る。"
>

<div class="not-found">
  <div class="not-found-inner">

    <p class="nf-eyebrow">404</p>

    <h1 class="nf-title">ページが見つかりません</h1>

    <p class="nf-desc">お探しのページは移動・削除されたか、URLが間違っている可能性があります。</p>

    <div class="nf-divider"></div>

    <blockquote class="nf-quote" id="nf-quote">
      <p class="nf-quote-text" id="qt"></p>
      <cite class="nf-quote-figure" id="qf"></cite>
    </blockquote>

    <div class="nf-actions">
      <a href="/" class="nf-btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M5 12l7-7M5 12l7 7"/>
        </svg>
        トップに戻る
      </a>
      <a href="/blog/" class="nf-btn-ghost">記事一覧を見る</a>
    </div>

  </div>
</div>

</BaseLayout>

<script define:vars={{ QUOTES }}>
  const q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
  document.getElementById('qt').textContent = `「${q.text}」`;
  document.getElementById('qf').textContent = `— ${q.figure}`;
</script>

<style>
.not-found {
  min-height: calc(100vh - var(--nav-height));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
}
.not-found-inner {
  max-width: 520px;
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

.nf-eyebrow {
  font-family: var(--font-serif);
  font-size: clamp(5rem, 16vw, 9rem);
  font-weight: 700;
  color: var(--bg3);
  line-height: 1;
  letter-spacing: -0.04em;
  user-select: none;
}

.nf-title {
  font-family: var(--font-serif);
  font-size: clamp(1.3rem, 3vw, 1.7rem);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.02em;
}

.nf-desc {
  font-size: 0.9rem;
  line-height: 1.8;
  color: var(--ink2);
  max-width: 380px;
}

.nf-divider {
  width: 40px;
  height: 1px;
  background: var(--border-mid);
}

.nf-quote {
  margin: 0;
  padding: 1.4rem 1.6rem;
  background: var(--bg2);
  border-radius: var(--radius);
  border-left: 2px solid var(--border-mid);
  text-align: left;
  width: 100%;
}
.nf-quote-text {
  font-family: var(--font-serif);
  font-size: 0.92rem;
  line-height: 1.9;
  color: var(--ink);
  margin-bottom: 0.6rem;
}
.nf-quote-figure {
  font-size: 0.72rem;
  font-style: normal;
  color: var(--ink3);
  letter-spacing: 0.06em;
}

.nf-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 0.5rem;
}
.nf-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.6rem;
  background: var(--ink);
  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: 100px;
  text-decoration: none;
  transition: opacity 0.15s;
}
.nf-btn-primary:hover { opacity: 0.8; }
.nf-btn-ghost {
  font-size: 0.84rem;
  color: var(--ink2);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
  transition: color 0.15s;
}
.nf-btn-ghost:hover { color: var(--ink); }
</style>
