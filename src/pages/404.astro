---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 ― 決断の系譜"
  description="お探しのページは存在しません。"
>
  <div class="stage" id="stage">

    <!-- 火の粉パーティクル -->
    <canvas id="embers" class="embers"></canvas>

    <!-- 霧 -->
    <div class="mist mist-1"></div>
    <div class="mist mist-2"></div>

    <!-- メインコンテンツ -->
    <div class="content">
      <p class="chapter-label">第四〇四章</p>

      <h1 class="title-404">
        <span class="digit" style="--d:0">4</span>
        <span class="digit" style="--d:1">0</span>
        <span class="digit" style="--d:2">4</span>
      </h1>

      <div class="divider">
        <span class="divider-line"></span>
        <span class="divider-icon">✦</span>
        <span class="divider-line"></span>
      </div>

      <p class="subtitle">この道は、存在しない。</p>

      <blockquote class="quote">
        <p class="quote-text" id="quote-text"></p>
        <cite class="quote-author" id="quote-author"></cite>
      </blockquote>

      <a href="/" class="back-btn">
        <span class="btn-arrow">←</span>
        <span>本陣へ戻る</span>
      </a>
    </div>

  </div>
</BaseLayout>

<style is:global>
  /* 404ページではNavとFooterを非表示 */
  .stage ~ * { display: none !important; }
</style>

<style>
  /* ページ全体をステージに */
  :global(body):has(.stage) {
    overflow: hidden;
    background: #000;
  }
  :global(main):has(.stage) {
    padding-top: 0;
  }

  .stage {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at 50% 70%, #021a0e 0%, #000000 70%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  /* ── 火の粉キャンバス ── */
  .embers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ── 霧 ── */
  .mist {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .mist-1 {
    background: radial-gradient(ellipse 120% 40% at 30% 80%, rgba(40,140,80,0.08) 0%, transparent 70%);
    animation: mistDrift 12s ease-in-out infinite alternate;
  }
  .mist-2 {
    background: radial-gradient(ellipse 100% 30% at 70% 90%, rgba(20,80,50,0.06) 0%, transparent 60%);
    animation: mistDrift 18s ease-in-out infinite alternate-reverse;
  }
  @keyframes mistDrift {
    from { transform: translateX(-4%) scaleX(1); }
    to   { transform: translateX(4%) scaleX(1.05); }
  }

  /* ── コンテンツ ── */
  .content {
    position: relative;
    z-index: 10;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    padding: 2rem;
    animation: fadeUp 1.2s cubic-bezier(0.16,1,0.3,1) both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── 章ラベル ── */
  .chapter-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: rgba(80,180,110,0.7);
    text-transform: uppercase;
    margin: 0;
  }

  /* ── 404数字 ── */
  .title-404 {
    display: flex;
    gap: 0.05em;
    margin: 0;
    line-height: 1;
  }
  .digit {
    font-family: var(--font-serif);
    font-size: clamp(7rem, 20vw, 14rem);
    font-weight: 900;
    color: transparent;
    background: linear-gradient(180deg, #7de8a8 0%, #3B8C6E 50%, #1a4d34 100%);
    -webkit-background-clip: text;
    background-clip: text;
    display: inline-block;
    animation: flicker 4s ease-in-out infinite;
    animation-delay: calc(var(--d) * 0.3s);
    text-shadow: 0 0 60px rgba(59,140,110,0.3);
  }
  @keyframes flicker {
    0%, 90%, 100% { opacity: 1; filter: brightness(1); }
    92%            { opacity: 0.7; filter: brightness(0.6); }
    95%            { opacity: 1; filter: brightness(1.2); }
    97%            { opacity: 0.85; filter: brightness(0.8); }
  }

  /* ── 区切り ── */
  .divider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: min(320px, 80vw);
  }
  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(59,140,110,0.5), transparent);
  }
  .divider-icon {
    color: rgba(59,140,110,0.6);
    font-size: 0.7rem;
  }

  /* ── サブタイトル ── */
  .subtitle {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    font-weight: 700;
    color: rgba(180,240,200,0.9);
    letter-spacing: 0.12em;
    margin: 0;
  }

  /* ── 引用 ── */
  .quote {
    margin: 0;
    padding: 1.2rem 1.6rem;
    border-left: 2px solid rgba(59,140,110,0.4);
    max-width: 480px;
    text-align: left;
    animation: fadeUp 1.2s 0.4s cubic-bezier(0.16,1,0.3,1) both;
  }
  .quote-text {
    font-family: var(--font-sans);
    font-size: clamp(0.82rem, 2vw, 0.95rem);
    line-height: 1.9;
    color: rgba(160,220,180,0.85);
    margin: 0 0 0.5rem;
  }
  .quote-author {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-style: normal;
    letter-spacing: 0.08em;
    color: rgba(80,160,110,0.7);
  }

  /* ── ボタン ── */
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 2.2rem;
    background: transparent;
    border: 1px solid rgba(59,140,110,0.5);
    color: rgba(100,200,140,0.9);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.3s, border-color 0.3s, color 0.3s, box-shadow 0.3s;
    animation: fadeUp 1.2s 0.6s cubic-bezier(0.16,1,0.3,1) both;
  }
  .back-btn:hover {
    background: rgba(59,140,110,0.12);
    border-color: rgba(100,200,140,0.8);
    color: #fff;
    box-shadow: 0 0 24px rgba(59,140,110,0.25);
  }
  .btn-arrow {
    transition: transform 0.3s;
  }
  .back-btn:hover .btn-arrow {
    transform: translateX(-4px);
  }
</style>

<script>
  // ── 名言ランダム表示 ──
  const quotes = [
    { text: "道に迷った者は、立ち止まって考えよ。焦りは更なる迷いを生む。", author: "— 孫子『兵法』より" },
    { text: "退くことを恥じるな。生きて再び戦う者が、最後に勝つ。", author: "— 徳川家康" },
    { text: "敵を知り、己を知れば、百戦危うからず。", author: "— 孫子" },
    { text: "進むことばかりが勇気ではない。引いて機を待つことも、また勇気だ。", author: "— 武田信玄" },
    { text: "敗れた戦場から何を学ぶかが、次の勝利を決める。", author: "— ハンニバル・バルカ" },
    { text: "道が閉ざされたとき、新しい道が現れる。問題は、それに気づけるかだ。", author: "— アレクサンドロス大王" },
  ];
  const q = quotes[Math.floor(Math.random() * quotes.length)];
  const textEl = document.getElementById('quote-text');
  const authorEl = document.getElementById('quote-author');
  if (textEl) textEl.textContent = q.text;
  if (authorEl) authorEl.textContent = q.author;

  // ── 火の粉パーティクル ──
  const canvas = document.getElementById('embers') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function resize() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  interface Ember {
    x: number; y: number;
    vx: number; vy: number;
    size: number; alpha: number;
    decay: number; wobble: number; wobbleSpeed: number;
  }

  const embers: Ember[] = [];
  const MAX = 120;

  function spawn(): Ember {
    return {
      x: Math.random() * canvas.width,
      y: canvas.height + 10,
      vx: (Math.random() - 0.5) * 0.8,
      vy: -(Math.random() * 1.5 + 0.5),
      size: Math.random() * 2.5 + 0.5,
      alpha: Math.random() * 0.6 + 0.3,
      decay: Math.random() * 0.004 + 0.002,
      wobble: Math.random() * Math.PI * 2,
      wobbleSpeed: Math.random() * 0.04 + 0.01,
    };
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // 補充
    while (embers.length < MAX) embers.push(spawn());

    for (let i = embers.length - 1; i >= 0; i--) {
      const e = embers[i];
      e.wobble += e.wobbleSpeed;
      e.x += e.vx + Math.sin(e.wobble) * 0.4;
      e.y += e.vy;
      e.alpha -= e.decay;

      if (e.alpha <= 0 || e.y < -20) {
        embers.splice(i, 1);
        continue;
      }

      const grad = ctx.createRadialGradient(e.x, e.y, 0, e.x, e.y, e.size * 2);
      grad.addColorStop(0, `rgba(180,255,210,${e.alpha})`);
      grad.addColorStop(0.5, `rgba(59,140,110,${e.alpha * 0.7})`);
      grad.addColorStop(1, `rgba(20,80,50,0)`);

      ctx.beginPath();
      ctx.arc(e.x, e.y, e.size * 2, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();
    }

    requestAnimationFrame(draw);
  }
  draw();
</script>
