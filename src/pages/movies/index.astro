---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MovieCard from "../../components/MovieCard.astro";

const movies = (await getCollection("movie"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function slug(id: string) {
  return `movie/${id.replace(/\.mdx?$/, "")}`;
}

function detectGenre(tags: string[]): string {
  const t = tags.join(" ");
  if (/SF/.test(t)) return "sf";
  if (/第二次世界大戦|太平洋戦争|ノルマンディー|沖縄戦|硫黄島/.test(t)) return "wwii";
  if (/戦国時代|時代劇|黒澤明|明治|三国志|始皇帝|中国史/.test(t)) return "japanese";
  if (/ローマ史|ギリシア|スパルタ|古代|トロイ|スコットランド/.test(t)) return "ancient";
  return "other";
}

const GENRES = [
  { key: "all",      label: "すべて" },
  { key: "wwii",     label: "世界大戦" },
  { key: "japanese", label: "日本・アジア史" },
  { key: "ancient",  label: "古代・西洋" },
  { key: "sf",       label: "SF" },
];
---

<BaseLayout
  title="映画と戦略 | 決断の系譜"
  description={`歴史映画・戦争映画・SFから学ぶ戦略論。U-NEXT・Hulu・Netflix・Disney+で観られる${movies.length}作品をビジネス視点で分析。`}
  ogImage="https://images.pexels.com/photos/7991579/pexels-photo-7991579.jpeg?auto=compress&cs=tinysrgb&w=1080"
>
  <!-- ヒーロー -->
  <section class="cinema-hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="hero-label">CINEMA &amp; STRATEGY</span>
      <h1 class="hero-heading">映画で学ぶ<br />戦略の本質</h1>
      <p class="hero-sub">スクリーンの向こうに、リーダーシップと意思決定の本質がある。<br />歴史映画・戦争映画・SFを戦略の視点で読み解く。</p>
    </div>
  </section>

  <!-- 作品一覧 -->
  <section class="movies-section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">全{movies.length}作品</h2>
        <p class="section-sub">各記事の末尾に視聴リンクあり</p>
      </div>

      <!-- ジャンルフィルター -->
      <div class="genre-filter" role="tablist" aria-label="ジャンルで絞り込む">
        {GENRES.map((g, i) => (
          <button
            class={`genre-btn ${i === 0 ? 'active' : ''}`}
            data-genre={g.key}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
          >
            {g.label}
          </button>
        ))}
      </div>

      <ul class="movie-grid" role="list" id="movie-grid">
        {movies.map(m => (
          <li data-genre={detectGenre(m.data.tags)}>
            <MovieCard
              title={m.data.title}
              description={m.data.description}
              lesson={m.data.lesson}
              slug={slug(m.id)}
              ogImage={m.data.ogImage}
              youtubeId={m.data.youtubeId}
              tags={m.data.tags}
            />
          </li>
        ))}
      </ul>

      <p class="no-results" id="no-results" aria-live="polite" hidden>
        このジャンルの記事は準備中です
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.genre-btn');
  const items = document.querySelectorAll<HTMLElement>('#movie-grid li');
  const noResults = document.getElementById('no-results') as HTMLParagraphElement;

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const genre = btn.dataset.genre!;

      // タブ状態更新
      btns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      // フィルタリング
      let visible = 0;
      items.forEach(item => {
        const show = genre === 'all' || item.dataset.genre === genre;
        item.hidden = !show;
        if (show) visible++;
      });
      noResults.hidden = visible > 0;
    });
  });
</script>

<style>
  /* ── ヒーロー ── */
  .cinema-hero {
    position: relative;
    background: #0d0f14;
    padding: calc(var(--nav-height) + 4rem) 0 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 60% 40%, rgba(232, 184, 75, 0.06) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 20% 80%, rgba(30, 74, 53, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .hero-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #e8b84b;
    text-transform: uppercase;
  }

  .hero-heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    color: #f0eee8;
    line-height: 1.3;
    letter-spacing: 0.05em;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: #8a8f9e;
    line-height: 1.8;
    max-width: 520px;
  }

  /* ── 作品一覧 ── */
  .movies-section {
    background: #10131a;
    padding: 4rem 0 6rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: #f0eee8;
  }

  .section-sub {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #5a5f6e;
  }

  /* ── ジャンルフィルター ── */
  .genre-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .genre-btn {
    padding: 0.4em 1.1em;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 3px;
    color: #8a8f9e;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, border-color 0.18s;
  }

  .genre-btn:hover {
    background: rgba(232, 184, 75, 0.08);
    border-color: rgba(232, 184, 75, 0.3);
    color: #e8b84b;
  }

  .genre-btn.active {
    background: rgba(232, 184, 75, 0.12);
    border-color: rgba(232, 184, 75, 0.5);
    color: #e8b84b;
    font-weight: 600;
  }

  .movie-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.6rem;
  }

  .movie-grid li[hidden] {
    display: none;
  }

  .no-results {
    text-align: center;
    color: #5a5f6e;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    padding: 3rem 0;
  }

  @media (max-width: 480px) {
    .cinema-hero { padding-top: calc(var(--nav-height) + 2.5rem); }
    .movie-grid  { grid-template-columns: 1fr; gap: 1.2rem; }
    .section-head { flex-direction: column; gap: 0.2rem; }
    .genre-filter { gap: 0.4rem; }
    .genre-btn { font-size: 0.78rem; padding: 0.35em 0.9em; }
  }
</style>
