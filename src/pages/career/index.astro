---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("posts"))
  .filter(p => p.data.category === "career")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}
---

<BaseLayout
  title="仕事・副業 | 偉人ラボ"
  description="歴史の偉人から学ぶ仕事術・副業戦略・キャリア設計。ナポレオン・マキャベリ・カエサルの戦略を現代の働き方に応用します。"
>

<div class="cat-page">
  <div class="container">
    <div class="cat-header">
      <span class="cat-badge cat-badge--career">仕事・副業</span>
      <h1 class="cat-title">仕事・副業</h1>
      <p class="cat-desc">ナポレオン・マキャベリ・カエサル——偉人の戦略論を副業とキャリアに活かす。</p>
      <p class="cat-count">{posts.length}件の記事</p>
    </div>

    {posts.length > 0 ? (
      <ul class="card-grid">
        {posts.map(p => (
          <li class="fade-in">
            <a href={`/blog/${p.id.replace(/.mdx?$/, '')}/`} class="card-link">
              <div class="card-img-wrap">
                {p.data.ogImage
                  ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="card-img" />
                  : <div class="card-img-empty" />
                }
              </div>
              <div class="card-body">
                <h2 class="card-title">{p.data.title}</h2>
                {p.data.description && <p class="card-desc">{p.data.description}</p>}
                <div class="card-foot">
                  <time class="card-date">{fmt(p.data.date)}</time>
                  <span class="card-time">{p.data.readingTime}分で読める</span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">記事を準備中です。</p>
    )}
  </div>
</div>

</BaseLayout>

<style>
.cat-page { padding: 52px 0 88px; }
.cat-header { margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
.cat-badge {
  display: inline-flex;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
  margin-bottom: 1rem;
  border: 1px solid transparent;
}
.cat-badge--career { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.cat-title {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.02em;
  margin-bottom: 0.8rem;
}
.cat-desc {
  font-size: 0.95rem;
  line-height: 1.8;
  color: var(--ink2);
  max-width: 520px;
  margin-bottom: 0.8rem;
}
.cat-count { font-size: 0.78rem; color: var(--ink3); }
.card-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 36px 28px;
}
.card-link { display: block; text-decoration: none; color: inherit; }
.card-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
  margin-bottom: 1rem;
}
.card-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}
.card-link:hover .card-img { transform: scale(1.04); }
.card-img-empty { width: 100%; height: 100%; background: var(--bg3); }
.card-title {
  font-family: var(--font-serif);
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 0.5rem;
  transition: color 0.2s;
}
.card-link:hover .card-title { color: var(--ink2); }
.card-desc {
  font-size: 0.8rem;
  line-height: 1.75;
  color: var(--ink2);
  margin-bottom: 0.6rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-foot { display: flex; align-items: center; justify-content: space-between; }
.card-date { font-size: 0.7rem; color: var(--ink3); }
.card-time { font-size: 0.68rem; color: var(--ink3); }
.empty { text-align: center; color: var(--ink3); padding: 4rem 0; }
@media (max-width: 900px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .card-grid { grid-template-columns: 1fr; } }
</style>
