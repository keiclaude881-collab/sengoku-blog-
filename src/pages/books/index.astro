---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AffiliateDisclosure from "../../components/AffiliateDisclosure.astro";
import { getCollection } from "astro:content";

const COLLECTIONS = ["battle", "leader", "strategy", "books", "movie", "whatif", "anime", "novel", "world", "philosophy"] as const;
const allEntries = (await Promise.all(COLLECTIONS.map((c) => getCollection(c)))).flat();

type ArticleRef = { title: string; url: string; collection: string };
type BookData   = { title: string; asin: string; reason: string; image?: string; articles: ArticleRef[] };

const bookMap = new Map<string, BookData>();

for (const entry of allEntries) {
  const affiliateBooks = entry.data.affiliateBooks ?? [];
  const slug = entry.id.replace(/\.mdx?$/, "");
  const url  = `/blog/${entry.collection}/${slug}`;

  for (const book of affiliateBooks) {
    if (!book.asin) continue;
    if (!bookMap.has(book.asin)) {
      bookMap.set(book.asin, { title: book.title, asin: book.asin, reason: book.reason, image: book.image, articles: [] });
    }
    const rec = bookMap.get(book.asin)!;
    if (!rec.articles.find((a) => a.url === url)) {
      rec.articles.push({ title: entry.data.title, url, collection: entry.collection });
    }
    if (book.reason.length > rec.reason.length) rec.reason = book.reason;
    if (!rec.image && book.image) rec.image = book.image;
  }
}

const books = [...bookMap.values()].sort((a, b) => b.articles.length - a.articles.length);
const totalBooks    = books.length;
const totalArticles = allEntries.length;

const associateId = import.meta.env.AMAZON_ASSOCIATE_ID ?? "sengokublog20-22";

function coverUrl(asin: string, image?: string) {
  return image ?? `https://images-na.ssl-images-amazon.com/images/P/${asin}.01.LZZZZZZZ.jpg`;
}
function amazonUrl(asin: string) {
  return `https://www.amazon.co.jp/dp/${asin}/?tag=${associateId}`;
}
function rakutenUrl(title: string) {
  return `https://books.rakuten.co.jp/search/?sitem=${encodeURIComponent(title)}`;
}

// 書評記事（booksコレクション）を優先リンクとして取得
function reviewLink(articles: ArticleRef[]) {
  return articles.find((a) => a.collection === "books") ?? null;
}

const placeholders = ["兵", "謀", "戦", "策", "智", "将", "武", "覇", "道", "義"];
function placeholder(asin: string) {
  return placeholders[parseInt(asin.slice(-1), 10)] ?? "書";
}
---

<BaseLayout
  title="戦略の図書館 | 決断の系譜"
  description={`全${totalArticles}記事で紹介した${totalBooks}冊を、内容紹介つきで一覧。歴史・戦略・リーダーシップの本棚。`}
>
  <div class="container">

    <header class="lib-header">
      <p class="lib-eyebrow">LIBRARY</p>
      <h1 class="lib-title">戦略の図書館</h1>
      <p class="lib-sub">全記事で紹介した本を、内容紹介つきでまとめました。<br>気になる本は、書評記事もあわせてどうぞ。</p>
      <div class="lib-stats">
        <span class="stat"><strong>{totalBooks}</strong>冊掲載</span>
        <span class="stat-sep">·</span>
        <span class="stat"><strong>{totalArticles}</strong>記事から厳選</span>
      </div>
    </header>

    <AffiliateDisclosure />

    <ul class="books-list">
      {books.map((book) => {
        const review = reviewLink(book.articles);
        const otherArticles = book.articles.filter((a) => a.collection !== "books");
        return (
          <li class="book-item">
            <div class="book-cover">
              <img
                src={coverUrl(book.asin, book.image)}
                alt={book.title}
                width="80"
                height="120"
                loading="lazy"
                onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
              />
              <span class="cover-ph" style="display:none">{placeholder(book.asin)}</span>
            </div>

            <div class="book-body">
              <p class="book-title">{book.title}</p>
              <p class="book-reason">{book.reason}</p>

              {review && (
                <a href={review.url} class="review-link">
                  書評を読む →
                </a>
              )}

              {!review && otherArticles.length > 0 && (
                <p class="ref-label">
                  登場記事：
                  {otherArticles.slice(0, 2).map((a, i) => (
                    <span>
                      {i > 0 && "、"}
                      <a href={a.url} class="ref-link">{a.title}</a>
                    </span>
                  ))}
                  {otherArticles.length > 2 && <span>ほか</span>}
                </p>
              )}

              <div class="buy-links">
                <span class="buy-label">購入：</span>
                <a
                  href={amazonUrl(book.asin)}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class="buy-link"
                >
                  Amazon
                </a>
                <span class="buy-sep">|</span>
                <a
                  href={rakutenUrl(book.title)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="buy-link"
                >
                  楽天ブックス
                </a>
              </div>
            </div>
          </li>
        );
      })}
    </ul>

    <div class="footer-disclosure">
      <AffiliateDisclosure />
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Header ── */
  .lib-header {
    text-align: center;
    padding: var(--sp-lg) 0 var(--sp-md);
  }
  .lib-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .lib-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.6rem;
    letter-spacing: 0.04em;
  }
  .lib-sub {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--ink3);
    line-height: 1.8;
    margin-bottom: 1rem;
  }
  .lib-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--ink3);
  }
  .lib-stats strong {
    font-weight: 700;
    color: var(--ink);
  }
  .stat-sep { color: var(--ink3); }

  /* ── List ── */
  .books-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: var(--sp-md);
    border-top: 1px solid var(--rule);
  }

  /* ── Item ── */
  .book-item {
    display: flex;
    gap: 1.2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: flex-start;
  }

  /* ── Cover ── */
  .book-cover {
    flex-shrink: 0;
    width: 72px;
  }
  .book-cover img {
    width: 72px;
    height: 108px;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: 2px;
    display: block;
  }
  .cover-ph {
    width: 72px;
    height: 108px;
    background: var(--bg2);
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--ink3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Body ── */
  .book-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .book-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.55;
    margin: 0;
  }
  .book-reason {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink2);
    line-height: 1.75;
    margin: 0;
  }

  /* ── Review link ── */
  .review-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-light);
    padding-bottom: 1px;
    transition: border-color 0.15s;
    width: fit-content;
  }
  .review-link:hover {
    border-color: var(--gold);
  }

  /* ── Reference articles ── */
  .ref-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink2);
    line-height: 1.6;
    margin: 0;
  }
  .ref-link {
    color: var(--ink2);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .ref-link:hover { color: var(--ink); }

  /* ── Buy links ── */
  .buy-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.2rem;
  }
  .buy-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink3);
  }
  .buy-link {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink2);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .buy-link:hover { color: var(--ink); }
  .buy-sep {
    font-size: 0.65rem;
    color: var(--ink3);
  }

  .footer-disclosure { margin-top: var(--sp-lg); }

  @media (max-width: 480px) {
    .book-cover { width: 60px; }
    .book-cover img { width: 60px; height: 90px; }
    .cover-ph { width: 60px; height: 90px; font-size: 1.4rem; }
    .book-title { font-size: 0.88rem; }
    .book-reason { font-size: 0.78rem; }
  }
</style>
