---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const LABELS: Record<string, string> = {
  money:   "投資・お金",
  career:  "仕事・副業",
  mindset: "思考法",
};
const HREFS: Record<string, string> = {
  money:   "/money/",
  career:  "/career/",
  mindset: "/mindset/",
};

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2);

const allPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}
---

<BaseLayout
  title={`${post.data.title} | 偉人ラボ`}
  description={post.data.description}
  ogImage={post.data.ogImage}
  type="article"
  publishedAt={post.data.date.toISOString()}
>

<div class="progress-bar" id="progress-bar"></div>

<article class="article-wrap">
  <div class="container article-container">

    <!-- Header -->
    <header class="article-header">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="/">偉人ラボ</a>
        <span>/</span>
        <a href={HREFS[post.data.category]}>{LABELS[post.data.category]}</a>
      </nav>

      <a href={HREFS[post.data.category]} class={`article-cat article-cat--${post.data.category}`}>
        {LABELS[post.data.category]}
      </a>

      <h1 class="article-title">{post.data.title}</h1>

      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <span class="meta-sep">·</span>
        <span>{post.data.readingTime}分で読める</span>
        {post.data.updatedAt && (
          <>
            <span class="meta-sep">·</span>
            <span>更新: {fmt(post.data.updatedAt)}</span>
          </>
        )}
      </div>
    </header>

    <!-- OG Image -->
    {post.data.ogImage && (
      <div class="article-eyecatch">
        <img src={post.data.ogImage} alt={post.data.title} class="eyecatch-img" />
      </div>
    )}

    <div class="article-layout">

      <!-- TOC (sidebar) -->
      {toc.length > 0 && (
        <aside class="toc-sidebar">
          <div class="toc-inner">
            <p class="toc-label">目次</p>
            <ol class="toc-list">
              {toc.map(h => (
                <li>
                  <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      )}

      <!-- Body -->
      <div class="prose">
        <Content />
      </div>

    </div>

    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map(t => (
          <span class="tag">#{t}</span>
        ))}
      </div>
    )}

    <!-- Related -->
    {related.length > 0 && (
      <section class="related">
        <h2 class="related-title">関連記事</h2>
        <ul class="related-grid">
          {related.map(p => (
            <li>
              <a href={`/blog/${p.id.replace(/.mdx?$/, '')}/`} class="related-card">
                <div class="related-img-wrap">
                  {p.data.ogImage
                    ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="related-img" />
                    : <div class="related-img-empty" />
                  }
                </div>
                <p class="related-card-title">{p.data.title}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>
</article>

</BaseLayout>

<script>
  /* Progress bar */
  const bar = document.getElementById('progress-bar');
  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const pct = (doc.scrollTop / (doc.scrollHeight - doc.clientHeight)) * 100;
    if (bar) bar.style.width = `${pct}%`;
  }, { passive: true });
</script>

<style>
/* ── Progress bar ── */
.progress-bar {
  position: fixed;
  top: 0; left: 0;
  height: 2px;
  width: 0%;
  background: var(--ink);
  z-index: 200;
  transition: width 0.1s linear;
}

/* ── Article layout ── */
.article-wrap { padding: 48px 0 80px; }
.article-container { max-width: 800px; }

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: var(--ink3);
  margin-bottom: 1.5rem;
}
.breadcrumb a { color: var(--ink2); text-decoration: none; }
.breadcrumb a:hover { color: var(--ink); }
.breadcrumb span { color: var(--ink3); }

.article-cat {
  display: inline-flex;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
  text-decoration: none;
  margin-bottom: 1rem;
  border: 1px solid transparent;
}
.article-cat--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.article-cat--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.article-cat--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

.article-title {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 4vw, 2.2rem);
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}
.article-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: var(--ink3);
  margin-bottom: 2rem;
  flex-wrap: wrap;
}
.meta-sep { color: var(--bg3); }

.article-eyecatch {
  margin-bottom: 2.5rem;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 16 / 9;
}
.eyecatch-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}

/* ── Article body + sidebar ── */
.article-layout {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 220px;
  gap: 48px;
  align-items: start;
}

.toc-sidebar {
  position: sticky;
  top: calc(var(--nav-height) + 24px);
}
.toc-inner {
  background: var(--bg2);
  border-radius: var(--radius);
  padding: 1.2rem;
}
.toc-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 0.8rem;
}
.toc-list {
  list-style: none;
  counter-reset: toc;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}
.toc-link {
  display: block;
  font-size: 0.78rem;
  line-height: 1.5;
  color: var(--ink2);
  text-decoration: none;
  padding: 0.3rem 0;
  border-bottom: 1px solid var(--border);
  transition: color 0.15s;
}
.toc-link:hover { color: var(--ink); }
.toc-list li:last-child .toc-link { border-bottom: none; }

/* ── Tags ── */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 2.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border);
}
.tag {
  font-size: 0.72rem;
  color: var(--ink2);
  background: var(--bg2);
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
}

/* ── Related ── */
.related {
  margin-top: 3rem;
  padding-top: 2.5rem;
  border-top: 1px solid var(--border);
}
.related-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 1.5rem;
}
.related-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.related-card { display: block; text-decoration: none; color: inherit; }
.related-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
  margin-bottom: 0.6rem;
}
.related-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.related-card:hover .related-img { transform: scale(1.04); }
.related-img-empty { width: 100%; height: 100%; background: var(--bg3); }
.related-card-title {
  font-size: 0.82rem;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink);
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .article-layout { grid-template-columns: 1fr; }
  .toc-sidebar { display: none; }
  .related-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 540px) {
  .related-grid { grid-template-columns: 1fr; }
  .article-container { max-width: 100%; }
}
</style>
