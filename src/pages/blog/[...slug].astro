---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextDoors from "../../components/NextDoors.astro";
import Sidebar from "../../components/Sidebar.astro";

const LABELS: Record<string, string> = {
  money:   "投資・お金",
  career:  "仕事・副業",
  mindset: "思考法",
};
const HREFS: Record<string, string> = {
  money:   "/money/",
  career:  "/career/",
  mindset: "/mindset/",
};

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2);

const allPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}

const canonicalURL = new URL(`/blog/${post.id.replace(/\.mdx?$/, "")}/`, Astro.site);
const absImage = post.data.ogImage ? new URL(post.data.ogImage, Astro.site).toString() : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  ...(absImage && { image: [absImage] }),
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.date).toISOString(),
  author: {
    "@type": "Person",
    name: "温故",
    url: new URL("/about/", Astro.site).toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "偉人ラボ",
    logo: {
      "@type": "ImageObject",
      url: new URL("/icon-192.png", Astro.site).toString(),
    },
  },
  mainEntityOfPage: canonicalURL.toString(),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "偉人ラボ", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: LABELS[post.data.category], item: new URL(HREFS[post.data.category], Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: post.data.title, item: canonicalURL.toString() },
  ],
};
---

<BaseLayout
  title={`${post.data.title} | 偉人ラボ`}
  description={post.data.description}
  ogImage={post.data.ogImage}
  type="article"
  publishedAt={post.data.date.toISOString()}
>

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<div class="progress-bar" id="progress-bar"></div>

<article class="article-wrap">
  <div class="container article-outer">
  <div class="article-main">

    <!-- Header -->
    <header class="article-header">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="/">偉人ラボ</a>
        <span>/</span>
        <a href={HREFS[post.data.category]}>{LABELS[post.data.category]}</a>
      </nav>

      <a href={HREFS[post.data.category]} class={`article-cat article-cat--${post.data.category}`}>
        {LABELS[post.data.category]}
      </a>

      <h1 class="article-title">{post.data.title}</h1>

      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <span class="meta-sep">·</span>
        <span>{post.data.readingTime}分で読める</span>
        {post.data.updatedAt && (
          <>
            <span class="meta-sep">·</span>
            <span>更新: {fmt(post.data.updatedAt)}</span>
          </>
        )}
      </div>
    </header>

    <!-- OG Image -->
    {post.data.ogImage && (
      <div class="article-eyecatch">
        <img src={post.data.ogImage} alt={post.data.title} class="eyecatch-img" />
      </div>
    )}

    <!-- Body -->
    <div class="prose">

      <!-- TOC (collapsible) -->
      {toc.length > 0 && (
        <details class="toc-box" open>
          <summary class="toc-box-summary">
            <span class="toc-box-label">
              <span class="toc-box-icon" aria-hidden="true">☰</span>
              目次
            </span>
            <span class="toc-box-toggle" aria-hidden="true"></span>
          </summary>
          <ol class="toc-box-list">
            {toc.map(h => (
              <li>
                <a href={`#${h.slug}`} class="toc-box-link">{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}

      <Content />
    </div>

    <!-- Share -->
    <div class="share-box">
      <p class="share-label">この記事をシェアする</p>
      <div class="share-buttons">
        <a
          class="share-btn share-btn--x"
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalURL.toString())}&text=${encodeURIComponent(post.data.title)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Xでシェアする"
        >
          <svg class="share-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>X</span>
        </a>
        <a
          class="share-btn share-btn--hatena"
          href={`https://b.hatena.ne.jp/entry/${encodeURIComponent(canonicalURL.toString())}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="はてなブックマークに追加"
        >
          <span class="share-icon share-icon--hatena" aria-hidden="true">B!</span>
          <span>はてブ</span>
        </a>
      </div>
    </div>

    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map(t => (
          <span class="tag">#{t}</span>
        ))}
      </div>
    )}

    <!-- Next Doors -->
    <NextDoors slug={post.id.replace(/\.mdx?$/, '')} />

    <!-- Related -->
    {related.length > 0 && (
      <section class="related">
        <h2 class="related-title">関連記事</h2>
        <ul class="related-grid">
          {related.map(p => (
            <li>
              <a href={`/blog/${p.id.replace(/.mdx?$/, '')}/`} class="related-card">
                <div class="related-img-wrap">
                  {p.data.ogImage
                    ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="related-img" />
                    : <div class="related-img-empty" />
                  }
                </div>
                <p class="related-card-title">{p.data.title}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}


  </div><!-- /.article-main -->

  <Sidebar />

  </div><!-- /.article-outer -->
</article>

</BaseLayout>

<script>
  /* Progress bar */
  const bar = document.getElementById('progress-bar');
  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const pct = (doc.scrollTop / (doc.scrollHeight - doc.clientHeight)) * 100;
    if (bar) bar.style.width = `${pct}%`;
  }, { passive: true });
</script>

<style>
/* ── Progress bar ── */
.progress-bar {
  position: fixed;
  top: 0; left: 0;
  height: 2px;
  width: 0%;
  background: var(--ink);
  z-index: 200;
  transition: width 0.1s linear;
}

/* ── Article layout ── */
.article-wrap { padding: 48px 0 80px; }

/* 2-column grid: main content + sidebar */
.article-outer {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 3rem;
  align-items: start;
  max-width: 1160px;
}
.article-main { min-width: 0; max-width: 800px; }

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: var(--ink3);
  margin-bottom: 1.5rem;
}
.breadcrumb a { color: var(--ink2); text-decoration: none; }
.breadcrumb a:hover { color: var(--ink); }
.breadcrumb span { color: var(--ink3); }

.article-cat {
  display: inline-flex;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
  text-decoration: none;
  margin-bottom: 1rem;
  border: 1px solid transparent;
}
.article-cat--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.article-cat--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.article-cat--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }

.article-title {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 4vw, 2.2rem);
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}
.article-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: var(--ink3);
  margin-bottom: 2rem;
  flex-wrap: wrap;
}
.meta-sep { color: var(--bg3); }

.article-eyecatch {
  margin-bottom: 2.5rem;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 16 / 9;
}
.eyecatch-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}

.prose {
  min-width: 0;
}

/* Keep jumped-to headings clear of the fixed header */
.prose :global(h2),
.prose :global(h3) {
  scroll-margin-top: calc(var(--nav-height) + 1.2rem);
}

/* Highlighter-style emphasis for key passages */
.prose :global(mark) {
  background: linear-gradient(transparent 60%, #fde68a 60%);
  color: var(--ink);
  padding: 0 0.1em;
}

/* ── TOC (collapsible box) ── */
.toc-box {
  background: var(--bg2);
  border: 1px solid var(--ink3);
  border-radius: var(--radius);
  padding: 0 1.6rem;
  margin: 0 0 2.4rem;
}
.toc-box[open] { padding-bottom: 1.4rem; }
.toc-box-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.1rem 0;
  cursor: pointer;
  list-style: none;
  user-select: none;
}
.toc-box-summary::-webkit-details-marker { display: none; }
.toc-box-label {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--ink);
}
.toc-box-icon { font-size: 0.9rem; }
.toc-box-toggle {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--ink2);
}
.toc-box-toggle::before { content: "閉じる"; }
.toc-box:not([open]) .toc-box-toggle::before { content: "開く"; }
.toc-box-list {
  list-style: none;
  counter-reset: toc-box;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  margin: 0;
  border-top: 1px solid var(--border);
  padding-top: 1rem;
}
.toc-box-list li {
  counter-increment: toc-box;
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
}
.toc-box-list li::before {
  content: counter(toc-box);
  flex-shrink: 0;
  font-family: var(--font-serif);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--ink);
}
.toc-box-link {
  font-family: var(--font-sans);
  font-size: 0.86rem;
  font-weight: 600;
  line-height: 1.6;
  color: var(--ink);
  text-decoration: none;
  transition: color 0.15s;
}
.toc-box-link:hover { color: var(--ink2); text-decoration: underline; }

/* ── Share ── */
.share-box {
  margin-top: 3rem;
  padding-top: 2.2rem;
  border-top: 1px solid var(--border);
  text-align: center;
}
.share-label {
  font-family: var(--font-sans);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-bottom: 1.1rem;
}
.share-buttons {
  display: flex;
  justify-content: center;
  gap: 0.7rem;
}
.share-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.4rem;
  border: 1px solid var(--border-mid);
  border-radius: 100px;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}
.share-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(28, 25, 23, 0.08);
}
.share-icon {
  width: 15px;
  height: 15px;
  fill: currentColor;
  flex-shrink: 0;
}
.share-btn--x:hover { border-color: var(--ink); }
.share-btn--hatena:hover { border-color: #00a4de; color: #00a4de; }
.share-icon--hatena {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 17px;
  height: 17px;
  border-radius: 3px;
  background: #00a4de;
  color: #fff;
  font-size: 0.6rem;
  font-weight: 800;
  font-family: var(--font-sans);
  flex-shrink: 0;
}

/* ── Tags ── */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 2.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border);
}
.tag {
  font-size: 0.72rem;
  color: var(--ink2);
  background: var(--bg2);
  padding: 0.3rem 0.7rem;
  border-radius: 100px;
}

/* ── Related ── */
.related {
  margin-top: 3rem;
  padding-top: 2.5rem;
  border-top: 1px solid var(--border);
}
.related-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 1.5rem;
}
.related-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.related-card { display: block; text-decoration: none; color: inherit; }
.related-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
  margin-bottom: 0.6rem;
}
.related-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.related-card:hover .related-img { transform: scale(1.04); }
.related-img-empty { width: 100%; height: 100%; background: var(--bg3); }
.related-card-title {
  font-size: 0.82rem;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink);
}

/* Sidebar sticky positioning */
:global(.sidebar) {
  position: sticky;
  top: calc(var(--nav-height) + 1.5rem);
}

/* ── Responsive ── */
@media (max-width: 1000px) {
  .article-outer {
    grid-template-columns: 1fr;
  }
  :global(.sidebar) { display: none; }
  .article-main { max-width: 100%; }
}
@media (max-width: 900px) {
  .related-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 540px) {
  .related-grid { grid-template-columns: 1fr; }
}
</style>
