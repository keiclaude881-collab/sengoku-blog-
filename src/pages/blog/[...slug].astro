---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Lesson from "../../components/Lesson.astro";
import BookCard from "../../components/BookCard.astro";
import { CATEGORY_TO_ARC, ARC_INFO, type CategoryName } from "../../utils/arcMap";

type CollectionName = CategoryName;

export async function getStaticPaths() {
  const allPosts = (await Promise.all(
    (["battle", "leader", "strategy", "books", "movie", "whatif", "anime", "business", "sports", "novel"] as const).map(c => getCollection(c))
  )).flat();

  return allPosts.map(post => ({
    params: { slug: `${post.collection}/${post.id.replace(/\.mdx?$/, '')}` },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(h => h.depth === 2);

// 関連記事：同章(arc)の他カテゴリ含む最新3件、なければ同カテゴリ
const arcSlug = CATEGORY_TO_ARC[post.collection as CollectionName];
const arcCategories = arcSlug ? ARC_INFO[arcSlug].categories : [post.collection as CollectionName];

const related = (await Promise.all(
  arcCategories.map(cat => getCollection(cat as CollectionName))
)).flat()
  .filter(p => !(p.collection === post.collection && p.id === post.id))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

function relSlug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, '')}`;
}

const relatedArticles = related.map(p => ({
  title:       p.data.title,
  slug:        relSlug(p.collection, p.id),
  category:    p.data.category,
  date:        p.data.date,
  readingTime: p.data.readingTime,
  description: p.data.description,
}));
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updatedAt={post.data.updatedAt}
  category={post.data.category}
  tags={post.data.tags}
  readingTime={post.data.readingTime}
  ogImage={post.data.ogImage}
  lesson={post.data.lesson}
  youtubeId={post.data.youtubeId}
  vodService={post.data.vodService}
  vodUrl={post.data.vodUrl}
  affiliateBooks={post.data.affiliateBooks}
  relatedArticles={relatedArticles}
  tocHeadings={tocHeadings}
>
  <Content components={{ Lesson, BookCard }} />
</ArticleLayout>
