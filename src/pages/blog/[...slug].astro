---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Lesson from "../../components/Lesson.astro";
import BookCard from "../../components/BookCard.astro";
import { CATEGORY_TO_ARC, ARC_INFO, type CategoryName } from "../../utils/arcMap";

type CollectionName = CategoryName;

export async function getStaticPaths() {
  const allPosts = (await Promise.all(
    (["whatif", "books", "movie", "anime", "novel", "philosophy"] as const).map(c => getCollection(c))
  )).flat();

  return allPosts.map(post => ({
    params: { slug: `${post.collection}/${post.id.replace(/\.mdx?$/, '')}` },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(h => h.depth === 2);

// 関連記事：タグ類似度スコア → 同カテゴリボーナス → 新着順
const ALL_COLLECTIONS = ["whatif", "books", "movie", "anime", "novel", "philosophy"] as const;
const allPosts = (await Promise.all(
  ALL_COLLECTIONS.map(c => getCollection(c))
)).flat();

const currentTags: string[] = post.data.tags ?? [];
const currentCat = post.data.category as string;

function tagScore(tags: string[]): number {
  if (currentTags.length === 0 || tags.length === 0) return 0;
  return tags.filter(t => currentTags.includes(t)).length;
}

const related = allPosts
  .filter(p => !(p.collection === post.collection && p.id === post.id))
  .map(p => {
    const tScore = tagScore(p.data.tags ?? []);
    const catBonus = (p.data.category === currentCat) ? 2 : 0;
    const score = tScore + catBonus;
    return { post: p, score };
  })
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.post.data.date.getTime() - a.post.data.date.getTime();
  })
  .slice(0, 3)
  .map(({ post: p }) => p);

function relSlug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, '')}`;
}

const relatedArticles = related.map(p => ({
  title:       p.data.title,
  slug:        relSlug(p.collection, p.id),
  category:    p.data.category,
  date:        p.data.date,
  readingTime: p.data.readingTime,
  description: p.data.description,
}));
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updatedAt={post.data.updatedAt}
  category={post.data.category}
  tags={post.data.tags}
  readingTime={post.data.readingTime}
  ogImage={post.data.ogImage}
  lesson={post.data.lesson}
  youtubeId={post.data.youtubeId}
  vodService={post.data.vodService}
  vodUrl={post.data.vodUrl}
  affiliateBooks={post.data.affiliateBooks}
  relatedArticles={relatedArticles}
  tocHeadings={tocHeadings}
>
  <Content components={{ Lesson, BookCard }} />
</ArticleLayout>
