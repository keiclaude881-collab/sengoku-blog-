---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const allPosts = (await Promise.all([
  getCollection("battle"),
  getCollection("leader"),
  getCollection("strategy"),
  getCollection("books"),
  getCollection("movie"),
  getCollection("whatif"),
  getCollection("anime"),
  getCollection("business"),
  getCollection("sports"),
])).flat().sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function slug(col: string, id: string) {
  return `${col}/${id.replace(/\.mdx?$/, '')}`;
}

// よく使われるタグを抽出（上位表示用）
const tagCount: Record<string, number> = {};
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagCount[tag] = (tagCount[tag] ?? 0) + 1;
  }
}
const popularTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([tag]) => tag);

const categoryLabels: Record<string, string> = {
  battle:   "合戦",
  leader:   "英傑",
  strategy: "戦略",
  books:    "書評",
  movie:    "映画",
  whatif:   "歴史IF",
  anime:    "アニメ",
  business: "ビジネス",
  sports:   "スポーツ",
};
const categories = Object.keys(categoryLabels);
---

<BaseLayout
  title="記事一覧 | 決断の系譜"
  description="迷ったとき、疲れたとき、ふと読みに来てください。歴史・映画・アニメ・スポーツの中に、今日を生きるヒントがあります。"
>
  <div class="container">
    <header class="page-header">
      <h1>記事一覧</h1>
      <p>全 <span id="article-count">{allPosts.length}</span> 記事</p>
    </header>

    <!-- カテゴリフィルター -->
    <div class="category-filter" role="group" aria-label="カテゴリで絞り込む">
      <button class="cat-btn active" data-cat="all">すべて</button>
      {categories.map(cat => (
        <button class="cat-btn" data-cat={cat}>{categoryLabels[cat]}</button>
      ))}
    </div>

    <!-- タグフィルター -->
    <div class="tag-filter" role="group" aria-label="タグで絞り込む">
      <button class="tag-btn active" data-tag="all">すべてのタグ</button>
      {popularTags.map(tag => (
        <button class="tag-btn" data-tag={tag}>#{tag}</button>
      ))}
    </div>

    {allPosts.length > 0 ? (
      <ul class="article-grid" role="list" id="article-list">
        {allPosts.map(post => (
          <li data-tags={post.data.tags.join(',')} data-cat={post.collection}>
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              tags={post.data.tags}
              readingTime={post.data.readingTime}
              lesson={post.data.lesson}
              slug={slug(post.collection, post.id)}
              ogImage={post.data.ogImage}
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">記事はまもなく公開されます。</p>
    )}

    <p class="no-result" id="no-result" hidden>該当する記事が見つかりませんでした。</p>
  </div>
</BaseLayout>

<script>
  const tagBtns  = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const catBtns  = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const items    = document.querySelectorAll<HTMLLIElement>('#article-list > li');
  const noResult = document.getElementById('no-result') as HTMLElement;
  const countEl  = document.getElementById('article-count') as HTMLElement;

  let activeTag = 'all';
  let activeCat = 'all';

  function applyFilters() {
    let visible = 0;
    items.forEach(li => {
      const tags = li.dataset.tags ?? '';
      const cat  = li.dataset.cat ?? '';
      const tagMatch = activeTag === 'all' || tags.split(',').includes(activeTag);
      const catMatch = activeCat === 'all' || cat === activeCat;
      const show = tagMatch && catMatch;
      li.hidden = !show;
      if (show) visible++;
    });
    noResult.hidden = visible > 0;
    if (countEl) countEl.textContent = String(visible);
  }

  function setTag(tag: string) {
    activeTag = tag;
    tagBtns.forEach(b => b.classList.toggle('active', b.dataset.tag === tag));
    applyFilters();
  }

  function setCat(cat: string) {
    activeCat = cat;
    catBtns.forEach(b => b.classList.toggle('active', b.dataset.cat === cat));
    applyFilters();
  }

  // URLパラメータから初期タグを読み込む
  const initialTag = new URLSearchParams(location.search).get('tag') ?? 'all';
  setTag(initialTag);

  tagBtns.forEach(btn => btn.addEventListener('click', () => setTag(btn.dataset.tag ?? 'all')));
  catBtns.forEach(btn => btn.addEventListener('click', () => setCat(btn.dataset.cat ?? 'all')));
</script>

<style>
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .cat-btn {
    padding: 0.45rem 1.1rem;
    border: 2px solid var(--rule);
    border-radius: 2px;
    background: transparent;
    color: var(--ink2);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, border-color 0.18s;
  }
  .cat-btn:hover {
    border-color: var(--accent, #8b0000);
    color: var(--accent, #8b0000);
  }
  .cat-btn.active {
    background: var(--accent, #8b0000);
    color: #fff;
    border-color: var(--accent, #8b0000);
  }
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.4rem;
  }
  .tag-btn {
    padding: 0.4rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: transparent;
    color: var(--ink2);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, border-color 0.18s;
  }
  .tag-btn:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .tag-btn.active {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
  .no-result {
    text-align: center;
    padding: var(--sp-xl) 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--ink3);
  }
  .empty {
    text-align: center;
    color: var(--ink3);
    padding: var(--sp-xl);
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
</style>
