---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const LABELS: Record<string, string> = {
  money:   "投資・お金",
  career:  "仕事・副業",
  mindset: "思考法",
};

const allPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const filtered = allPosts;

function fmt(d: Date) {
  return d.toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
}

const cats = [
  { key: "all",     label: "すべて",     href: "/blog/" },
  { key: "money",   label: "投資・お金", href: "/money/" },
  { key: "career",  label: "仕事・副業", href: "/career/" },
  { key: "mindset", label: "思考法",     href: "/mindset/" },
];
---

<BaseLayout
  title="記事一覧 | 偉人ラボ"
  description="偉人ラボの全記事一覧。投資・お金・仕事・副業・思考法のカテゴリから探せます。"
>

<div class="blog-page">
  <div class="container">

    <div class="page-header">
      <h1 class="page-title">記事一覧</h1>
      <p class="page-count">{filtered.length}件</p>
    </div>

    <div class="filter-bar">
      {cats.map(c => (
        <a
          href={c.href}
          class:list={["filter-btn", { active: c.key === "all" }]}
        >
          {c.label}
        </a>
      ))}
    </div>

    {filtered.length > 0 ? (
      <ul class="card-grid">
        {filtered.map(p => (
          <li class="fade-in">
            <a href={`/blog/${p.id.replace(/.mdx?$/, '')}/`} class="card-link">
              <div class="card-img-wrap">
                {p.data.ogImage
                  ? <img src={p.data.ogImage} alt={p.data.title} loading="lazy" class="card-img" />
                  : <div class="card-img-empty" />
                }
              </div>
              <div class="card-body">
                <span class={`card-cat card-cat--${p.data.category}`}>
                  {LABELS[p.data.category]}
                </span>
                <h2 class="card-title">{p.data.title}</h2>
                {p.data.description && <p class="card-desc">{p.data.description}</p>}
                <div class="card-foot">
                  <time class="card-date">{fmt(p.data.date)}</time>
                  <span class="card-time">{p.data.readingTime}分で読める</span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">記事がありません。</p>
    )}

  </div>
</div>

</BaseLayout>

<style>
.blog-page { padding: 52px 0 88px; }
.page-header {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  margin-bottom: 2rem;
}
.page-title {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.page-count { font-size: 0.8rem; color: var(--ink3); }

.filter-bar {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
}
.filter-btn {
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--ink2);
  text-decoration: none;
  padding: 0.4rem 0.9rem;
  border-radius: 100px;
  border: 1px solid var(--border-mid);
  transition: all 0.15s;
}
.filter-btn:hover { color: var(--ink); border-color: var(--ink3); }
.filter-btn.active { background: var(--ink); color: #fff; border-color: var(--ink); }

.card-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 36px 28px;
}
.card-link { display: block; text-decoration: none; color: inherit; }
.card-img-wrap {
  overflow: hidden;
  border-radius: var(--radius);
  aspect-ratio: 16 / 9;
  background: var(--bg2);
  margin-bottom: 1rem;
}
.card-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.5s ease;
}
.card-link:hover .card-img { transform: scale(1.04); }
.card-img-empty { width: 100%; height: 100%; background: var(--bg3); }
.card-cat {
  display: inline-flex;
  align-items: center;
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  padding: 0.25rem 0.6rem;
  border-radius: 100px;
  text-decoration: none;
  margin-bottom: 0.6rem;
  border: 1px solid transparent;
}
.card-cat--money   { background: #fef3c7; color: #92400e; border-color: #fde68a; }
.card-cat--career  { background: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
.card-cat--mindset { background: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }
.card-title {
  font-family: var(--font-serif);
  font-size: clamp(0.92rem, 1.4vw, 1.05rem);
  font-weight: 700;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 0.5rem;
  transition: color 0.2s;
}
.card-link:hover .card-title { color: var(--ink2); }
.card-desc {
  font-size: 0.8rem;
  line-height: 1.75;
  color: var(--ink2);
  margin-bottom: 0.6rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-foot { display: flex; align-items: center; justify-content: space-between; }
.card-date { font-size: 0.7rem; color: var(--ink3); }
.card-time { font-size: 0.68rem; color: var(--ink3); }

.empty { text-align: center; color: var(--ink3); padding: 4rem 0; }

@media (max-width: 900px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .card-grid { grid-template-columns: 1fr; } }
</style>
