---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

type Cat = "battle" | "leader" | "strategy" | "books";

export async function getStaticPaths() {
  const cats: Cat[] = ["battle", "leader", "strategy", "books"];
  return cats.map(cat => ({ params: { cat } }));
}

const { cat } = Astro.params as { cat: Cat };

const posts = (await getCollection(cat))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const meta: Record<Cat, { label: string; deco: string; hook: string; desc: string }> = {
  battle: {
    label: "合戦分析",
    deco:  "戦",
    hook:  "なぜあの戦いは、その結末になったのか",
    desc:  "関ヶ原・川中島・桶狭間——歴史を動かした合戦を現代の視点で解剖する。勝敗を分けた意思決定、情報戦、地政学的要因を読み解き、ビジネスの局面に応用する。",
  },
  leader: {
    label: "武将の思想",
    deco:  "将",
    hook:  "英傑たちは、いかにして人を動かしたのか",
    desc:  "信長・家康・武田信玄・チンギス・ハン——時代を超えたリーダーたちの意思決定・組織論・人心掌握術を現代のマネジメントに翻訳する。",
  },
  strategy: {
    label: "兵法・現代応用",
    deco:  "謀",
    hook:  "孫子の言葉は、会議室でも使えるか",
    desc:  "孫子・五輪書・クラウゼヴィッツ・マキャベリ——古典兵法の知恵をビジネス戦略・交渉・組織論に翻訳する。500年前の答えが、現代の問いを解く。",
  },
  books: {
    label: "書籍レビュー",
    deco:  "読",
    hook:  "この一冊が、あなたの思考を変える",
    desc:  "歴史×戦略×ビジネスの交差点で厳選した推薦図書をレビュー。孫子から現代経営まで、深く学ぶための一冊を見つけよう。",
  },
};

const { label, deco, hook, desc } = meta[cat];

function slug(id: string) {
  return `${cat}/${id.replace(/\.mdx?$/, '')}`;
}
---

<BaseLayout
  title={`${label} — ${hook} | 戦略の系譜`}
  description={desc}
>
  <!-- カテゴリヒーロー -->
  <div class={`cat-hero cat-hero--${cat}`}>
    <div class="container cat-hero-inner">
      <div class="cat-hero-content">
        <p class="cat-eyebrow">CATEGORY</p>
        <h1 class="cat-title">{label}</h1>
        <p class="cat-hook">{hook}</p>
        <p class="cat-desc">{desc}</p>
        <span class="cat-count">{posts.length} 記事</span>
      </div>
      <div class="cat-deco" aria-hidden="true">{deco}</div>
    </div>
  </div>

  <div class="container">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">ホーム</a>
      <span>›</span>
      <a href="/blog/">記事一覧</a>
      <span>›</span>
      <span aria-current="page">{label}</span>
    </nav>

    {posts.length > 0 ? (
      <ul class="article-grid" role="list">
        {posts.map(post => (
          <li>
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              tags={post.data.tags}
              readingTime={post.data.readingTime}
              lesson={post.data.lesson}
              slug={slug(post.id)}
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">このカテゴリの記事はまもなく公開されます。</p>
    )}
  </div>
</BaseLayout>

<style>
  .cat-hero {
    padding: 4rem 0 3.5rem;
    position: relative;
    overflow: hidden;
  }
  .cat-hero--battle   { background: linear-gradient(135deg, #1E4A35 0%, #111111 100%); }
  .cat-hero--leader   { background: linear-gradient(135deg, #2A6B50 0%, #111111 100%); }
  .cat-hero--strategy { background: linear-gradient(135deg, #1E4A35 0%, #0a0a0a 100%); }
  .cat-hero--books    { background: linear-gradient(135deg, #1a3a2a 0%, #111111 100%); }

  .cat-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .cat-hero-content {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cat-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .cat-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .cat-hook {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 400;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    border-left: 2px solid var(--gold);
    padding-left: 1rem;
  }

  .cat-desc {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.9;
    color: rgba(255,255,255,0.5);
    max-width: 560px;
  }

  .cat-count {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--gold);
    border: 1px solid var(--gold);
    border-radius: 2px;
    padding: 0.25em 0.8em;
    align-self: flex-start;
  }

  .cat-deco {
    font-family: var(--font-serif);
    font-size: clamp(8rem, 18vw, 16rem);
    font-weight: 800;
    color: rgba(255,255,255,0.04);
    line-height: 1;
    user-select: none;
    flex-shrink: 0;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink3);
    padding: 1.6rem 0;
  }
  .breadcrumb a { color: var(--ink3); transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--gold); }

  .empty {
    color: var(--ink3);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: var(--sp-xl);
    text-align: center;
  }

  @media (max-width: 768px) {
    .cat-deco { display: none; }
    .cat-hero { padding: calc(var(--nav-height) + 2rem) 0 2.5rem; }
  }
</style>
