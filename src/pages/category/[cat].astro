---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

type Cat = "battle" | "leader" | "strategy" | "books" | "movie" | "whatif" | "anime" | "business" | "sports" | "novel" | "world";

export async function getStaticPaths() {
  const cats: Cat[] = ["battle", "leader", "strategy", "books", "movie", "whatif", "anime", "business", "sports", "novel", "world"];
  return cats.map(cat => ({ params: { cat } }));
}

const { cat } = Astro.params as { cat: Cat };

const posts = (await getCollection(cat))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const meta: Record<Cat, { label: string; deco: string; hook: string; desc: string }> = {
  battle: {
    label: "合戦と戦略",
    deco:  "戦",
    hook:  "あの戦いも、誰かの迷いから始まった",
    desc:  "追い詰められた武将たちの決断は、今日の「どうすればいい？」に答えてくれる。関ヶ原・川中島・桶狭間——歴史の戦場で磨かれた知恵を、あなたの今日へ。",
  },
  leader: {
    label: "武将の思想",
    deco:  "将",
    hook:  "信長も家康も、最初はただの人間だった",
    desc:  "完璧じゃない彼らが、それでも前へ進めた理由。英傑たちの迷いと決断の物語が、あなたの背中をそっと押してくれる。",
  },
  strategy: {
    label: "兵法・知恵",
    deco:  "謀",
    hook:  "孫子の言葉は、疲れた心にも効く",
    desc:  "2500年前に書かれた言葉が、今日の判断をそっと助けてくれる。難しくない、堅苦しくない。昔の知恵を、今日の言葉で。",
  },
  books: {
    label: "書籍レビュー",
    deco:  "読",
    hook:  "忙しい毎日の中で、この一冊があなたを変える",
    desc:  "読み終わった後、世界の見え方が少し変わる本を紹介。「時間がない」あなたのために、読む価値のある一冊だけを厳選。",
  },
  movie: {
    label: "映画の中の知恵",
    deco:  "映",
    hook:  "スクリーンの向こうに、あなたへのメッセージがある",
    desc:  "名作映画が描く人間の決断と葛藤を、一緒に読み解く。観た後に「自分も頑張ろう」と思える作品たちの、もう一つの読み方。",
  },
  whatif: {
    label: "歴史IF",
    deco:  "IF",
    hook:  "もし違う選択をしていたら、どうなっていたか",
    desc:  "「あの時こうしていれば」——誰もが持つその感覚を、歴史の舞台で思考実験する。IFを考えることで、今の選択が見えてくる。",
  },
  anime: {
    label: "アニメの中の知恵",
    deco:  "動",
    hook:  "好きなアニメのあのシーン、実は深い意味があった",
    desc:  "キャラクターたちの葛藤と決断が、今日の自分に重なる。エンタメを楽しみながら、気づいたら自分の生き方を考えている。",
  },
  business: {
    label: "ビジネスの知恵",
    deco:  "商",
    hook:  "仕事で迷ったとき、偉人ならどうするか",
    desc:  "難しい戦略論じゃなくていい。歴史の知恵を借りて、今日の仕事をすこし楽にする、そんな視点をお届けする。",
  },
  sports: {
    label: "勝負師の知恵",
    deco:  "闘",
    hook:  "土壇場で諦めなかった人たちの共通点",
    desc:  "スポーツの名勝負が教える、粘り方と潔い撤退の作法。勝負師たちの覚悟が、日常の「もう一歩」を引き出してくれる。",
  },
  novel: {
    label: "小説・物語",
    deco:  "語",
    hook:  "物語の中の決断が、今日の自分に重なる",
    desc:  "御子柴礼司、ハーミオーニー、ハリー——フィクションの登場人物たちは、歴史の英傑と同じ構造の選択をしている。小説・Audibleで楽しめる物語の戦略論。",
  },
  world: {
    label: "世界史の決断",
    deco:  "界",
    hook:  "なぜあいつは勝ち、あいつは負けたのか",
    desc:  "ハンニバル、ナポレオン、チンギス・ハン——時代も国も超えて、勝負を分けた決断の瞬間を追う。世界大戦から古代の合戦まで、普遍の戦略を読み解く。",
  },
};

const { label, deco, hook, desc } = meta[cat];

function slug(id: string) {
  return `${cat}/${id.replace(/\.mdx?$/, '')}`;
}
---

<BaseLayout
  title={`${label} — ${hook} | 決断の系譜`}
  description={desc}
>
  <!-- カテゴリヒーロー -->
  <div class={`cat-hero cat-hero--${cat}`}>
    <div class="container cat-hero-inner">
      <div class="cat-hero-content">
        <p class="cat-eyebrow">CATEGORY</p>
        <h1 class="cat-title">{label}</h1>
        <p class="cat-hook">{hook}</p>
        <p class="cat-desc">{desc}</p>
        <span class="cat-count">{posts.length} 記事</span>
      </div>
      <div class="cat-deco" aria-hidden="true">{deco}</div>
    </div>
  </div>

  <div class="container">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">ホーム</a>
      <span>›</span>
      <a href="/blog/">記事一覧</a>
      <span>›</span>
      <span aria-current="page">{label}</span>
    </nav>

    {posts.length > 0 ? (
      <ul class="article-grid" role="list">
        {posts.map(post => (
          <li>
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              tags={post.data.tags}
              readingTime={post.data.readingTime}
              lesson={post.data.lesson}
              slug={slug(post.id)}
              ogImage={post.data.ogImage}
            />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">このカテゴリの記事はまもなく公開されます。</p>
    )}
  </div>
</BaseLayout>

<style>
  .cat-hero {
    padding: 4rem 0 3.5rem;
    position: relative;
    overflow: hidden;
  }
  .cat-hero--battle   { background: linear-gradient(135deg, #1E4A35 0%, #111111 100%); }
  .cat-hero--leader   { background: linear-gradient(135deg, #2A6B50 0%, #111111 100%); }
  .cat-hero--strategy { background: linear-gradient(135deg, #1E4A35 0%, #0a0a0a 100%); }
  .cat-hero--books    { background: linear-gradient(135deg, #1a3a2a 0%, #111111 100%); }
  .cat-hero--movie    { background: linear-gradient(135deg, #0a3d3a 0%, #001a18 100%); }
  .cat-hero--whatif   { background: linear-gradient(135deg, #2a3d0a 0%, #111800 100%); }
  .cat-hero--anime    { background: linear-gradient(135deg, #0d3545 0%, #001018 100%); }
  .cat-hero--business { background: linear-gradient(135deg, #0e3d30 0%, #050e09 100%); }
  .cat-hero--sports   { background: linear-gradient(135deg, #2d4a15 0%, #0a1400 100%); }

  .cat-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .cat-hero-content {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cat-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .cat-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .cat-hook {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 400;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    border-left: 2px solid var(--gold);
    padding-left: 1rem;
  }

  .cat-desc {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.9;
    color: rgba(255,255,255,0.5);
    max-width: 560px;
  }

  .cat-count {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--gold);
    border: 1px solid var(--gold);
    border-radius: 2px;
    padding: 0.25em 0.8em;
    align-self: flex-start;
  }

  .cat-deco {
    font-family: var(--font-serif);
    font-size: clamp(8rem, 18vw, 16rem);
    font-weight: 800;
    color: rgba(255,255,255,0.04);
    line-height: 1;
    user-select: none;
    flex-shrink: 0;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink3);
    padding: 1.6rem 0;
  }
  .breadcrumb a { color: var(--ink3); transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--gold); }

  .empty {
    color: var(--ink3);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: var(--sp-xl);
    text-align: center;
  }

  @media (max-width: 768px) {
    .cat-deco { display: none; }
    .cat-hero { padding: calc(var(--nav-height) + 2rem) 0 2.5rem; }
  }
</style>
